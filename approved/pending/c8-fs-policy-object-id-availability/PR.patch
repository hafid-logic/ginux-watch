From f431a0570c78536e817faa6e7df65b4ff76eddb7 Mon Sep 17 00:00:00 2001
From: Abdelhafid DJIDEL <266947999+hafid-logic@users.noreply.github.com>
Date: Wed, 25 Nov 2026 17:51:16 +0000
Subject: [PATCH] tests(fs-policy): pin ObjectId availability to either nonzero
 component

---
 crates/ginux-fs-policy/src/lib.rs | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/crates/ginux-fs-policy/src/lib.rs b/crates/ginux-fs-policy/src/lib.rs
index e4151e4..c38f04e 100644
--- a/crates/ginux-fs-policy/src/lib.rs
+++ b/crates/ginux-fs-policy/src/lib.rs
@@ -1981,4 +1981,29 @@ mod tests {
         assert!(!Rights::READ.contains(need));
         assert!(!Rights(0).contains(Rights::LOOKUP));
     }
+
+    #[test]
+    fn object_id_available_when_either_component_nonzero() {
+        assert!(!ObjectId::UNAVAILABLE.is_available());
+        assert!(!ObjectId {
+            device: 0,
+            inode: 0
+        }
+        .is_available());
+        assert!(ObjectId {
+            device: 7,
+            inode: 0
+        }
+        .is_available());
+        assert!(ObjectId {
+            device: 0,
+            inode: 7
+        }
+        .is_available());
+        assert!(ObjectId {
+            device: 7,
+            inode: 9
+        }
+        .is_available());
+    }
 }
-- 
2.47.3

