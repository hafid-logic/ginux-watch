From 7d31dceb4054ccde0c0b035e05a5054bed7267aa Mon Sep 17 00:00:00 2001
From: ginux-watch-agent <actions@users.noreply.github.com>
Date: Fri, 27 Nov 2026 10:40:52 +0000
Subject: [PATCH] tests(instance): derive contract write grant from create-only
 lists

### What
Pins that a create-only filesystem list still derives the filesystem.** write grant.

### Why it matters
Write authority must follow create capability; dropping the create clause under-grants. Existing tests don't pin this derivation.

### Mutation evidence (fail-then-pass)
| Mutant | Existing suite | New test |
|---|---|---|
| drop filesystem_create clause | PASS (survives) | FAIL (killed) |
| && -> || in write condition | PASS (survives) | FAIL (killed) |

Baseline: PASS. Reproduce: `cargo test -p ginux-instance --lib derive_grants_write_from_create`.

Prepared with AI assistance; reviewed by me.
---
 crates/ginux-instance/src/lib.rs | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/crates/ginux-instance/src/lib.rs b/crates/ginux-instance/src/lib.rs
index d5f17444..bc460469 100644
--- a/crates/ginux-instance/src/lib.rs
+++ b/crates/ginux-instance/src/lib.rs
@@ -3120,4 +3120,21 @@ failure = "stop"
         c.memory_mib = 15;
         assert!(c.validate().is_err());
     }
+
+    #[test]
+    fn derive_grants_write_from_create() {
+        let mut c = InstanceConfig::parse(VALID.as_bytes()).unwrap();
+        c.filesystem_write.clear();
+        c.filesystem_create.clear();
+        c.contract_write.clear();
+        c.filesystem_create
+            .push(Text::from_bytes(b"/tmp/x").unwrap())
+            .unwrap();
+        c.derive_contract_grants().unwrap();
+        assert!(c
+            .contract_write
+            .as_slice()
+            .iter()
+            .any(|t| t.as_bytes() == b"filesystem.**"));
+    }
 }
