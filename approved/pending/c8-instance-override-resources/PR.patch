From 3bdc1912c44996070b7f1ee02036b3f6ab538d5b Mon Sep 17 00:00:00 2001
From: ginux-watch-agent <actions@users.noreply.github.com>
Date: Fri, 27 Nov 2026 20:09:29 +0000
Subject: [PATCH] tests(instance): pin memory override application and exact
 bounds

### What
Pins the `resources.memory_mib` override: value applies, exact lower bound 16 accepted, 15 rejected atomically, quoted numbers rejected.

### Why it matters
Override arms are fail-closed config gates; deleting the memory arm or its validation admits invalid configs. Existing override tests pin vcpus but never memory.

### Mutation evidence (fail-then-pass)
| Mutant | Existing suite | New test |
|---|---|---|
| delete `resources.memory_mib` arm | PASS (survives) | FAIL (killed) |
| discard parsed u64 (return Ok(256)) | PASS (survives) | FAIL (killed) |

Baseline: PASS. Reproduce: `cargo test -p ginux-instance --lib memory_override_enforces`.

Prepared with AI assistance; reviewed by me.
---
 crates/ginux-instance/src/lib.rs | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/crates/ginux-instance/src/lib.rs b/crates/ginux-instance/src/lib.rs
index d5f17444..5573eae3 100644
--- a/crates/ginux-instance/src/lib.rs
+++ b/crates/ginux-instance/src/lib.rs
@@ -3120,4 +3120,21 @@ failure = "stop"
         c.memory_mib = 15;
         assert!(c.validate().is_err());
     }
+
+    #[test]
+    fn memory_override_enforces_exact_bounds() {
+        let mut c = InstanceConfig::parse(VALID.as_bytes()).unwrap();
+        c.apply_override(b"resources.memory_mib", b"256").unwrap();
+        assert_eq!(c.memory_mib, 256);
+        // exact lower bound accepted, one below rejected without partial mutation
+        c.apply_override(b"resources.memory_mib", b"16").unwrap();
+        assert_eq!(c.memory_mib, 16);
+        assert!(c.apply_override(b"resources.memory_mib", b"15").is_err());
+        assert_eq!(c.memory_mib, 16);
+        // non-numeric values fail closed
+        assert!(c
+            .apply_override(b"resources.memory_mib", b"\"256\"")
+            .is_err());
+        assert_eq!(c.memory_mib, 16);
+    }
 }
