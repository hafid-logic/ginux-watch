From 47cace2559cd0757545802c0d78ab2eb9705d181 Mon Sep 17 00:00:00 2001
From: ginux-watch-agent <actions@users.noreply.github.com>
Date: Fri, 27 Nov 2026 09:20:44 +0000
Subject: [PATCH] tests(instance): pin resource overrides and unknown-key
 rejection

### What
Pins `apply_override` for resources.vcpus/memory_mib and rejection of unknown keys.

### Why it matters
Override arms map keys to fields; a deleted arm silently ignores the override. Existing tests don't pin these arms.

### Mutation evidence (fail-then-pass)
| Mutant | Existing suite | New test |
|---|---|---|
| delete `resources.vcpus` arm | PASS (survives) | FAIL (killed) |
| delete `resources.memory_mib` arm | PASS (survives) | FAIL (killed) |

Baseline: PASS. Reproduce: `cargo test -p ginux-instance --lib override_resources_vcpus`.

Prepared with AI assistance; reviewed by me.
---
 crates/ginux-instance/src/lib.rs | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/crates/ginux-instance/src/lib.rs b/crates/ginux-instance/src/lib.rs
index d5f17444..4fbe2b06 100644
--- a/crates/ginux-instance/src/lib.rs
+++ b/crates/ginux-instance/src/lib.rs
@@ -3120,4 +3120,14 @@ failure = "stop"
         c.memory_mib = 15;
         assert!(c.validate().is_err());
     }
+
+    #[test]
+    fn override_resources_vcpus_and_memory_and_reject_unknown() {
+        let mut c = InstanceConfig::parse(VALID.as_bytes()).unwrap();
+        c.apply_override(b"resources.vcpus", b"2").unwrap();
+        assert_eq!(c.vcpus, 2);
+        c.apply_override(b"resources.memory_mib", b"256").unwrap();
+        assert_eq!(c.memory_mib, 256);
+        assert!(c.apply_override(b"resources.nope", b"1").is_err());
+    }
 }
