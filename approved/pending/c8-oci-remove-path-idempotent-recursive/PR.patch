From af45884ef632c5d798c9bb35ccf3202a32ad8eeb Mon Sep 17 00:00:00 2001
From: Abdelhafid DJIDEL <266947999+hafid-logic@users.noreply.github.com>
Date: Sat, 28 Nov 2026 10:21:23 +0000
Subject: [PATCH] tests(oci): pin remove_path missing-path tolerance and
 recursive directory removal

### What
Pins `remove_path`: a missing path is a successful no-op, a populated directory is removed recursively, and a symlink is unlinked without touching its target.

### Why it matters
Layer teardown must be idempotent and complete. The existing suite exercises whiteouts over present entries only, so failing on a missing path or dropping recursion passes it while leaving stale layer content or aborting an import.

### Mutation evidence (fail-then-pass)
| Mutant | Existing suite | New test |
|---|---|---|
| NotFound arm returns Err instead of Ok | PASS (survives) | FAIL (killed) |
| `remove_dir_all` -> `remove_dir` | PASS (survives) | FAIL (killed) |

Spec-Ref: OCI image-spec layer whiteout application (idempotent removal).

Baseline (clean tree + new test): PASS. Reproduce: `cargo test -p ginux-oci --lib remove_path_unlinks`.

Prepared with AI assistance; reviewed by me.
---
 crates/ginux-oci/src/lib.rs | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/crates/ginux-oci/src/lib.rs b/crates/ginux-oci/src/lib.rs
index 01e040f4..b2b2f97b 100644
--- a/crates/ginux-oci/src/lib.rs
+++ b/crates/ginux-oci/src/lib.rs
@@ -869,4 +869,25 @@ mod tests {
         // beyond GiB stays in GiB (unit cap)
         assert_eq!(human_size(2 * 1024 * 1024 * 1024), "2.0 GiB");
     }
+
+    #[test]
+    fn remove_path_unlinks_symlink_without_following_target() {
+        let base = temp_dir("remove-symlink");
+        let outside = temp_dir("remove-outside");
+        fs::write(outside.join("victim"), b"keep").unwrap();
+        let link = base.join("link");
+        std::os::unix::fs::symlink(&outside, &link).unwrap();
+        // removing the link must unlink it, never recurse into the target
+        remove_path(&link).unwrap();
+        assert!(!link.exists());
+        assert!(outside.join("victim").exists());
+        // missing path is a no-op; a real directory is removed recursively
+        remove_path(&base.join("absent")).unwrap();
+        fs::create_dir_all(base.join("d/sub")).unwrap();
+        fs::write(base.join("d/sub/f"), b"x").unwrap();
+        remove_path(&base.join("d")).unwrap();
+        assert!(!base.join("d").exists());
+        fs::remove_dir_all(&base).unwrap();
+        fs::remove_dir_all(&outside).unwrap();
+    }
 }
