+                                  "GINUX_FIXTURE: console-open-ok=1",
+                                  "GINUX_FIXTURE: high-bits-dup-console=1",
+                                  "GINUX_FIXTURE: shared-dup-console=1",
+                                  "GINUX_FIXTURE: shared-reuse-same-number=1",
+                                  "GINUX_FIXTURE: shared-reuse-console=0",
+                                  "GINUX_FIXTURE: private-close-console=1",
+                                  "GINUX_FIXTURE: thread-dup-console=1",
+                                  "GINUX_FIXTURE: write-thread-open=-1",
+                                  "GINUX_FIXTURE: overwritten-console=0",
+                                  "GINUX_FIXTURE: closed-range-console=0",
+                                  "GINUX_FIXTURE: console-cloexec=1",
+                                  "GINUX_FIXTURE: open-arguments-kept=1",
+                                  "GINUX_FIXTURE: cloexec-range-console=1",
+                                  "GINUX_FIXTURE: exec-reused-console=0",
+                                  "GINUX_FIXTURE: exec-write-reused=-9",
+                                  "GINUX_FIXTURE: exec-dropped-console=0",
+                                  "GINUX_FIXTURE: exec-kept-console=4"], code, out)
+
+        # Pipe descriptor tracking follows the host descriptor table too:
+        # pipes a CLONE_FILES child closes, pipe ends a dup2 replaces and
+        # close-on-exec pipes an exec drops leave it, a pipe end dup2 copies
+        # onto itself stays, and a workload that makes many more pipes than
+        # it holds open at once keeps running.
+        # Each pipe2 and each close of a tracked pipe end is one task-pipe
+        # record: 16 shared rounds of three, the replaced pair's pipe2 and
+        # the close of its write end after the dup2 onto itself (the
+        # replaced read end's close is not one), three close-on-exec pipe2
+        # calls, and after the exec four pipe2 calls and eight closes.
+        code, out = run("F-pipe-tracking", configured)
+        fixture = [line for line in out.splitlines() if line.startswith("GINUX_FIXTURE: ")]
+        check("pipe tracking follows shared tables, dup2 and exec", code == 0
+              and fixture == ["GINUX_FIXTURE: shared-close-released=16",
+                              "GINUX_FIXTURE: dup2-over-pipe=1",
+                              "GINUX_FIXTURE: dup2-self-pipe=1",
+                              "GINUX_FIXTURE: exec-pipes=8",
+                              "GINUX_FIXTURE: exec-reused-close=0"]
+              and out.count("surface=task-pipe ") == 16 * 3 + 2 + 3 + 4 + 8, code, out)
+
+        # Force a shared-table mutation to remain in the host kernel while a
+        # sibling reaches another descriptor operation. The host process owns
+        # the conflicting byte-range lock; without the supervisor barrier the
+        # sibling dup completes before that lock is released.
+        barrier_output = work / "descriptor-barrier-output"
+        with barrier_output.open("w+b") as output:
+            fcntl.lockf(output, fcntl.LOCK_EX, 1)
+            (root / "scenario").write_text("M-descriptor-barrier")
+            proc = subprocess.Popen(
+                [str(work / "ginux"), "native", str(denied_console), str(root), "configured"],
+                stdin=subprocess.DEVNULL, stdout=output, stderr=subprocess.PIPE)
+            try:
+                deadline = time.monotonic() + 30
+                while time.monotonic() < deadline:
+                    output.flush()
+                    if b"GINUX_FIXTURE: barrier-start=1\n" in os.pread(output.fileno(), 4096, 0):
+                        break
+                    time.sleep(0.05)
+                else:
+                    raise RuntimeError("descriptor barrier fixture did not start")
+                time.sleep(2)
+                fcntl.lockf(output, fcntl.LOCK_UN, 1)
+                _, error = proc.communicate(timeout=30)
+            finally:
+                if proc.poll() is None:
+                    proc.kill()
+                    proc.wait()
+                fcntl.lockf(output, fcntl.LOCK_UN, 1)
+            output.flush()
+            output.seek(0)
+            out = output.read().decode(errors="replace") + (error or b"").decode(errors="replace")
+        fixture = [line for line in out.splitlines() if line.startswith("GINUX_FIXTURE: ")]
+        check("shared descriptor mutations are serialized", proc.returncode == 0 and fixture == [
+            "GINUX_FIXTURE: barrier-threads=1",
+            "GINUX_FIXTURE: barrier-start=1",
+            "GINUX_FIXTURE: sibling-deferred=1",
+            "GINUX_FIXTURE: mutation-result=0",
+            "GINUX_FIXTURE: sibling-console=1"], proc.returncode, out)
+        # Every descriptor the supervisor tracks as the console, and the
+        # vectored and positional writes on it, belong to device.console.write.
+        denied_console = work / "denied-console-write.toml"
+        denied_console.write_text(configured.read_text().replace(
+            'deny = ["device.mmio.direct"', 'deny = ["device.console.write", "device.mmio.direct"'))
+        with open(work / "console-output", "w+b") as console:
+            code, out = run("K-console-descriptors", denied_console, stdin=console, configured_launch=True)
+            fixture = [line for line in out.splitlines() if line.startswith("GINUX_FIXTURE: ")]
+            check("denied console write covers duplicates and vectored writes", code == 0
+                  and fixture == ["GINUX_FIXTURE: stdin-console=1",
+                                  "GINUX_FIXTURE: stdout-console=0",
+                                  "GINUX_FIXTURE: stderr-console=0",
+                                  "GINUX_FIXTURE: console-open-ok=1",
+                                  "GINUX_FIXTURE: stderr-after-dup-console=1",
+                                  "GINUX_FIXTURE: write-stderr-console=-1",
+                                  "GINUX_FIXTURE: write-duplicate=-1",
+                                  "GINUX_FIXTURE: writev-console=-1",
+                                  "GINUX_FIXTURE: pwrite-duplicate=-1",
+                                  "GINUX_FIXTURE: reused-same-number=1",
+                                  "GINUX_FIXTURE: write-reused=-9"]
+                  and (work / "console-output").read_bytes() == b"", code, out)
+        with open(work / "console-output", "w+b") as console:
+            code, out = run("K-console-descriptors", configured, stdin=console)
+            fixture = [line for line in out.splitlines() if line.startswith("GINUX_FIXTURE: ")]
+            check("allowed console write still reaches the console", code == 0
+                  and fixture[:8] == ["GINUX_FIXTURE: stdin-console=1",
+                                      "GINUX_FIXTURE: stdout-console=0",
+                                      "GINUX_FIXTURE: stderr-console=0",
+                                      "GINUX_FIXTURE: console-open-ok=1",
+                                      "GINUX_FIXTURE: stderr-after-dup-console=1",
+                                      "GINUX_FIXTURE: write-stderr-console=2",
+                                      "GINUX_FIXTURE: write-duplicate=2",
+                                      "GINUX_FIXTURE: writev-console=2"]
+                  and (work / "console-output").read_bytes().startswith(b"K\nK\nK\n"), code, out)
+
+        # The protected null (240) and console (241) descriptors survive every
+        # call that would close, replace or mark them close-on-exec, with
+        # descriptor arguments read as 32 bits; a duplicate onto them fails
+        # with EPERM, or EBADF from a closed source. Each step runs in its
+        # own child, which then writes through both and checks their flags.
+        # A range from them still reaches the workload's descriptors above
+        # them and unshares. A range from below that goes past them runs in
+        # two parts and closes or marks the workload's descriptors from 239
+        # to 242 and up to its last descriptor, not 301; a closed console
+        # copy at 250 leaves the console view; the caller keeps its argument
+        # registers.
+        with open(work / "protected-console", "w+b") as console:
+            code, out = run("P-protected-descriptors", configured, stdin=console)
+            fixture = [line for line in out.splitlines() if line.startswith("GINUX_FIXTURE: ")]
+            steps = [("close-high-console", 0), ("close-high-null", 0), ("dup2-console", -1),
+                     ("dup2-high-console", -1), ("dup2-console-self", 241), ("dup3-null", -1),
+                     ("dup3-high-console", -1), ("dup2-closed-console", -9),
+                     ("dup3-closed-null", -9), ("setfd-console", 0), ("setfd-high-null", 0),
+                     ("fioclex-console", 0), ("fioclex-high-null", 0), ("fionclex-console", 0),
+                     ("console-range", 0), ("inverted-high-range", -22)]
+            # F_GETFD of the workload's descriptors 239, 242, 250, 300 and 301
+            # after each range (-9 closed, 1 close-on-exec, 0 untouched), and
+            # whether 250, a console copy, is still tracked as the console.
+            ranges = [("cloexec-range", (1, 1, 1, 1, 1, 1)),
+                      ("high-range", (-9, -9, -9, -9, -9, 0)),
+                      ("null-range", (0, -9, -9, -9, 0, 0)),
+                      ("null-cloexec-range", (0, 1, 1, 1, 0, 1)),
+                      ("unshare-range", (-9, -9, -9, -9, 0, 0)),
+                      ("span-range", (-9, -9, -9, -9, 0, 0)),
+                      ("span-cloexec-range", (1, 1, 1, 1, 0, 1)),
+                      ("span-unshare-range", (-9, -9, -9, -9, 0, 0))]
+            probes = ("fd-239", "fd-242", "fd-250", "fd-300", "fd-301", "console-250")
+            expected = [line for name, result in steps for line in (
+                f"GINUX_FIXTURE: {name}={result}", f"GINUX_FIXTURE: {name}-intact=1")]
+            expected += ["GINUX_FIXTURE: fd-239=239", "GINUX_FIXTURE: fd-242=242",
+                         "GINUX_FIXTURE: fd-250=250", "GINUX_FIXTURE: console-250=1",
+                         "GINUX_FIXTURE: fd-300=300", "GINUX_FIXTURE: fd-301=301"]
+            expected += [line for name, values in ranges for line in (
+                f"GINUX_FIXTURE: {name}=0",
+                *(f"GINUX_FIXTURE: {name}-{probe}={value}" for probe, value in zip(probes, values)),
+                f"GINUX_FIXTURE: {name}-intact=1")]
+            expected += ["GINUX_FIXTURE: span-unshare-files=1",
+                         "GINUX_FIXTURE: unshare-console-range=1",
+                         "GINUX_FIXTURE: cut-range-arguments-kept=1",
+                         "GINUX_FIXTURE: protected-range-arguments-kept=1",
+                         "GINUX_FIXTURE: span-range-arguments-kept=1"]
+            check("protected descriptors survive close, dup, close-on-exec and close_range",
+                  code == 0 and fixture == expected
+                  and (work / "protected-console").read_bytes()
+                  == b"P\n" * (len(steps) + len(ranges)), code, out)
+
+        # Upstream owns cgroups in memory. Retain the public API and
+        # containment regressions without requiring obsolete host files.
+        cgroup_outside = work / "cgroup-outside"
+        cgroup_outside.mkdir()
+        sentinel = cgroup_outside / "sentinel"
+        sentinel.write_bytes(b"preserve")
+        (root / "sys/fs/cgroup").mkdir(parents=True, exist_ok=True)
+        (root / "sys/fs/cgroup/escape").symlink_to(cgroup_outside)
+        code, out = run("layout-cgroup", configured)
+        fixture = [line for line in out.splitlines() if line.startswith("GINUX_FIXTURE: ")]
+        check("virtual cgroup mkdir and containment", code == 0 and fixture == [
+            "GINUX_FIXTURE: mkdir=0", "GINUX_FIXTURE: procs-open-ok=1",
+            "GINUX_FIXTURE: procs-write=2", "GINUX_FIXTURE: mkdir-again=-17",
+            "GINUX_FIXTURE: mkdirat=0", "GINUX_FIXTURE: mkdirat-relative=0",
+            "GINUX_FIXTURE: events-open-ok=1", "GINUX_FIXTURE: kill-open-ok=1",
+            "GINUX_FIXTURE: mkdir-via-symlink=-2"]
+            and sentinel.read_bytes() == b"preserve"
+            and sorted(p.name for p in cgroup_outside.iterdir()) == ["sentinel"]
+            and sorted(p.name for p in (root / "sys/fs/cgroup").iterdir()) == ["escape"], code, out)
+    print("test-native-supervision: PASS")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/test-native-unix-send-snapshot.py b/scripts/test-native-unix-send-snapshot.py
new file mode 100755
index 0000000..4254793
--- /dev/null
+++ b/scripts/test-native-unix-send-snapshot.py
@@ -0,0 +1,194 @@
+#!/usr/bin/env python3
+"""Mutate a pathname Unix send after Ginux captures it (Linux/root)."""
+import ctypes
+import errno
+import os
+from pathlib import Path
+import re
+import shutil
+import signal
+import socket
+import sys
+import tempfile
+
+
+class Regs(ctypes.Structure):
+    _fields_ = [(name, ctypes.c_ulonglong) for name in (
+        "r15 r14 r13 r12 rbp rbx r11 r10 r9 r8 rax rcx rdx rsi rdi orig_rax "
+        "rip cs eflags rsp ss fs_base gs_base ds es fs gs").split()]
+
+
+class Iovec(ctypes.Structure):
+    _fields_ = [("base", ctypes.c_void_p), ("length", ctypes.c_size_t)]
+
+
+def main():
+    if len(sys.argv) != 3 or os.geteuid() != 0:
+        sys.exit("usage (as root): test-native-unix-send-snapshot.py <ginux> <native fixture>")
+    binary, fixture = (Path(arg).resolve() for arg in sys.argv[1:])
+    template = (Path(__file__).resolve().parent.parent / "config/instance-gate5.toml").read_text()
+    libc = ctypes.CDLL(None, use_errno=True)
+    libc.ptrace.argtypes = [ctypes.c_uint, ctypes.c_uint, ctypes.c_void_p, ctypes.c_void_p]
+    libc.ptrace.restype = ctypes.c_long
+    libc.process_vm_writev.argtypes = [ctypes.c_int, ctypes.POINTER(Iovec), ctypes.c_ulong,
+                                      ctypes.POINTER(Iovec), ctypes.c_ulong, ctypes.c_ulong]
+    libc.process_vm_writev.restype = ctypes.c_ssize_t
+
+    def ptrace(request, pid, address=0, data=0):
+        ctypes.set_errno(0)
+        value = libc.ptrace(request, pid, address, data)
+        if value == -1 and ctypes.get_errno():
+            raise OSError(ctypes.get_errno(), f"ptrace {request}")
+        return value
+
+    def peek_regs(pid, address):
+        values = [ptrace(2, pid, address + index * 8) & ((1 << 64) - 1)
+                  for index in range(27)]
+        return Regs(*values)
+
+    def store(pid, address, value):
+        data = ctypes.create_string_buffer(value)
+        local, remote = Iovec(ctypes.addressof(data), len(value)), Iovec(address, len(value))
+        ctypes.set_errno(0)
+        result = libc.process_vm_writev(pid, ctypes.byref(local), 1,
+                                       ctypes.byref(remote), 1, 0)
+        return result, ctypes.get_errno()
+
+    with tempfile.TemporaryDirectory(prefix="ginux-unix-snapshot-") as directory:
+        work = Path(directory)
+        work.chmod(0o755)
+        shutil.copy2(binary, work / "ginux")
+        (work / "ginux").chmod(0o755)
+        root = work / "root"
+        (root / "usr/bin").mkdir(parents=True)
+        (root / "tmp").mkdir(mode=0o777)
+        shutil.copy2(fixture, root / "usr/bin/bash")
+        (root / "usr/bin/bash").chmod(0o755)
+        (root / "scenario").write_text("Unix-snapshot")
+        config = work / "instance.toml"
+        config.write_text(template.replace('init = "/bin/bash"', 'init = "/usr/bin/bash"')
+                          .replace('[network]\nbackend = "none"', '[network]\nbackend = "shared"') + """
+[contract.filesystem]
+read = ["/"]
+write = ["/"]
+create = ["/"]
+[contract.kernel]
+proc_read = ["/"]
+sys_read = ["/"]
+""")
+        original_path = root / "tmp/unix-snap-a.sock"
+        mutated_path = root / "tmp/unix-snap-b.sock"
+        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as original_receiver, \
+                socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as mutated_receiver:
+            original_receiver.bind(str(original_path))
+            mutated_receiver.bind(str(mutated_path))
+            original_path.chmod(0o777)
+            mutated_path.chmod(0o777)
+            original_receiver.settimeout(2)
+            mutated_receiver.settimeout(0.1)
+            read_fd, write_fd = os.pipe()
+            pid = os.fork()
+            if pid == 0:
+                os.close(read_fd)
+                os.dup2(write_fd, 1)
+                os.dup2(write_fd, 2)
+                os.close(write_fd)
+                if libc.ptrace(0, 0, 0, 0) < 0:
+                    os._exit(125)
+                os.kill(os.getpid(), signal.SIGSTOP)
+                os.execv(work / "ginux", [str(work / "ginux"), "native", str(config),
+                                           str(root), "configured"])
+            os.close(write_fd)
+            os.set_blocking(read_fd, False)
+            output = bytearray()
+            mutated = False
+            complete = False
+
+            def drain():
+                while True:
+                    try:
+                        data = os.read(read_fd, 65536)
+                    except BlockingIOError:
+                        break
+                    if not data:
+                        break
+                    output.extend(data)
+
+            def expired(_signal, _frame):
+                raise TimeoutError("Unix send snapshot fixture timed out")
+
+            previous_alarm = signal.signal(signal.SIGALRM, expired)
+            signal.setitimer(signal.ITIMER_REAL, 30)
+            try:
+                _, status = os.waitpid(pid, 0)
+                if not os.WIFSTOPPED(status):
+                    raise RuntimeError("Ginux did not stop before exec")
+                ptrace(0x4200, pid, 0, 1 | 16 | (1 << 20))
+                ptrace(24, pid)
+                while True:
+                    _, status = os.waitpid(pid, 0)
+                    drain()
+                    if os.WIFEXITED(status) or os.WIFSIGNALED(status):
+                        complete = True
+                        if not os.WIFEXITED(status) or os.WEXITSTATUS(status) != 0:
+                            raise RuntimeError(
+                                f"Ginux failed: status={status}\n{output.decode(errors='replace')}")
+                        break
+                    stopped = os.WSTOPSIG(status)
+                    if stopped == (signal.SIGTRAP | 0x80):
+                        info = ctypes.create_string_buffer(128)
+                        ptrace(0x420e, pid, len(info), ctypes.addressof(info))
+                        if info.raw[0] == 1:
+                            regs = Regs()
+                            ptrace(12, pid, 0, ctypes.addressof(regs))
+                            if regs.orig_rax == 101 and regs.rdi == 13:
+                                staged = peek_regs(pid, regs.r10)
+                                address = re.search(
+                                    rb"GINUX_FIXTURE: unix-race-address=(\d+)\n", output)
+                                payload = re.search(
+                                    rb"GINUX_FIXTURE: unix-race-payload=(\d+)\n", output)
+                                if (address and payload and not mutated and staged.orig_rax == 46
+                                        and 0x610000000000 <= staged.rsi < 0x610000200000):
+                                    tracee = regs.rsi
+                                    result, error = store(tracee, staged.rsi, b"X")
+                                    if result != -1 or error != errno.EFAULT:
+                                        raise RuntimeError(
+                                            f"Unix snapshot writable: result={result}, errno={error}")
+                                    result, error = store(
+                                        tracee, int(address[1]) + 2, b"/tmp/unix-snap-b.sock\0")
+                                    if result != 22:
+                                        raise RuntimeError(
+                                            f"cannot mutate caller pathname: result={result}, errno={error}")
+                                    result, error = store(tracee, int(payload[1]), b"B")
+                                    if result != 1:
+                                        raise RuntimeError(
+                                            f"cannot mutate caller payload: result={result}, errno={error}")
+                                    mutated = True
+                    delivered = 0 if stopped in (signal.SIGTRAP, signal.SIGTRAP | 0x80) else stopped
+                    ptrace(24, pid, 0, delivered)
+                drain()
+                received = original_receiver.recv(1)
+                try:
+                    wrong = mutated_receiver.recv(1)
+                except TimeoutError:
+                    wrong = b""
+                expected = (b"GINUX_FIXTURE: unix-race-send=1\n",
+                            b"GINUX_FIXTURE: unix-race-mutated=1\n")
+                if (not mutated or received != b"A" or wrong != b""
+                        or any(line not in output for line in expected)):
+                    raise RuntimeError(
+                        f"incomplete Unix snapshot control: mutation={mutated}, "
+                        f"received={received!r}, wrong={wrong!r}\n"
+                        f"{output.decode(errors='replace')}")
+                print("PASS native Unix send: caller pathname and payload mutated; snapshot used")
+            finally:
+                signal.setitimer(signal.ITIMER_REAL, 0)
+                signal.signal(signal.SIGALRM, previous_alarm)
+                if not complete:
+                    os.kill(pid, signal.SIGKILL)
+                    os.waitpid(pid, 0)
+                os.close(read_fd)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/test-native-vfs.sh b/scripts/test-native-vfs.sh
