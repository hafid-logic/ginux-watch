+fn native_limit_cpus(pid: usize, vcpus: u64) -> bool {
+    if vcpus == 0 || vcpus > 64 {
+        return false;
+    }
+    let mask = if vcpus == 64 {
+        u64::MAX
+    } else {
+        (1u64 << vcpus) - 1
+    };
+    unsafe {
+        syscall3(
+            SYS_SCHED_SETAFFINITY_HOST,
+            pid,
+            core::mem::size_of::<u64>(),
+            &mask as *const _ as usize,
+        ) >= 0
+    }
