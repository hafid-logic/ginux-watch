+        "jnz 2f\n"
+        "1: cmpl $0, descriptor_mutation_start(%rip)\n"
+        "je 1b\n"
+        "movq $1, descriptor_mutation_entered(%rip)\n"
+        "mov $72, %eax\n"
+        "mov $1, %edi\n"
+        "mov $7, %esi\n"
+        "mov %r12, %rdx\n"
+        "syscall\n"
+        "mov %rax, descriptor_mutation_result(%rip)\n"
+        "mov $60, %eax\n"
+        "xor %edi, %edi\n"
+        "syscall\n"
+        "ud2\n"
+        "2: pop %r12\n"
+        "ret\n");
