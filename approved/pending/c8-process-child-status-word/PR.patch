diff --git a/scripts/fetch-rocky-oci.sh b/scripts/fetch-rocky-oci.sh
new file mode 100755
index 0000000..5b6fa12
--- /dev/null
+++ b/scripts/fetch-rocky-oci.sh
@@ -0,0 +1,200 @@
+#!/bin/sh
+set -eu
+
+script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
+. "$script_dir/oci-common.sh"
+umask 077
+
+for command in curl jq; do
+    command -v "$command" >/dev/null 2>&1 || {
+        printf 'missing required command: %s\n' "$command" >&2
+        exit 1
+    }
+done
+
+mkdir -p "$GINUX_OCI_BLOBS_DIR" "$GINUX_OCI_WORK_DIR"
+token_file=$GINUX_OCI_WORK_DIR/token.json
+layout_tmp=$GINUX_OCI_WORK_DIR/oci-layout.tmp
+index_tmp=$GINUX_OCI_WORK_DIR/index.json.tmp
+
+cleanup() {
+    rm -f "$token_file" "$layout_tmp" "$index_tmp" "$GINUX_OCI_WORK_DIR"/*.partial
+}
+trap cleanup 0 HUP INT TERM
+
+render_progress() {
+    progress_file=$1
+    progress_size=$2
+    progress_label=$3
+    progress_width=24
+    progress_bytes=0
+    test -f "$progress_file" && progress_bytes=$(wc -c <"$progress_file" | tr -d ' ')
+    test "$progress_bytes" -le "$progress_size" || progress_bytes=$progress_size
+    progress_percent=$((progress_bytes * 100 / progress_size))
+    progress_filled=$((progress_percent * progress_width / 100))
+    progress_empty=$((progress_width - progress_filled))
+    progress_done=$(printf '%*s' "$progress_filled" '' | tr ' ' '#')
+    progress_left=$(printf '%*s' "$progress_empty" '')
+    printf '\r    %-9s [%s%s] %3s%%  %s / %s' \
+        "$progress_label" "$progress_done" "$progress_left" "$progress_percent" \
+        "$(oci_human_bytes "$progress_bytes")" "$(oci_human_bytes "$progress_size")" >&2
+}
+
+download_layer() {
+    download_url=$1
+    download_accept=$2
+    download_destination=$3
+    download_label=$4
+    download_size=$5
+    case "$download_label" in
+        layer\ *) download_display="Layer ${download_label#layer }" ;;
+        *) download_display=$download_label ;;
+    esac
+
+    if test -t 2; then
+        curl -fsSL --retry 3 \
+            -H "Authorization: Bearer $token" \
+            -H "Accept: $download_accept" \
+            "$download_url" -o "$download_destination" &
+        download_pid=$!
+        while kill -0 "$download_pid" 2>/dev/null; do
+            render_progress "$download_destination" "$download_size" "$download_display"
+            sleep 0.2
+        done
+        if ! wait "$download_pid"; then
+            printf '\n' >&2
+            return 1
+        fi
+        render_progress "$download_destination" "$download_size" "$download_display"
+        printf '\n' >&2
+    else
+        printf '    Downloading %s (%s)... ' \
+            "$download_display" "$(oci_human_bytes "$download_size")"
+        curl -fsSL --retry 3 \
+            -H "Authorization: Bearer $token" \
+            -H "Accept: $download_accept" \
+            "$download_url" -o "$download_destination"
+        printf 'done\n'
+    fi
+}
+
+curl -fsSL --retry 3 \
+    "https://auth.docker.io/token?service=$GINUX_OCI_AUTH_SERVICE&scope=repository:$GINUX_OCI_REPOSITORY:pull" \
+    -o "$token_file"
+token=$(jq -er '.token' "$token_file")
+
+fetch_object() {
+    endpoint=$1
+    digest=$2
+    accept=$3
+    label=${4:-object}
+    size=${5:-unknown}
+    destination=$(oci_blob_path "$digest")
+    if oci_verify_blob "$digest"; then
+        if ! oci_human_output && [ "$label" != object ]; then
+            printf 'OCI_FETCH: cached %s digest=%s size=%s\n' "$label" "$digest" "$size"
+        fi
+        return 0
+    fi
+    partial=$GINUX_OCI_WORK_DIR/$(oci_digest_hex "$digest").partial
+    rm -f "$partial"
+    if [ "$label" = object ]; then
+        curl -fsSL --retry 3 \
+            -H "Authorization: Bearer $token" \
+            -H "Accept: $accept" \
+            "https://$GINUX_OCI_REGISTRY/v2/$GINUX_OCI_REPOSITORY/$endpoint/$digest" \
+            -o "$partial"
+    elif oci_human_output; then
+        case "$label" in
+            layer\ *)
+                download_layer \
+                    "https://$GINUX_OCI_REGISTRY/v2/$GINUX_OCI_REPOSITORY/$endpoint/$digest" \
+                    "$accept" "$partial" "$label" "$size"
+                ;;
+            *)
+                curl -fsSL --retry 3 \
+                    -H "Authorization: Bearer $token" \
+                    -H "Accept: $accept" \
+                    "https://$GINUX_OCI_REGISTRY/v2/$GINUX_OCI_REPOSITORY/$endpoint/$digest" \
+                    -o "$partial"
+                ;;
+        esac
+    else
+        printf 'OCI_FETCH: downloading %s digest=%s size=%s bytes\n' "$label" "$digest" "$size"
+        curl -fL --retry 3 --progress-bar --show-error \
+            -H "Authorization: Bearer $token" \
+            -H "Accept: $accept" \
+            "https://$GINUX_OCI_REGISTRY/v2/$GINUX_OCI_REPOSITORY/$endpoint/$digest" \
+            -o "$partial"
+        printf 'OCI_FETCH: downloaded %s digest=%s size=%s bytes\n' "$label" "$digest" "$size"
+    fi
+    actual=$(oci_sha256_file "$partial")
+    if [ "sha256:$actual" != "$digest" ]; then
+        printf 'digest mismatch for %s: expected %s, got sha256:%s\n' \
+            "$endpoint" "$digest" "$actual" >&2
+        exit 1
+    fi
+    mv "$partial" "$destination"
+}
+
+fetch_object manifests "$GINUX_OCI_INDEX_DIGEST" "application/vnd.oci.image.index.v1+json, application/vnd.docker.distribution.manifest.list.v2+json"
+index_blob=$(oci_blob_path "$GINUX_OCI_INDEX_DIGEST")
+jq -e \
+    --arg digest "$GINUX_OCI_MANIFEST_DIGEST" \
+    --arg os "$GINUX_OCI_PLATFORM_OS" \
+    --arg arch "$GINUX_OCI_PLATFORM_ARCH" \
+    '.schemaVersion == 2 and
+     (.mediaType == "application/vnd.oci.image.index.v1+json" or
+      .mediaType == "application/vnd.docker.distribution.manifest.list.v2+json") and
+     any(.manifests[]; .digest == $digest and .platform.os == $os and
+         .platform.architecture == $arch)' \
+    "$index_blob" >/dev/null
+
+fetch_object manifests "$GINUX_OCI_MANIFEST_DIGEST" "application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.v2+json"
+manifest_blob=$(oci_blob_path "$GINUX_OCI_MANIFEST_DIGEST")
+jq -e '.schemaVersion == 2 and
+       (.mediaType == "application/vnd.oci.image.manifest.v1+json" or
+        .mediaType == "application/vnd.docker.distribution.manifest.v2+json") and
+       (.config.digest | startswith("sha256:")) and
+       all(.layers[]; .digest | startswith("sha256:"))' \
+    "$manifest_blob" >/dev/null
+
+config_digest=$(jq -er '.config.digest' "$manifest_blob")
+config_size=$(jq -er '.config.size' "$manifest_blob")
+fetch_object blobs "$config_digest" application/octet-stream config "$config_size"
+
+layer_total=$(jq -er '.layers | length' "$manifest_blob")
+layer_number=0
+tab=$(printf '\t')
+jq -r '.layers[] | [.digest, .size] | @tsv' "$manifest_blob" |
+while IFS="$tab" read -r layer_digest layer_size; do
+    layer_number=$((layer_number + 1))
+    fetch_object blobs "$layer_digest" application/octet-stream \
+        "layer $layer_number/$layer_total" "$layer_size"
+done
+
+manifest_size=$(wc -c < "$manifest_blob" | tr -d ' ')
+manifest_media_type=$(jq -er '.mediaType' "$manifest_blob")
+printf '%s\n' '{"imageLayoutVersion":"1.0.0"}' > "$layout_tmp"
+jq -n \
+    --arg digest "$GINUX_OCI_MANIFEST_DIGEST" \
+    --argjson size "$manifest_size" \
+    --arg media_type "$manifest_media_type" \
+    --arg ref "docker.io/$GINUX_OCI_REPOSITORY:$GINUX_OCI_TAG" \
+    --arg os "$GINUX_OCI_PLATFORM_OS" \
+    --arg arch "$GINUX_OCI_PLATFORM_ARCH" \
+    '{schemaVersion: 2, manifests: [{
+      mediaType: $media_type,
+      digest: $digest,
+      size: $size,
+      annotations: {"org.opencontainers.image.ref.name": $ref},
+      platform: {os: $os, architecture: $arch}
+    }]}' > "$index_tmp"
+mv "$layout_tmp" "$GINUX_OCI_CACHE_DIR/oci-layout"
+mv "$index_tmp" "$GINUX_OCI_CACHE_DIR/index.json"
+
+"$script_dir/verify-rocky-oci.sh"
+if ! oci_human_output; then
+    printf 'OCI_FETCH: cached=%s manifest=%s\n' \
+        "$GINUX_OCI_CACHE_DIR" "$GINUX_OCI_MANIFEST_DIGEST"
+fi
diff --git a/scripts/fuzz-security.sh b/scripts/fuzz-security.sh
new file mode 100755
index 0000000..8c3fd5d
--- /dev/null
+++ b/scripts/fuzz-security.sh
@@ -0,0 +1,57 @@
+#!/bin/sh
+set -eu
+
+seconds=${GINUX_FUZZ_SECONDS:-5}
+artifacts=${GINUX_FUZZ_ARTIFACTS:-build/security-fuzz}
+case $seconds in
+    ''|*[!0-9]*|0) printf '%s\n' 'invalid GINUX_FUZZ_SECONDS' >&2; exit 2 ;;
+esac
+test "$seconds" -le 5 || {
+    printf '%s\n' 'per-target fuzz duration exceeds Gate 13 bound' >&2
+    exit 2
+}
+
+mkdir -p "$artifacts"
+rm -f "$artifacts"/current-*.bin
+# A host build: the target rustflags in .cargo/config.toml are freestanding,
+# so clear them as test-unit and test-security do.
+RUSTFLAGS='' cargo build --quiet -p security-fuzzer
+fuzzer=${CARGO_TARGET_DIR:-target}/debug/security-fuzzer
+test -x "$fuzzer"
+# The memory bound is for the fuzzer. Set before the build, it also binds
+# rustc, which cannot load LLVM under it.
+ulimit -v 262144 2>/dev/null || true
+
+for target in config selector elf vfs-index kernel-path device syscall audit allocator; do
+    timeout_seconds=$((seconds + 2))
+    timeout_marker=$artifacts/timeout-$target
+    rm -f "$timeout_marker"
+    "$fuzzer" "$target" "$seconds" "$artifacts" &
+    fuzz_pid=$!
+    (
+        sleep "$timeout_seconds"
+        if kill -0 "$fuzz_pid" 2>/dev/null; then
+            : >"$timeout_marker"
+            kill -TERM "$fuzz_pid" 2>/dev/null || true
+        fi
+    ) &
+    watchdog_pid=$!
+    set +e
+    wait "$fuzz_pid"
+    fuzz_status=$?
+    set -e
+    kill "$watchdog_pid" 2>/dev/null || true
+    wait "$watchdog_pid" 2>/dev/null || true
+    if test "$fuzz_status" -ne 0 || test -e "$timeout_marker"; then
+        printf 'SECURITY_FUZZ: target=%s result=FAIL artifacts=%s\n' \
+            "$target" "$artifacts" >&2
+        exit 1
+    fi
+    rm -f "$timeout_marker"
+done
+
+if find "$artifacts" -type f \( -name 'current-*' -o -name 'crash-*' \) | grep -q .; then
+    printf 'SECURITY_FUZZ: untriaged artifact remains in %s\n' "$artifacts" >&2
+    exit 1
+fi
+printf '%s\n' 'SECURITY_FUZZ: PASS (9 targets, deterministic corpora, bounded time/input/memory)'
diff --git a/scripts/gate11-benchmark-guest.sh b/scripts/gate11-benchmark-guest.sh
new file mode 100755
index 0000000..93e5f72
--- /dev/null
+++ b/scripts/gate11-benchmark-guest.sh
@@ -0,0 +1,195 @@
+#!/bin/sh
+set -eu
+
+instance=gate11-benchmark
+native_command=/var/tmp/gate11-sysbench-command.sh
+directory=/var/lib/ginux/instances/$instance
+helper=/usr/libexec/ginux/ginux-helper
+base_config=/var/tmp/instance-gate11-benchmark.toml
+result=${GINUX_BENCH_RESULT:-/var/tmp/gate11-results.tsv}
+raw_dir=${GINUX_BENCH_RAW_DIR:-/var/tmp/gate11-raw}
+duration=${GINUX_BENCH_DURATION:-1}
+repetitions=${GINUX_BENCH_REPETITIONS:-3}
+allocations=${GINUX_BENCH_VCPUS:-"1 2 4"}
+workloads=${GINUX_BENCH_WORKLOADS:-"cpu memory threads mutex"}
+audit_enabled=${GINUX_BENCH_AUDIT_ENABLED:-1}
+supervisor_cpu=${GINUX_BENCH_SUPERVISOR_CPU:-}
+capture_audit=${GINUX_BENCH_CAPTURE_AUDIT:-0}
+dispatch_mode=${GINUX_BENCH_DISPATCH_MODE:-selective}
+memory_bytes=1073741824
+
+case "$duration:$repetitions" in
+    *[!0-9:]*|0:*|*:0|:*|*:) printf '%s\n' 'invalid Gate 11 duration or repetition count' >&2; exit 2 ;;
+esac
+case "$audit_enabled" in 0|1) ;; *) printf '%s\n' 'invalid Gate 11 audit enablement' >&2; exit 2 ;; esac
+case "$capture_audit" in 0|1) ;; *) printf '%s\n' 'invalid Gate 11 audit capture mode' >&2; exit 2 ;; esac
+case "$dispatch_mode" in selective|paranoid) ;; *) printf '%s\n' 'invalid Gate 11 dispatch mode' >&2; exit 2 ;; esac
+
+grep -Fqx "control = \"$dispatch_mode\"" "$base_config"
+
+test -x /usr/bin/sysbench
+test -x "$directory/root/usr/bin/sysbench"
+test -x "$helper"
+test -x "$native_command"
+host_hash=$(sha256sum /usr/bin/sysbench | awk '{ print $1 }')
+instance_hash=$(sha256sum "$directory/root/usr/bin/sysbench" | awk '{ print $1 }')
+test "$host_hash" = "$instance_hash"
+
+rm -rf "$raw_dir"
+mkdir -p "$raw_dir"
+printf '%s\n' 'side	workload	vcpus	threads	repetition	direction	unit	value' >"$result"
+
+cpu_list() {
+    case "$1" in
+        1) printf '0' ;;
+        2) printf '0,1' ;;
+        4) printf '0,1,2,3' ;;
+        *) return 1 ;;
+    esac
+}
+
+toml_args() {
+    workload=$1
+    threads=$2
+    case "$workload" in
+        cpu)
+            printf '["cpu", "--threads=%s", "--time=%s", "--cpu-max-prime=10000", "run"]' \
+                "$threads" "$duration"
+            ;;
+        memory)
+            # The omitted memory options are pinned sysbench 1.0.20 defaults:
+            # 1K blocks, 100G total, sequential global writes.
+            printf '["memory", "--threads=%s", "--time=%s", "run"]' \
+                "$threads" "$duration"
+            ;;
+        threads)
+            printf '["threads", "--threads=%s", "--time=%s", "--thread-yields=1000", "--thread-locks=8", "run"]' \
+                "$threads" "$duration"
+            ;;
+        mutex)
+            # Use the pinned sysbench 1.0.20 mutex defaults. The earlier
+            # shortened loop completed in about 15 ms and measured fixed
+            # process startup cost rather than sustained mutex behavior.
+            printf '["mutex", "--threads=%s", "run"]' \
+                "$threads"
+            ;;
+        *) return 1 ;;
+    esac
+}
+
+write_config() {
+    workload=$1
+    vcpus=$2
+    threads=$3
+    args=$(toml_args "$workload" "$threads")
+    sed -e "s/^vcpus = .*/vcpus = $vcpus/" \
+        -e "s|^args = .*|args = $args|" \
+        -e "s/^enabled = .*/enabled = $(test "$audit_enabled" = 1 && printf true || printf false)/" \
+        "$base_config" | sudo tee "$directory/config.toml" >/dev/null
+}
+
+run_one() {
+    side=$1
+    workload=$2
+    vcpus=$3
+    threads=$4
+    output=$5
+    cpus=$(cpu_list "$vcpus")
+    if test "$side" = native; then
+        # Redirection is intentionally performed by the unprivileged driver;
+        # sudo only selects the measured process identity.
+        # shellcheck disable=SC2024
+        if ! sudo -u nobody taskset -c "$cpus" prlimit --as="$memory_bytes" -- \
+            "$native_command" "$workload" "$threads" "$duration" >"$output" 2>&1; then
+            cat "$output" >&2
+            return 1
+        fi
+    else
+        write_config "$workload" "$vcpus" "$threads"
+        sudo truncate -s 0 "$directory/audit.log"
+        # shellcheck disable=SC2024
+        ginux_cpus=$cpus
+        test -z "$supervisor_cpu" || ginux_cpus=$supervisor_cpu
+        if ! sudo taskset -c "$ginux_cpus" prlimit --as="$memory_bytes" -- \
+            "$helper" --protocol 1 run-runtime "$instance" false >"$output" 2>&1; then
+            cat "$output" >&2
+            return 1
+        fi
+        if test "$capture_audit" = 1; then
+            sudo install -m 0644 "$directory/audit.log" "$output.audit"
+        fi
+    fi
+}
+
+metric() {
+    workload=$1
+    output=$2
+    case "$workload" in
+        cpu)
+            awk '/events per second:/ { print $4; found=1 } END { if (!found) exit 1 }' "$output"
+            ;;
+        memory)
+            awk '/MiB transferred/ { value=$4; sub(/^\(/, "", value); print value; found=1 } END { if (!found) exit 1 }' "$output"
+            ;;
+        threads)
+            awk '/total time:/ { time=$3; sub(/s$/, "", time) } /total number of events:/ { events=$5 } END { if (!time || !events) exit 1; printf "%.6f\n", events/time }' "$output"
+            ;;
+        mutex)
+            awk '/total time:/ { time=$3; sub(/s$/, "", time) } /total number of events:/ { events=$5 } END { if (!time || !events) exit 1; printf "%.6f\n", time/events }' "$output"
+            ;;
+    esac
+}
+
+direction() {
+    test "$1" = mutex && printf 'lower' || printf 'higher'
+}
+
+unit() {
+    case "$1" in
+        memory) printf 'MiB/s' ;;
+        mutex) printf 's/event' ;;
+        *) printf 'events/s' ;;
+    esac
+}
+
+sample() {
+    side=$1 workload=$2 vcpus=$3 threads=$4 repetition=$5
+    output=$raw_dir/$side-$workload-v$vcpus-t$threads-r$repetition.log
+    run_one "$side" "$workload" "$vcpus" "$threads" "$output"
+    value=$(metric "$workload" "$output")
+    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
+        "$side" "$workload" "$vcpus" "$threads" "$repetition" \
+        "$(direction "$workload")" "$(unit "$workload")" "$value" >>"$result"
+}
+
+run_row() {
+    workload=$1 vcpus=$2 threads=$3
+    warm=$raw_dir/warm-$workload-v$vcpus-t$threads
+    run_one native "$workload" "$vcpus" "$threads" "$warm-native.log"
+    run_one ginux "$workload" "$vcpus" "$threads" "$warm-ginux.log"
+
+    repetition=1
+    while test "$repetition" -le "$repetitions"; do
+        if test $((repetition % 2)) -eq 1; then
+            sample native "$workload" "$vcpus" "$threads" "$repetition"
+            sample ginux "$workload" "$vcpus" "$threads" "$repetition"
+        else
+            sample ginux "$workload" "$vcpus" "$threads" "$repetition"
+            sample native "$workload" "$vcpus" "$threads" "$repetition"
+        fi
+        repetition=$((repetition + 1))
+    done
+    printf 'GATE11_SAMPLE: workload=%s vcpus=%s threads=%s repetitions=%s\n' \
+        "$workload" "$vcpus" "$threads" "$repetitions"
+}
+
+for workload in $workloads; do
+    case "$workload" in cpu|memory|threads|mutex) ;; *) printf 'invalid workload: %s\n' "$workload" >&2; exit 2 ;; esac
+    for vcpus in $allocations; do
+        cpu_list "$vcpus" >/dev/null || { printf 'invalid vCPU allocation: %s\n' "$vcpus" >&2; exit 2; }
+        run_row "$workload" "$vcpus" 1
+        test "$vcpus" -eq 1 || run_row "$workload" "$vcpus" "$vcpus"
+    done
+done
+
+printf 'GATE11_RESULTS: %s\n' "$result"
diff --git a/scripts/gate11-budget.awk b/scripts/gate11-budget.awk
new file mode 100644
index 0000000..e5a369f
--- /dev/null
+++ b/scripts/gate11-budget.awk
@@ -0,0 +1,80 @@
+BEGIN {
+    FS = "\t"
+    tolerance = tolerance + 0
+}
+
+NR == 1 { next }
+
+{
+    key = $2 SUBSEP $3 SUBSEP $4
+    side_key = $1 SUBSEP key
+    if ($1 != "native" && $1 != "ginux") {
+        printf "GATE11_BUDGET: FAIL reason=unknown-side side=%s\n", $1
+        invalid = 1
+        next
+    }
+    if ($6 != "higher" && $6 != "lower") {
+        printf "GATE11_BUDGET: FAIL reason=unknown-direction direction=%s\n", $6
+        invalid = 1
+        next
+    }
+    if ((key in direction) && direction[key] != $6) {
+        printf "GATE11_BUDGET: FAIL row=%s reason=direction-changed\n", label[key]
+        invalid = 1
+        next
+    }
+    count[side_key]++
+    value[side_key, count[side_key]] = $8 + 0
+    direction[key] = $6
+    label[key] = $2 " vcpus=" $3 " threads=" $4
+    present[key] = 1
+}
+
+function median(side_key,    n, i, j, tmp, work) {
+    n = count[side_key]
+    for (i = 1; i <= n; i++) work[i] = value[side_key, i]
+    for (i = 1; i <= n; i++) {
+        for (j = i + 1; j <= n; j++) {
+            if (work[j] < work[i]) {
+                tmp = work[i]
+                work[i] = work[j]
+                work[j] = tmp
+            }
+        }
+    }
+    if (n % 2) return work[(n + 1) / 2]
+    return (work[n / 2] + work[n / 2 + 1]) / 2
+}
+
+END {
+    failed = invalid
+    rows = 0
+    for (key in present) {
+        rows++
+        native_key = "native" SUBSEP key
+        ginux_key = "ginux" SUBSEP key
+        if (count[native_key] == 0 || count[ginux_key] == 0) {
+            printf "GATE11_BUDGET: FAIL row=%s reason=missing-side\n", label[key]
+            failed = 1
+            continue
+        }
+        native = median(native_key)
+        ginux = median(ginux_key)
+        if (direction[key] == "higher") {
+            ratio = ginux / native
+        } else {
+            ratio = native / ginux
+        }
+        if (ratio + 0.000000001 < 1 - tolerance) {
+            printf "GATE11_BUDGET: FAIL row=%s performance=%.6fx minimum=%.6fx\n", \
+                label[key], ratio, 1 - tolerance
+            failed = 1
+        }
+    }
+    if (rows == 0) {
+        print "GATE11_BUDGET: FAIL reason=no-rows"
+        failed = 1
+    }
+    if (failed) exit 1
+    print "GATE11_BUDGET: PASS"
+}
diff --git a/scripts/gate11-guest-setup.sh b/scripts/gate11-guest-setup.sh
new file mode 100755
index 0000000..5208911
--- /dev/null
+++ b/scripts/gate11-guest-setup.sh
@@ -0,0 +1,61 @@
+#!/bin/sh
+set -eu
+
+instance=gate11-benchmark
+config=/var/tmp/instance-gate11-benchmark.toml
+directory=/var/lib/ginux/instances/$instance
+sysbench_nevra=sysbench-1.0.20-19.el10_2.x86_64
+acquire=${GINUX_BENCH_ACQUIRE:-off}
+
+if ! rpm -q --quiet "$sysbench_nevra"; then
+    if test "$acquire" != on; then
+        printf '%s\n' 'Gate 11 benchmark dependencies are absent; run make bench-prepare first' >&2
+        exit 69
+    fi
+    sudo dnf -y install epel-release >/dev/null
+    sudo dnf -y install "$sysbench_nevra" >/dev/null
+fi
+test "$(rpm -q sysbench)" = "$sysbench_nevra"
+
+if test -d "$directory"; then
+    sudo /usr/libexec/ginux/ginux-helper --protocol 1 stop "$instance" >/dev/null || true
+    sudo rm -rf "$directory"
+fi
+bootstrap_config=/var/tmp/instance-gate11-bootstrap.toml
+sed -e 's|^init = .*|init = "/bin/true"|' \
+    -e 's|^args = .*|args = []|' "$config" >"$bootstrap_config"
+if ! ginux import "$instance" "$bootstrap_config"; then
+    if test "$acquire" != on; then
+        printf '%s\n' 'Gate 11 instance image is absent; run make bench-prepare first' >&2
+    fi
+    exit 1
+fi
+
+root=$directory/root
+dependencies=$(ldd /usr/bin/sysbench | awk '
+    /=> \// { print $3 }
+    $1 ~ /^\// { print $1 }
+' | LC_ALL=C sort -u)
+sudo install -D -m 755 /usr/bin/sysbench "$root/usr/bin/sysbench"
+for dependency in $dependencies; do
+    sudo install -D -m 755 "$dependency" "$root$dependency"
+done
+if test -d /usr/share/sysbench; then
+    sudo mkdir -p "$root/usr/share"
+    sudo cp -a /usr/share/sysbench "$root/usr/share/"
+fi
+sudo chown -R 65534:65534 "$root/usr/bin/sysbench" "$root/usr/share/sysbench" 2>/dev/null || true
+sudo install -m 0644 "$config" "$directory/config.toml"
+
+host_hash=$(sha256sum /usr/bin/sysbench | awk '{ print $1 }')
+instance_hash=$(sudo sha256sum "$root/usr/bin/sysbench" | awk '{ print $1 }')
+test "$host_hash" = "$instance_hash"
+{
+    printf 'sysbench_nevra=%s\n' "$sysbench_nevra"
+    printf 'sysbench_sha256=%s\n' "$host_hash"
+    printf 'host_kernel=%s\n' "$(uname -r)"
+    printf 'host_arch=%s\n' "$(uname -m)"
+} | sudo tee "$directory/benchmark-meta" >/dev/null
+
+printf 'GATE11_SETUP: sysbench=%s sha256=%s instance=%s\n' \
+    "$sysbench_nevra" "$host_hash" "$instance"
diff --git a/scripts/gate11-regression.awk b/scripts/gate11-regression.awk
new file mode 100644
index 0000000..d9a8eae
--- /dev/null
+++ b/scripts/gate11-regression.awk
@@ -0,0 +1,92 @@
+BEGIN {
+    FS = "\t"
+    tolerance = tolerance + 0
+}
+
+FNR == 1 { next }
+
+{
+    key = $2 SUBSEP $3 SUBSEP $4
+    if ($1 != "ginux") next
+    if ($6 != "higher" && $6 != "lower") {
+        printf "GATE11_REGRESSION: FAIL reason=unknown-direction direction=%s\n", $6
+        invalid = 1
+        next
+    }
+    if (FILENAME == accepted_file) {
+        accepted_count[key]++
+        accepted_value[key, accepted_count[key]] = $8 + 0
+        accepted_direction[key] = $6
+        accepted_label[key] = $2 " vcpus=" $3 " threads=" $4
+        accepted_present[key] = 1
+    } else {
+        current_count[key]++
+        current_value[key, current_count[key]] = $8 + 0
+        current_direction[key] = $6
+        current_label[key] = $2 " vcpus=" $3 " threads=" $4
+        current_present[key] = 1
+    }
+}
+
+function median(which, key,    n, i, j, tmp, work) {
+    if (which == "accepted") {
+        n = accepted_count[key]
+        for (i = 1; i <= n; i++) work[i] = accepted_value[key, i]
+    } else {
+        n = current_count[key]
+        for (i = 1; i <= n; i++) work[i] = current_value[key, i]
+    }
+    for (i = 1; i <= n; i++) {
+        for (j = i + 1; j <= n; j++) {
+            if (work[j] < work[i]) {
+                tmp = work[i]
+                work[i] = work[j]
+                work[j] = tmp
+            }
+        }
+    }
+    if (n % 2) return work[(n + 1) / 2]
+    return (work[n / 2] + work[n / 2 + 1]) / 2
+}
+
+END {
+    failed = invalid
+    rows = 0
+    for (key in accepted_present) {
+        rows++
+        if (!(key in current_present)) {
+            printf "GATE11_REGRESSION: FAIL row=%s reason=missing-current-row\n", accepted_label[key]
+            failed = 1
+            continue
+        }
+        if (accepted_direction[key] != current_direction[key]) {
+            printf "GATE11_REGRESSION: FAIL row=%s reason=direction-changed\n", accepted_label[key]
+            failed = 1
+            continue
+        }
+        accepted = median("accepted", key)
+        current = median("current", key)
+        if (accepted_direction[key] == "higher") {
+            ratio = current / accepted
+        } else {
+            ratio = accepted / current
+        }
+        if (ratio + 0.000000001 < 1 - tolerance) {
+            printf "GATE11_REGRESSION: FAIL row=%s performance=%.6fx minimum=%.6fx\n", \
+                accepted_label[key], ratio, 1 - tolerance
+            failed = 1
+        }
+    }
+    if (rows == 0) {
+        print "GATE11_REGRESSION: FAIL reason=no-accepted-rows"
+        failed = 1
+    }
+    for (key in current_present) {
+        if (!(key in accepted_present)) {
+            printf "GATE11_REGRESSION: FAIL row=%s reason=unaccepted-row\n", current_label[key]
+            failed = 1
+        }
+    }
+    if (failed) exit 1
+    print "GATE11_REGRESSION: PASS"
+}
diff --git a/scripts/gate11-report.awk b/scripts/gate11-report.awk
new file mode 100644
index 0000000..1aacf53
--- /dev/null
+++ b/scripts/gate11-report.awk
@@ -0,0 +1,72 @@
+BEGIN {
+    FS = "\t"
+}
+
+NR == 1 { next }
+
+{
+    key = $2 SUBSEP $3 SUBSEP $4
+    side_key = $1 SUBSEP key
+    count[side_key]++
+    value[side_key, count[side_key]] = $8 + 0
+    direction[key] = $6
+    unit[key] = $7
+    present[key] = 1
+}
+
+function median(side_key,    n, i, j, tmp, work) {
+    n = count[side_key]
+    for (i = 1; i <= n; i++) work[i] = value[side_key, i]
+    for (i = 1; i <= n; i++) {
+        for (j = i + 1; j <= n; j++) {
+            if (work[j] < work[i]) {
+                tmp = work[i]
+                work[i] = work[j]
+                work[j] = tmp
+            }
+        }
+    }
+    if (n % 2) return work[(n + 1) / 2]
+    return (work[n / 2] + work[n / 2 + 1]) / 2
+}
+
+function cv(side_key,    n, i, mean, variance) {
+    n = count[side_key]
+    for (i = 1; i <= n; i++) mean += value[side_key, i]
+    mean /= n
+    if (n < 2 || mean == 0) return 0
+    for (i = 1; i <= n; i++) variance += (value[side_key, i] - mean) ^ 2
+    return sqrt(variance / (n - 1)) / mean * 100
+}
+
+END {
+    print "| Workload | vCPUs | Threads | Native median | Ginux median | Performance | Difference | Native CV | Ginux CV | Budget |"
+    print "|---|---:|---:|---:|---:|---:|---:|---:|---:|:---:|"
+    for (workload_index = 1; workload_index <= 4; workload_index++) {
+        workload = (workload_index == 1 ? "cpu" : workload_index == 2 ? "memory" : workload_index == 3 ? "threads" : "mutex")
+        for (vcpus = 1; vcpus <= 4; vcpus *= 2) {
+            for (thread_index = 1; thread_index <= 2; thread_index++) {
+                threads = (thread_index == 1 ? 1 : vcpus)
+                if (thread_index == 2 && vcpus == 1) continue
+                key = workload SUBSEP vcpus SUBSEP threads
+                if (!(key in present)) continue
+                native_key = "native" SUBSEP key
+                ginux_key = "ginux" SUBSEP key
+                native = median(native_key)
+                ginux = median(ginux_key)
+                if (direction[key] == "higher") {
+                    ratio = ginux / native
+                    difference = (ratio - 1) * 100
+                    pass = ginux >= native * 0.96
+                } else {
+                    ratio = native / ginux
+                    difference = (ratio - 1) * 100
+                    pass = ginux <= native * 1.04
+                }
+                printf "| %s | %d | %d | %.3f %s | %.3f %s | %.3fx | %+.2f%% | %.2f%% | %.2f%% | %s |\n", \
+                    workload, vcpus, threads, native, unit[key], ginux, unit[key], ratio, difference, \
+                    cv(native_key), cv(ginux_key), (pass ? "PASS" : "FAIL")
+            }
+        }
+    }
+}
diff --git a/scripts/gate11-sysbench-command.sh b/scripts/gate11-sysbench-command.sh
new file mode 100755
index 0000000..212ef56
--- /dev/null
+++ b/scripts/gate11-sysbench-command.sh
@@ -0,0 +1,26 @@
+#!/bin/sh
+set -eu
+
+test "$#" -eq 3 || { printf '%s\n' 'usage: gate11-sysbench-command WORKLOAD THREADS DURATION' >&2; exit 2; }
+workload=$1
+threads=$2
+duration=$3
+
+case "$workload" in
+    cpu)
+        exec /usr/bin/sysbench cpu --threads="$threads" --time="$duration" \
+            --cpu-max-prime=10000 run
+        ;;
+    memory)
+        exec /usr/bin/sysbench memory --threads="$threads" --time="$duration" \
+            run
+        ;;
+    threads)
+        exec /usr/bin/sysbench threads --threads="$threads" --time="$duration" \
+            --thread-yields=1000 --thread-locks=8 run
+        ;;
+    mutex)
+        exec /usr/bin/sysbench mutex --threads="$threads" run
+        ;;
+    *) printf 'invalid workload: %s\n' "$workload" >&2; exit 2 ;;
+esac
diff --git a/scripts/gate12-cli-guest.sh b/scripts/gate12-cli-guest.sh
