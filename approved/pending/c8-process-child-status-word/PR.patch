index 0000000..e0644ba
--- /dev/null
+++ b/scripts/test-oci-layers.sh
@@ -0,0 +1,236 @@
+#!/bin/sh
+set -eu
+
+work=build/oci-layer-test
+base=$work/base
+upper=$work/upper
+
+rm -rf "$work"
+mkdir -p "$base/usr/bin" "$base/usr/lib64" "$base/etc" \
+    "$base/opt/old" "$base/opt/keep" "$upper/etc" "$upper/opt/old"
+printf '\177ELFbase-bash\n' > "$base/usr/bin/bash"
+printf '\177ELFbase-loader\n' > "$base/usr/lib64/ld-linux-x86-64.so.2"
+printf '\177ELFbase-libc\n' > "$base/usr/lib64/libc.so.6"
+printf '%s\n' base > "$base/etc/value"
+printf '%s\n' removed > "$base/etc/remove"
+printf '%s\n' old > "$base/opt/old/lower"
+printf '%s\n' keep > "$base/opt/keep/value"
+# Hard links that sort before and after their target, and one with names
+# over 100 bytes (PAX path/linkpath). The upper layer replaces the targets;
+# the links keep the lower layer's data, as in overlayfs.
+long=$(printf 'n%.0s' $(seq 1 110))
+mkdir -p "$base/etc/long"
+printf '%s\n' zone > "$base/etc/zone"
+ln "$base/etc/zone" "$base/etc/aaa-zone"
+ln "$base/etc/zone" "$base/etc/zzz-zone"
+printf '%s\n' long > "$base/etc/long/$long-target"
+ln "$base/etc/long/$long-target" "$base/etc/long/$long-link"
+
+printf '%s\n' upper > "$upper/etc/value"
+: > "$upper/etc/.wh.remove"
+: > "$upper/opt/old/.wh..wh..opq"
+printf '%s\n' new > "$upper/opt/old/upper"
+mkdir -p "$upper/etc/long"
+printf '%s\n' upper-zone > "$upper/etc/zone"
+printf '%s\n' upper-long > "$upper/etc/long/$long-target"
+
+# List the base explicitly so each target precedes its links: the first name
+# of a hard-linked inode becomes the regular file in the archive.
+(cd "$base" && find . ! -name aaa-zone ! -name zzz-zone ! -name "$long-link" | sort &&
+    printf '%s\n' ./etc/aaa-zone ./etc/zzz-zone "./etc/long/$long-link") > "$work/base.list"
+tar --format=pax --no-recursion -cf "$work/base.tar" -C "$base" -T "$work/base.list"
+tar --format=pax -cf "$work/upper.tar" -C "$upper" .
+cargo run -q -p ginux-vfs-index -- assemble \
+    "$work/rootfs-1.tar" "$work/rootfs-1.index" \
+    "$work/base.tar" "$work/upper.tar" >/dev/null
+cargo run -q -p ginux-vfs-index -- assemble \
+    "$work/rootfs-2.tar" "$work/rootfs-2.index" \
+    "$work/base.tar" "$work/upper.tar" >/dev/null
+
+test "$(tar -xOf "$work/rootfs-1.tar" ./etc/value)" = upper
+test "$(tar -xOf "$work/rootfs-1.tar" ./opt/old/upper)" = new
+test "$(tar -xOf "$work/rootfs-1.tar" ./opt/keep/value)" = keep
+rm -rf "$work/extract" && mkdir "$work/extract" && tar -xf "$work/rootfs-1.tar" -C "$work/extract"
+test "$(cat "$work/extract/etc/zone")" = upper-zone
+test "$(cat "$work/extract/etc/aaa-zone")" = zone
+test "$(cat "$work/extract/etc/zzz-zone")" = zone
+test "$(cat "$work/extract/etc/long/$long-target")" = upper-long
+test "$(cat "$work/extract/etc/long/$long-link")" = long
+if tar -tvf "$work/rootfs-1.tar" | grep -q '^h'; then
+    printf '%s\n' 'assembled rootfs still contains hard-link records' >&2
+    exit 1
+fi
+# No long symlinks in these layers, so no PAX linkpath may survive: a
+# regular file carrying one is extracted as a link by libarchive.
+if grep -aq ' linkpath=' "$work/rootfs-1.tar"; then
+    printf '%s\n' 'assembled regular file still carries a PAX linkpath' >&2
+    exit 1
+fi
+grep -Fq /etc/aaa-zone "$work/rootfs-1.index"
+grep -Fq "/etc/long/$long-link" "$work/rootfs-1.index"
+cargo run -q -p ginux-vfs-index -- "$work/base.tar" "$work/base.index" >/dev/null
+grep -Fq /etc/zzz-zone "$work/base.index"
+grep -Fq "/etc/long/$long-link" "$work/base.index"
+if tar -tf "$work/rootfs-1.tar" | grep -Eq '(^|/)remove$|(^|/)lower$|\.wh\.'; then
+    printf '%s\n' 'whiteout or opaque-directory assembly failed' >&2
+    exit 1
+fi
+cmp "$work/rootfs-1.tar" "$work/rootfs-2.tar"
+cmp "$work/rootfs-1.index" "$work/rootfs-2.index"
+
+# Plain mode must reject an archive cut inside an entry's data, inside a
+# header, or at an entry boundary without the end-of-archive blocks.
+plain=$work/plain
+mkdir -p "$plain/usr/bin" "$plain/usr/lib64"
+cp "$base/usr/bin/bash" "$plain/usr/bin/bash"
+cp "$base/usr/lib64/ld-linux-x86-64.so.2" "$base/usr/lib64/libc.so.6" "$plain/usr/lib64/"
+{ printf '%s\n' truncation-marker; seq 1 20000; } > "$plain/zz-large"
+(cd "$plain" && find . | sort) > "$work/plain.list"
+tar --format=ustar --no-recursion -cf "$work/plain.tar" -C "$plain" -T "$work/plain.list"
+marker=$(grep -abo truncation-marker "$work/plain.tar" | cut -d: -f1)
+large=$(wc -c < "$work/plain/zz-large")
+for cut in "$((marker + 4096))" "$((marker - 512 + 100))" \
+    "$((marker + (large + 511) / 512 * 512))"; do
+    head -c "$cut" "$work/plain.tar" > "$work/truncated.tar"
+    if cargo run -q -p ginux-vfs-index -- "$work/truncated.tar" "$work/truncated.index" \
+        >/dev/null 2>"$work/truncated.err"; then
+        printf '%s\n' "plain mode accepted an archive truncated at byte $cut" >&2
+        exit 1
+    fi
+    if ! grep -q truncated "$work/truncated.err"; then
+        printf '%s\n' "plain mode failed without reporting truncation at byte $cut:" >&2
+        cat "$work/truncated.err" >&2
+        exit 1
+    fi
+done
+
+# Plain mode keeps the last entry for a path, as extraction does: the
+# appended bash is the only ELF copy (the index check reads its data), and
+# a file replacing a directory drops the directory's children.
+dup=$work/dup
+mkdir -p "$dup/first/usr/bin" "$dup/first/usr/lib64" "$dup/first/etc/swap" "$dup/last/etc"
+printf '%s\n' not-elf > "$dup/first/usr/bin/bash"
+cp "$base/usr/lib64/ld-linux-x86-64.so.2" "$base/usr/lib64/libc.so.6" "$dup/first/usr/lib64/"
+printf '%s\n' child > "$dup/first/etc/swap/child"
+cp "$base/usr/bin/bash" "$dup/last/bash"
+printf '%s\n' file > "$dup/last/etc/swap"
+tar --format=ustar -cf "$work/dup.tar" -C "$dup/first" .
+cp "$dup/last/bash" "$dup/first/usr/bin/bash"
+tar --format=ustar -rf "$work/dup.tar" -C "$dup/first" ./usr/bin/bash
+tar --format=ustar -rf "$work/dup.tar" -C "$dup/last" ./etc/swap
+cargo run -q -p ginux-vfs-index -- "$work/dup.tar" "$work/dup.index" >/dev/null
+if grep -Fq /etc/swap/child "$work/dup.index"; then
+    printf '%s\n' 'plain mode kept children of a replaced directory' >&2
+    exit 1
+fi
+
+# GNU long-name records (paths and link names over 100 bytes) must keep
+# the full names in the assembled tar and in both indexes.
+# Print the type of each entry in tar $1 that has a GNU long link name (K).
+long_link_entry_types() {
+    grep -Fabo '././@LongLink' "$1" | cut -d: -f1 | while read -r at; do
+        [ $((at % 512)) -eq 0 ] || continue
+        [ "$(dd if="$1" bs=1 skip=$((at + 156)) count=1 2>/dev/null)" = K ] || continue
+        while :; do
+            type=$(dd if="$1" bs=1 skip=$((at + 156)) count=1 2>/dev/null)
+            case $type in L | K) ;; *) break ;; esac
+            size=$(dd if="$1" bs=1 skip=$((at + 124)) count=11 2>/dev/null)
+            at=$((at + 512 + (0$size + 511) / 512 * 512))
+        done
+        printf '%s\n' "$type"
+    done
+}
+if tar --version 2>/dev/null | grep -q 'GNU tar'; then
+    gnu=$work/gnu
+    gnu_upper=$work/gnu-upper
+    mkdir -p "$gnu/usr/bin" "$gnu/usr/lib64" "$gnu/opt/$long" "$gnu_upper/opt/$long"
+    cp "$base/usr/bin/bash" "$gnu/usr/bin/bash"
+    cp "$base/usr/lib64/ld-linux-x86-64.so.2" "$base/usr/lib64/libc.so.6" "$gnu/usr/lib64/"
+    printf '%s\n' gnu-long > "$gnu/opt/$long/$long-file"
+    # Relative: the index holds link names up to 128 bytes.
+    ln -s "$long-file" "$gnu/opt/$long/$long-symlink"
+    ln "$gnu/opt/$long/$long-file" "$gnu/opt/$long/$long-hardlink"
+    (cd "$gnu" && find . ! -name "$long-hardlink" | sort &&
+        printf '%s\n' "./opt/$long/$long-hardlink") > "$work/gnu.list"
+    tar --format=gnu --no-recursion -cf "$work/gnu.tar" -C "$gnu" -T "$work/gnu.list"
+    # The upper layer replaces the hard link's target; the link keeps the
+    # lower data.
+    printf '%s\n' gnu-upper > "$gnu_upper/opt/$long/$long-file"
+    tar --format=gnu -cf "$work/gnu-upper.tar" -C "$gnu_upper" .
+    cargo run -q -p ginux-vfs-index -- assemble \
+        "$work/rootfs-gnu.tar" "$work/rootfs-gnu.index" \
+        "$work/gnu.tar" "$work/gnu-upper.tar" >/dev/null
+    # The hard link's long target name must not survive as a K record:
+    # libarchive extracts a file preceded by one as a hard link. Only the
+    # symlink keeps its K record.
+    test "$(long_link_entry_types "$work/gnu.tar" | sort | tr -d '\n')" = 12
+    if [ "$(long_link_entry_types "$work/rootfs-gnu.tar" | tr -d '\n')" != 2 ]; then
+        printf '%s\n' 'assembled rootfs gives a non-symlink a GNU long link name' >&2
+        exit 1
+    fi
+    rm -rf "$work/extract-gnu" && mkdir "$work/extract-gnu"
+    tar -xf "$work/rootfs-gnu.tar" -C "$work/extract-gnu"
+    test "$(cat "$work/extract-gnu/opt/$long/$long-file")" = gnu-upper
+    test "$(readlink "$work/extract-gnu/opt/$long/$long-symlink")" = "$long-file"
+    test "$(cat "$work/extract-gnu/opt/$long/$long-hardlink")" = gnu-long
+    test ! -L "$work/extract-gnu/opt/$long/$long-hardlink"
+    cargo run -q -p ginux-vfs-index -- "$work/gnu.tar" "$work/gnu.index" >/dev/null
+    for index in "$work/rootfs-gnu.index" "$work/gnu.index"; do
+        grep -Fq "/opt/$long/$long-file" "$index"
+        grep -Fq "/opt/$long/$long-symlink" "$index"
+        grep -Fq "/opt/$long/$long-hardlink" "$index"
+    done
+else
+    printf '%s\n' 'test-oci-layers: skipping GNU long-name case (needs GNU tar)'
+fi
+
+# GNU sparse files (tar --sparse) store only their data regions, and PAX
+# formats 0.1 and 1.0 put them under a GNUSparseFile.<pid> path. Both modes
+# must reject them instead of indexing a wrong name, size and content. A
+# --sparse archive without sparse members stays accepted.
+sparse_cases=
+if tar --version 2>/dev/null | grep -q 'GNU tar'; then
+    sparse=$work/sparse
+    mkdir -p "$sparse/usr/bin" "$sparse/usr/lib64" "$sparse/opt"
+    cp "$base/usr/bin/bash" "$sparse/usr/bin/bash"
+    cp "$base/usr/lib64/ld-linux-x86-64.so.2" "$base/usr/lib64/libc.so.6" "$sparse/usr/lib64/"
+    tar --sparse --format=posix -cf "$work/dense.tar" -C "$sparse" .
+    cargo run -q -p ginux-vfs-index -- "$work/dense.tar" "$work/dense.index" >/dev/null
+    # Six data regions: a GNU-format S header holds four, the rest go to an
+    # extension block.
+    for region in 0 1 2 3 4 5; do
+        printf 'region-%s\n' "$region" |
+            dd of="$sparse/opt/holes" bs=1 seek=$((region * 65536)) conv=notrunc 2>/dev/null
+    done
+    tar --sparse --format=posix -cf "$work/sparse-1.0.tar" -C "$sparse" .
+    tar --sparse --format=posix --sparse-version=0.0 -cf "$work/sparse-0.0.tar" -C "$sparse" .
+    tar --sparse --format=posix --sparse-version=0.1 -cf "$work/sparse-0.1.tar" -C "$sparse" .
+    tar --sparse --format=gnu -cf "$work/sparse-gnu.tar" -C "$sparse" .
+    if grep -aq 'GNU\.sparse\.' "$work/sparse-1.0.tar"; then
+        for archive in sparse-1.0 sparse-0.1 sparse-0.0 sparse-gnu; do
+            for mode in plain assemble; do
+                if [ "$mode" = plain ]; then
+                    set -- "$work/$archive.tar" "$work/$archive.index"
+                else
+                    set -- assemble "$work/$archive-rootfs.tar" "$work/$archive.index" "$work/$archive.tar"
+                fi
+                if cargo run -q -p ginux-vfs-index -- "$@" >/dev/null 2>"$work/sparse.err"; then
+                    printf '%s\n' "$mode mode accepted GNU sparse file in $archive.tar" >&2
+                    exit 1
+                fi
+                if ! grep -Fq 'GNU sparse files are unsupported' "$work/sparse.err" ||
+                    ! grep -Fq /opt/holes "$work/sparse.err"; then
+                    printf '%s\n' "$mode mode failed on $archive.tar without naming the sparse file:" >&2
+                    cat "$work/sparse.err" >&2
+                    exit 1
+                fi
+            done
+        done
+        sparse_cases=', GNU sparse files'
+    else
+        printf '%s\n' 'test-oci-layers: skipping GNU sparse case (file system made no holes)'
+    fi
+else
+    printf '%s\n' 'test-oci-layers: skipping GNU sparse case (needs GNU tar)'
+fi
+printf '%s\n' "test-oci-layers: PASS (replacement, whiteout, opaque directory, hard links, repeatability, truncation, duplicates, GNU long names$sparse_cases)"
diff --git a/scripts/test-process-native.py b/scripts/test-process-native.py
new file mode 100644
index 0000000..b7c8b95
--- /dev/null
+++ b/scripts/test-process-native.py
@@ -0,0 +1,218 @@
+#!/usr/bin/env python3
+"""Exercise process-native against existing native binaries."""
+import ctypes
+import os
+from pathlib import Path
+import signal
+import struct
+import subprocess
+import sys
+import tempfile
+
+# Scenarios that also run with process_vm_writev unavailable, as on a kernel
+# built without CONFIG_CROSS_MEMORY_ATTACH (ENOSYS) or under a seccomp profile
+# that denies it (EPERM). The supervisor then falls back to ptrace writes,
+# which still fail unmapped buffers with EFAULT but write read-only memory.
+# straddle_status and straddle_clone_tid have no such mode: the page after
+# their word is unmapped, so the store faults at the PTRACE_PEEKTEXT of that
+# page before any write, the same with and without the fallback.
+NO_VM_WRITEV = ("wait_status", "ro_status", "bad_status", "bad_rusage", "ro_clone_tid", "bad_clone_tid")
+# ro_status on the ptrace fallback (reduced fidelity): the read-only word is
+# written and the wait succeeds, as before process_vm_writev was used.
+RO_STATUS_FALLBACK = [b"nohang wait=2", b"nohang ro cell=10752", b"nohang rusage=0", b"nohang rewait=-10",
+                      b"blocking wait=3", b"blocking ro cell=10752", b"blocking rusage=0",
+                      b"blocking rewait=-10"]
+# ro_clone_tid on the fallback: the process and the thread are still created,
+# but the virtual tid is written into the read-only cell, as before
+# process_vm_writev was used.
+RO_CLONE_TID_FALLBACK = [b"process clone=2", b"process wait=2", b"process status=0", b"thread clone=3",
+                         b"process ro cell=2", b"child ro cell=2", b"thread ro cell=3", b"parent ro cell=3",
+                         b"process edge=30583", b"child edge=30583", b"thread edge=30583", b"parent edge=30583"]
+RO_FALLBACK = {"ro_status": RO_STATUS_FALLBACK, "ro_clone_tid": RO_CLONE_TID_FALLBACK}
+FALLBACK_AUDIT = b"tracee-write=ptrace-fallback"
+NO_VM_WRITEV_ERRNO = {"/vm-writev-enosys": 38, "/vm-writev-eperm": 1}
+
+
+def deny_process_vm_writev(errno):
+    """Install a seccomp filter that fails process_vm_writev with errno."""
+    libc = ctypes.CDLL(None, use_errno=True)
+    # x86-64 only: load arch, allow others; load nr, errno for 311, else allow.
+    program = [(0x20, 0, 0, 4), (0x15, 0, 3, 0xc000003e), (0x20, 0, 0, 0),
+               (0x15, 0, 1, 311), (0x06, 0, 0, 0x00050000 | errno), (0x06, 0, 0, 0x7fff0000)]
+    raw = ctypes.create_string_buffer(b"".join(struct.pack("HBBI", *op) for op in program))
+
+    class SockFprog(ctypes.Structure):
+        _fields_ = [("len", ctypes.c_ushort), ("filter", ctypes.c_void_p)]
+
+    fprog = SockFprog(len(program), ctypes.addressof(raw))
+    PR_SET_NO_NEW_PRIVS, PR_SET_SECCOMP, SECCOMP_MODE_FILTER = 38, 22, 2
+    # prctl is variadic: pass every argument as a full unsigned long, since
+    # PR_SET_NO_NEW_PRIVS rejects nonzero upper bits in the unused ones.
+    ulong = ctypes.c_ulong
+    if libc.prctl(PR_SET_NO_NEW_PRIVS, ulong(1), ulong(0), ulong(0), ulong(0)) or \
+            libc.prctl(PR_SET_SECCOMP, ulong(SECCOMP_MODE_FILTER), ctypes.byref(fprog), ulong(0), ulong(0)):
+        os._exit(125)
+
+
+def main():
+    if len(sys.argv) not in (4, 5):
+        sys.exit("usage: test-process-native.py <ginux> <fixture directory> <legacy fixture> [scenario]")
+    binary, fixtures, legacy = (str(Path(arg).resolve()) for arg in sys.argv[1:4])
+    config = Path(__file__).resolve().parent.parent / "config/instance-gate7.toml"
+    def wait_fault(status):
+        # wait4 fails with EFAULT after reaping the child, whether it had
+        # exited (nohang) or the wait blocked; a writable status is stored
+        # before the rusage fault, a failed status store skips the rusage,
+        # and memory around the faulting buffers stays untouched.
+        return [path + line for path in (b"nohang", b"blocking")
+                for line in (b" wait=-14", b" ro cell=0", b" edge=30583", b" status=" + status,
+                             b" rusage=1515870810", b" rewait=-10")]
+
+    # clone ignores a tid cell the caller cannot write: the process and the
+    # thread are created and run, and the cell and its neighbors stay
+    # untouched in the parent and in the child's own copy.
+    clone_tid_skipped = [b"process clone=2", b"process wait=2", b"process status=0", b"thread clone=3",
+                         *(who + line for who in (b"process", b"child", b"thread", b"parent")
+                           for line in (b" ro cell=0", b" edge=30583"))]
+
+    expected = {
+        "syscall_abi": [b"set_tid_address(218)=1", b"set_robust_list(273)=0", b"rseq(334)=-22"],
+        "untraced_clone": [b"parent clone result=-38", b"parent wait result=-10"],
+        "shared_pipe": [b"parent shared pipe read=1"],
+        "wait_status": [b"unaligned wait result=2", b"status byte 7=0", b"status byte 8=42"],
+        "thread_reuse": [b"sequential thread=33"],
+        "denied_host_memory": [b"process_vm_writev(311)=-38"],
+        "inherited_fds": [b"inherited read=-9", b"dup inherited fd=-9", b"read alias=-9", b"inherited close=-9"],
+        "thread_exec": [b"exec-success", b"exec-complete virtual-pid=1"],
+        "unused_parent_tid": [b"no-parent-settid thread=2"],
+        "exec_failure": [b"thread exec result=-2", b"parent resumed=1"],
+        "copied_files": [b"child close=0", b"parent pipe write=1"],
+        "shared_exec": [b"shared exec wait=2", b"parent pipe write=1"],
+        "clone_tid": [b"parent tid cell=2", b"child tid cell=2", b"child gettid=2", b"clone return=2", b"clone wait=2"],
+        "child_signal": [b"signal wait=2", b"signal status=15"],
+        "nonblocking_wait": [b"nonblocking wait=0", b"blocking wait=2"],
+        "concurrent_wait": [b"concurrent wait result=2", b"concurrent wait result=-10"],
+        "remaining_wait": [b"concurrent wait result=2", b"concurrent wait result=3"],
+        "vfork": [b"vfork return=2", b"vfork wait=2", b"vfork status=10752"],
+        "sigpipe": [b"sigpipe wait=2", b"sigpipe status=13"],
+        "segv": [b"segv wait=2", b"segv status=11"],
+        "kill_badsig": [b"kill signal 65=-22", b"kill signal -1=-22", b"kill missing pid signal 65=-3"],
+        "thread_segv": [b"thread segv wait=2", b"thread segv status=11"],
+        "thread_term": [b"thread term kill=0", b"thread term wait=2", b"thread term status=15"],
+        "parked_kill": [b"parked kill wait=2", b"parked kill status=11"],
+        "parked_term": [b"parked term kill=0", b"parked term wait=2", b"parked term status=15"],
+        "orphan_reparent": [b"orphan middle wait=2", b"orphan getppid=1", b"orphan wait=3",
+                            b"orphan status=1792"],
+        "orphan_zombie": [b"orphan middle wait=2", b"orphan wait=3", b"orphan status=1792"],
+        "ro_status": wait_fault(b"305419896"),
+        "bad_status": wait_fault(b"305419896"),
+        "bad_rusage": wait_fault(b"10752"),
+        "straddle_status": wait_fault(b"305419896"),
+        "ro_clone_tid": clone_tid_skipped,
+        "bad_clone_tid": clone_tid_skipped,
+        "straddle_clone_tid": clone_tid_skipped,
+        "alias_writes": [b"plain stdin write=-38", b"dup stdin write=-38", b"dup alias write=-38",
+                         b"dup2 stdin write=-38", b"dup3 stdin write=-38", b"fcntl dupfd stdin write=-38",
+                         b"fcntl dupfd-cloexec stdin write=-38", b"stdin over stdout write=-38",
+                         b"stdout alias write=16", b"plain stdout write 4097=-38",
+                         b"stdout alias write 4097=-38", b"restored stdout write 4097=-38",
+                         b"stderr alias write=16", b"stderr alias write 4097=-38"],
+    }
+    for suffix, errno in NO_VM_WRITEV_ERRNO.items():
+        for name in NO_VM_WRITEV:
+            base = RO_FALLBACK.get(name, expected[name])
+            expected[name + suffix] = [*base, FALLBACK_AUDIT + b" process_vm_writev=-%d" % errno]
+    with tempfile.TemporaryDirectory(prefix="ginux-process-") as directory:
+        sentinel = Path(directory) / "sentinel"
+        sentinel.write_bytes(b"controlled sentinel\n")
+        fd = os.open(sentinel, os.O_RDONLY)
+        os.dup2(fd, 9)
+        if fd != 9:
+            os.close(fd)
+        try:
+            allowed_cpus = sorted(os.sched_getaffinity(0))
+            selected = sys.argv[4:] or [*expected, "legacy"]
+            for mode in selected:
+                if mode not in expected and mode != "legacy":
+                    raise RuntimeError(f"unknown scenario {mode}")
+                scenario, _, variant = mode.partition("/")
+                denied = NO_VM_WRITEV_ERRNO.get("/" + variant) if variant else None
+                path = legacy if mode == "legacy" else f"{fixtures}/{scenario}"
+                repetitions = 100 if mode == "legacy" else 20 if scenario in (
+                    "thread_exec", "exec_failure", "thread_reuse", "clone_tid", "vfork",
+                    "concurrent_wait", "remaining_wait", "sigpipe", "segv", "thread_segv",
+                    "thread_term", "parked_kill", "parked_term", "ro_status", "bad_status", "bad_rusage",
+                    "straddle_status", "ro_clone_tid", "bad_clone_tid", "straddle_clone_tid",
+                    "orphan_reparent", "orphan_zombie"
+                ) else 1
+                deferred_stops = 0
+                for run in range(repetitions):
+                    # Exercise both child-first and parent-first ptrace event
+                    # ordering under different amounts of CPU concurrency.
+                    affinity = (allowed_cpus, allowed_cpus[:1], allowed_cpus[:2])[run % 3]
+                    # A writable host file as stdin shows whether any write
+                    # through a stdin alias reaches the host.
+                    stdin_sink = Path(directory) / "stdin-sink"
+                    stdin = os.open(stdin_sink, os.O_RDWR | os.O_CREAT | os.O_TRUNC) \
+                        if mode == "alias_writes" else None
+                    try:
+                        proc = subprocess.Popen([binary, "process-native", str(config), path],
+                                                stdin=stdin, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                                                pass_fds=(9,), start_new_session=True,
+                                                preexec_fn=lambda: (os.sched_setaffinity(0, affinity),
+                                                                    denied and deny_process_vm_writev(denied)))
+                    finally:
+                        if stdin is not None:
+                            os.close(stdin)
+                    try:
+                        out, err = proc.communicate(timeout=15)
+                    except subprocess.TimeoutExpired:
+                        os.killpg(proc.pid, signal.SIGKILL)
+                        proc.communicate()
+                        raise RuntimeError(f"process scenario {mode} hung")
+                    if stdin is not None and stdin_sink.read_bytes():
+                        raise RuntimeError(f"scenario {mode} wrote to the host stdin: "
+                                           f"{stdin_sink.read_bytes()!r}\n{out!r}")
+                    # A wrapped mode must take the fallback. A plain mode takes
+                    # it only where the supervisor finds process_vm_writev
+                    # unavailable, which its audit line reports; ro_status
+                    # and ro_clone_tid then have the reduced-fidelity result.
+                    fallback = FALLBACK_AUDIT in out
+                    if denied and not fallback:
+                        raise RuntimeError(f"scenario {mode} did not use the ptrace fallback: {out!r}")
+                    required = expected.get(mode, [b"GINUX_NATIVE_PARENT: PASS"])
+                    if mode in RO_FALLBACK and fallback:
+                        required = RO_FALLBACK[mode]
+                    required = [*required, b"GATE7_NATIVE_PROCESS: PASS", b"descriptors live-pipes=0"]
+                    if proc.returncode or any(item not in out for item in required):
+                        raise RuntimeError(f"scenario {mode}: exit={proc.returncode}\n{out!r}\n{err!r}")
+                    if b"untraced child" in out or b"controlled sentinel" in out:
+                        raise RuntimeError(f"scenario {mode} escaped supervision: {out!r}")
+                    if mode in ("concurrent_wait", "remaining_wait") and out.count(b"wait parked caller=") != 2:
+                        raise RuntimeError(f"scenario {mode} did not exercise two parked waiters: {out!r}")
+                    if (scenario in ("bad_status", "bad_rusage", "straddle_status")
+                            or scenario == "ro_status" and not fallback) and (
+                            out.count(b"wait store fault caller=1") != 2 or out.count(b"wait parked caller=1") != 1):
+                        raise RuntimeError(f"scenario {mode} did not fault both the direct and the parked wait: {out!r}")
+                    # Every skipped tid store is audited, none claims a
+                    # published thread tid: parent and child cell, for the
+                    # process and for the thread.
+                    if scenario in ("bad_clone_tid", "straddle_clone_tid") or (
+                            scenario == "ro_clone_tid" and not fallback):
+                        if out.count(b"tid store fault virtual-tid=") != 4 or b"thread-tid virtual-tid=" in out:
+                            raise RuntimeError(f"scenario {mode} did not skip all four tid stores: {out!r}")
+                    elif scenario == "ro_clone_tid" and b"tid store fault" in out:
+                        raise RuntimeError(f"scenario {mode} faulted a tid store on the fallback: {out!r}")
+                    deferred = out.count(b"newborn-stop=deferred")
+                    if deferred != out.count(b"newborn-stop=registered"):
+                        raise RuntimeError(f"scenario {mode} left a child stop unregistered: {out!r}")
+                    deferred_stops += deferred
+                print(f"PASS process scenario {mode} ({repetitions} run(s), "
+                      f"{deferred_stops} early child stop(s))")
+        finally:
+            os.close(9)
+    print("test-process-native: PASS")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/test-process.sh b/scripts/test-process.sh
new file mode 100755
index 0000000..f8f2922
--- /dev/null
+++ b/scripts/test-process.sh
@@ -0,0 +1,33 @@
+#!/bin/sh
+set -eu
+
+. ./scripts/rocky-host-common.sh
+
+log=build/gate7-process.log
+./scripts/check-rocky-host.sh
+rocky_scp target/x86_64-unknown-linux-gnu/release/ginux \
+    "$ROCKY_SSH_USER@127.0.0.1:/var/tmp/ginux"
+rocky_scp config/instance-gate7.toml \
+    "$ROCKY_SSH_USER@127.0.0.1:/var/tmp/gate7.toml"
+rocky_scp target/x86_64-unknown-linux-gnu/release/process-native-fixture \
+    "$ROCKY_SSH_USER@127.0.0.1:/var/tmp/process-native-fixture"
+rocky_ssh 'chmod 0755 /var/tmp/ginux; /var/tmp/ginux process /var/tmp/gate7.toml' > "$log" 2>&1
+
+grep -Fqx 'GINUX_PROCESS: init=1 parent=0 host-pid=unexposed' "$log"
+grep -Fqx 'GINUX_PROCESS: fork-clone-exec-wait iterations=256 stale-id=denied active=1' "$log"
+grep -Fqx 'GINUX_PROCESS: signal=10 blocked-wait=interrupted handler=0x4000 return=PASS' "$log"
+grep -Fqx 'GINUX_PROCESS: virtual-uid=1000 virtual-gid=1000 host-credentials=unchanged regain-root=denied' "$log"
+grep -Fqx 'GINUX_PROCESS: futex-wake=1 eventfd=9 epoll=readable timer-expirations=4' "$log"
+grep -Fqx 'GINUX_PROCESS: shutdown tasks=0 waiters=0 events=0 timers=0 resources=released' "$log"
+grep -Fqx 'GATE7_PROCESS: PASS' "$log"
+
+rocky_ssh 'set -eu; chmod 0755 /var/tmp/process-native-fixture; uid=$(id -u); gid=$(id -g); /var/tmp/ginux process-native /var/tmp/gate7.toml /var/tmp/process-native-fixture >/var/tmp/ginux-process-native.log 2>&1 & runtime=$!; stopped=; trap "test -z \"\$stopped\" || kill -CONT \"\$runtime\" 2>/dev/null || true" EXIT HUP INT TERM; attempt=0; tracee=; while test -z "$tracee"; do children=; IFS= read -r children < "/proc/$runtime/task/$runtime/children" || true; set -- $children; tracee=${1:-}; attempt=$((attempt + 1)); test "$attempt" -lt 10000 || exit 1; kill -0 "$runtime" 2>/dev/null || exit 1; done; kill -STOP "$runtime"; stopped=yes; awk -v uid="$uid" -v gid="$gid" "/^Uid:/{if (\$2 != uid || \$3 != uid || \$4 != uid || \$5 != uid) exit 1} /^Gid:/{if (\$2 != gid || \$3 != gid || \$4 != gid || \$5 != gid) exit 1} /^NoNewPrivs:/{if (\$2 != 1) exit 1; seen=1} END{exit !seen}" "/proc/$tracee/status"; kill -CONT "$runtime"; stopped=; wait "$runtime"; trap - EXIT HUP INT TERM; cat /var/tmp/ginux-process-native.log; printf "GINUX_HOST_IDENTITY: uid=%s gid=%s no-new-privs=1 retained-nonroot\n" "$uid" "$gid"' >> "$log" 2>&1
+grep -Fqx 'GINUX_NATIVE_PARENT: PASS' "$log"
+grep -Fqx 'GINUX_NATIVE_PROCESS: virtual-init=1 host-pid=unexposed ptrace=attached' "$log"
+grep -Fqx 'GINUX_NATIVE_PROCESS: fork=mediated child=ptrace-attached pid-translation=PASS' "$log"
+grep -Fqx 'GINUX_NATIVE_PROCESS: wait=translated child-status=real tasks=0 cleanup=PASS' "$log"
+grep -Fqx 'GATE7_NATIVE_PROCESS: PASS' "$log"
+grep -Eq '^GINUX_HOST_IDENTITY: uid=[1-9][0-9]* gid=[1-9][0-9]* no-new-privs=1 retained-nonroot$' "$log"
+
+rocky_ssh 'rm -f /var/tmp/ginux /var/tmp/gate7.toml /var/tmp/process-native-fixture /var/tmp/ginux-process-native.log'
