+__asm__(".global native_gated_dup\n"
+        "native_gated_dup:\n"
+        "push %r12\n"
+        "mov %rdx, %r12\n"
+        "xor %edx, %edx\n"
+        "xor %r10d, %r10d\n"
+        "xor %r8d, %r8d\n"
+        "mov $56, %eax\n"
+        "syscall\n"
+        "test %rax, %rax\n"
+        "jnz 2f\n"
+        "1: cmpl $0, descriptor_sibling_start(%rip)\n"
+        "je 1b\n"
+        "movq $1, descriptor_sibling_entered(%rip)\n"
+        "mov $32, %eax\n"
+        "mov %r12, %rdi\n"
