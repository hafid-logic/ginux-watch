@@ -0,0 +1,128 @@
+#!/usr/bin/expect -f
+
+if {$argc != 6} {
+    puts stderr "usage: expect-systemd-login.exp <key> <port> <user> <instance-root> <log> <measurements>"
+    exit 64
+}
+
+set key [lindex $argv 0]
+set port [lindex $argv 1]
+set user [lindex $argv 2]
+set instance_root [lindex $argv 3]
+set log [lindex $argv 4]
+set measurements [lindex $argv 5]
+set timeout 50
+set started_ms [clock milliseconds]
+set send_slow {1 .005}
+set audit_override false
+if {[info exists env(GINUX_GATE9_AUDIT)] && $env(GINUX_GATE9_AUDIT) eq "on"} {
+    set audit_override true
+}
+
+log_file -noappend $log
+spawn ssh -tt -i $key -p $port -o BatchMode=yes -o ConnectTimeout=5 -o IdentitiesOnly=yes -o LogLevel=ERROR -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "$user@127.0.0.1" "sudo sh -c '/var/tmp/ginux-host-instance-helper-installed --protocol 1 run-runtime gate9 $audit_override 2>/var/tmp/ginux-gate9-audit.log'"
+
+expect {
+    -re {login:} {}
+    timeout { puts stderr "systemd login prompt timed out"; exit 70 }
+    eof { puts stderr "systemd exited before login prompt"; exit 71 }
+}
+set ready_ms [clock milliseconds]
+set boot_ms [expr {$ready_ms - $started_ms}]
+send_log "GINUX_MEASURE: boot-to-login-ms=$boot_ms\n"
+set measure_file [open $measurements w]
+puts $measure_file "GINUX_MEASURE: boot-to-login-ms=$boot_ms"
+flush $measure_file
+if {[info exists env(GINUX_GATE9_LOGIN_SETTLE)]} {
+    after [expr {$env(GINUX_GATE9_LOGIN_SETTLE) * 1000}]
+}
+send -s -- "root\r"
+
+expect {
+    -re {Password:} {}
+    timeout { puts stderr "systemd password prompt timed out"; exit 72 }
+    eof { puts stderr "login exited before password prompt"; exit 73 }
+}
+send -s -- "ginux\r"
+
+expect {
+    -re {\[root@ginux [^]]+\]# } {}
+    timeout { puts stderr "authenticated shell prompt timed out"; exit 74 }
+    eof { puts stderr "login exited before authenticated shell"; exit 75 }
+}
+send -s -- "/usr/local/sbin/ginux-gate9-check\n"
+
+expect {
+    -re {GINUX_AUTHENTICATED} {}
+    timeout { puts stderr "managed shell checks timed out"; exit 76 }
+    eof { puts stderr "managed shell exited before checks completed"; exit 77 }
+}
+expect {
+    -re {uid=0\(root\).*gid=0\(root\)} {}
+    timeout { puts stderr "virtual root identity check timed out"; exit 80 }
+    eof { puts stderr "managed shell exited before identity check"; exit 81 }
+}
+expect {
+    -re {[0-9]+ \([^)]+\) [A-Z] [0-9]+} {}
+    timeout { puts stderr "virtual proc stat check timed out"; exit 82 }
+    eof { puts stderr "managed shell exited before proc check"; exit 83 }
+}
+expect {
+    -re {GINUX_LOCKDOWN_HOST_PATHS: BLOCKED} {}
+    timeout { puts stderr "host path lockdown check timed out"; exit 86 }
+    eof { puts stderr "managed shell exited during host path check"; exit 87 }
+}
+expect {
+    -re {GINUX_LOCKDOWN_DEVICES: BLOCKED} {}
+    timeout { puts stderr "device lockdown check timed out"; exit 88 }
+    eof { puts stderr "managed shell exited during device check"; exit 89 }
+}
+expect {
+    -re {GINUX_LOCKDOWN_MOUNT: BLOCKED} {}
+    timeout { puts stderr "mount lockdown check timed out"; exit 90 }
+    eof { puts stderr "managed shell exited during mount check"; exit 91 }
+}
+expect {
+    -re {GINUX_LOCKDOWN_NAMESPACE: BLOCKED} {}
+    timeout { puts stderr "namespace lockdown check timed out"; exit 92 }
+    eof { puts stderr "managed shell exited during namespace check"; exit 93 }
+}
+expect {
+    -re {GINUX_NETWORK_DNS_HTTPS: (PASS|SKIPPED)} {}
+    timeout { puts stderr "shared network DNS/HTTPS check timed out"; exit 94 }
+    eof { puts stderr "managed shell exited during network check"; exit 95 }
+}
+expect {
+    -re {GINUX_NETWORK_BIND_ACCEPT_CONFLICT: (PASS|SKIPPED)} {}
+    timeout { puts stderr "shared network bind check timed out"; exit 96 }
+    eof { puts stderr "managed shell exited during bind check"; exit 97 }
+}
+set timeout 1800
+expect {
+    -re {GINUX_DNF_UPDATE: (PASS|SKIPPED|FAILURE-PASS)} {}
+    timeout { puts stderr "dnf update timed out"; exit 98 }
+    eof { puts stderr "managed shell exited during dnf update"; exit 99 }
+}
+expect {
+    -re {GINUX_SHELL_CHECK_DONE} {}
+    timeout { puts stderr "managed shell completion timed out"; exit 84 }
+    eof { puts stderr "managed shell exited before checks completed"; exit 85 }
+}
+expect {
+    -re {\[root@ginux [^]]+\]# } {}
+    timeout { puts stderr "managed shell prompt did not return after checks"; exit 102 }
+    eof { puts stderr "managed shell exited after checks"; exit 103 }
+}
+puts stderr "requesting controlled instance poweroff"
+send -s -- "kill -RTMIN+4 1\n"
+set timeout 120
+expect {
+    eof {}
+    timeout { puts stderr "controlled instance poweroff timed out"; exit 78 }
+}
+set stopped_ms [clock milliseconds]
+set total_ms [expr {$stopped_ms - $started_ms}]
+send_log "GINUX_MEASURE: total-runtime-ms=$total_ms\n"
+puts $measure_file "GINUX_MEASURE: total-runtime-ms=$total_ms"
+close $measure_file
+exit 0
diff --git a/scripts/extract-rocky-instance.sh b/scripts/extract-rocky-instance.sh
new file mode 100755
index 0000000..4a60665
--- /dev/null
+++ b/scripts/extract-rocky-instance.sh
@@ -0,0 +1,68 @@
+#!/bin/sh
+set -eu
+
+raw_image=$1
+rootfs_output=$2
+manifest_output=$3
+mountpoint=/mnt/ginux-rocky-source
+loop_device=
+
+cleanup() {
+    mountpoint -q "$mountpoint" && umount "$mountpoint" || true
+    [ -z "$loop_device" ] || losetup -d "$loop_device" || true
+    rmdir "$mountpoint" 2>/dev/null || true
+}
+trap cleanup EXIT HUP INT TERM
+
+mkdir -p "$mountpoint"
+partition=$(sfdisk -d "$raw_image" |
+    sed -n 's/.*4 : start= *\([0-9][0-9]*\), size= *\([0-9][0-9]*\),.*/\1 \2/p')
+if [ -z "$partition" ]; then
+    printf '%s\n' 'Rocky root partition 4 was not found' >&2
+    exit 1
+fi
+set -- $partition
+root_offset=$(($1 * 512))
+root_size=$(($2 * 512))
+loop_device=$(losetup --find --show --read-only \
+    --offset "$root_offset" --sizelimit "$root_size" "$raw_image")
+mount -t xfs -o ro,nouuid "$loop_device" "$mountpoint"
+mount_options=$(findmnt -no OPTIONS --target "$mountpoint")
+case ",$mount_options," in
+    *,ro,*) ;;
+    *) printf '%s\n' 'Rocky source root was not mounted read-only' >&2; exit 1 ;;
+esac
+if awk -F: 'NR > 2 { name=$1; gsub(/^[ \t]+|[ \t]+$/, "", name); if (name ~ /^(eth|en)/) found=1 } END { exit !found }' \
+    /proc/net/dev; then
+    printf '%s\n' 'extraction helper unexpectedly has an Ethernet interface' >&2
+    exit 1
+fi
+if awk 'NR > 1 && $2 == "00000000" { found=1 } END { exit !found }' /proc/net/route; then
+    printf '%s\n' 'extraction helper unexpectedly has a default IPv4 route' >&2
+    exit 1
+fi
+printf '%s\n' 'EXTRACT: source-mount=read-only helper-network=no-ethernet,no-default-route'
+
+(
+    printf '%s\n' 'GINUX_ROOTFS_MANIFEST_VERSION=1'
+    cd "$mountpoint"
+    find . -xdev -printf 'META\t%y\t%m\t%U\t%G\t%s\t%p\t%l\n' |
+        LC_ALL=C sort
+    find . -xdev -type f -print0 |
+        LC_ALL=C sort -z |
+        xargs -0 -r sha256sum |
+        sed 's/^/SHA256\t/'
+) > "$manifest_output"
+
+tar \
+    --sort=name \
+    --numeric-owner \
+    --xattrs \
+    --acls \
+    --selinux \
+    --sparse \
+    --format=posix \
+    --mtime=@0 \
+    --pax-option=delete=atime,delete=ctime \
+    -cpf "$rootfs_output" \
+    -C "$mountpoint" .
