+            syscall_deny: &[],
+        })
+        .unwrap();
+        let denied = recipe.operation_rule("filesystem.path.write").unwrap();
+        assert_eq!(denied.action, Action::Deny(1));
+        assert_eq!(denied.provenance, Provenance::RecipeDeny);
+        assert_eq!(denied.source_rule, 0);
+        assert_eq!(
+            resolve_recipe(Recipe {
+                allow: &[],
+                deny_all: &[],
+                read: &[],
+                write: &[],
+                execute: &[],
+                connect: &[],
+                listen: &[],
+                process: &[],
+                system: &[],
+                deny: &[],
+                syscall_allow: &[b"device.mmio.direct"],
+                syscall_deny: &[],
+            })
+            .err(),
+            Some(ContractError::UnsupportedPromotion)
+        );
+    }
+
+    #[test]
+    fn audit_budget_is_bounded_and_reports_drops_logarithmically() {
+        let mut budget = AuditBudget::new(2);
+        assert_eq!(budget.admit(), AuditDisposition::Emit);
+        assert_eq!(budget.admit(), AuditDisposition::Emit);
+        assert_eq!(budget.admit(), AuditDisposition::DropAndReport(1));
+        assert_eq!(budget.admit(), AuditDisposition::DropAndReport(2));
+        assert_eq!(budget.admit(), AuditDisposition::Drop);
+        assert_eq!(budget.admit(), AuditDisposition::DropAndReport(4));
+        assert_eq!(budget.emitted(), 2);
+        assert_eq!(budget.dropped(), 4);
+    }
+
+    #[test]
+    fn audit_budget_invariants_hold_for_all_limits_and_loads() {
+        for limit in [0u64, 1, 2, 3, 7, 16, 100] {
+            let mut budget = AuditBudget::new(limit);
+            let mut emitted = 0u64;
+            let mut dropped = 0u64;
+            for n in 1..=200u64 {
+                let disposition = budget.admit();
+                if n <= limit {
+                    assert_eq!(
+                        disposition,
+                        AuditDisposition::Emit,
+                        "limit {limit} admit {n}"
+                    );
+                    emitted += 1;
+                } else {
+                    dropped += 1;
+                    let expected = if dropped.is_power_of_two() {
+                        AuditDisposition::DropAndReport(dropped)
+                    } else {
+                        AuditDisposition::Drop
+                    };
+                    assert_eq!(
+                        disposition, expected,
+                        "limit {limit} admit {n} dropped {dropped}"
+                    );
+                }
+                assert_eq!(budget.emitted(), emitted, "limit {limit} admit {n}");
+                assert_eq!(budget.dropped(), dropped, "limit {limit} admit {n}");
+                assert!(budget.emitted() <= limit, "limit {limit} admit {n}");
+            }
+        }
+    }
+}
