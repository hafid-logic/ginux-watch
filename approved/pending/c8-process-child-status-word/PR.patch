+long native_clone_spawn(void *args, word size);
+__asm__(".global native_clone_spawn\n"
+        "native_clone_spawn:\n"
+        "mov $435, %rax\n"
+        "syscall\n"
+        "test %rax, %rax\n"
+        "jnz 1f\n"
+        "mov $7, %edi\n"
+        "mov $231, %eax\n"
+        "syscall\n"
+        "ud2\n"
+        "1: ret\n");
