+}
+
+fn native_link_tracee_fd_into_instance(
+    host_pid: usize,
+    source_fd: usize,
+    destination_address: usize,
+) -> i64 {
+    let mut source = [0u8; 96];
+    let mut source_len = 0usize;
+    if native_buffer_append(&mut source, &mut source_len, b"/proc/").is_none()
+        || native_buffer_append_u32(
+            &mut source,
+            &mut source_len,
+            u32::try_from(host_pid).unwrap_or(u32::MAX),
+        )
+        .is_none()
+        || native_buffer_append(&mut source, &mut source_len, b"/fd/").is_none()
+        || native_buffer_append_u32(
+            &mut source,
+            &mut source_len,
+            u32::try_from(source_fd).unwrap_or(u32::MAX),
+        )
+        .is_none()
+        || source_len >= source.len()
+    {
+        return -22;
+    }
+    source[source_len] = 0;
+
+    let mut instance_path = [0u8; 384];
+    let Some(instance_path_len) =
+        read_tracee_c_string(host_pid, destination_address, &mut instance_path)
+    else {
+        return -14;
+    };
+    if instance_path_len == 0
+        || instance_path[0] != b'/'
+        || !instance_path[..instance_path_len].starts_with(b"/run/systemd/propagate/")
+    {
+        return -1;
+    }
+
+    let mut destination = [0u8; 512];
+    let mut destination_len = 0usize;
+    if native_buffer_append(&mut destination, &mut destination_len, b"/proc/").is_none()
+        || native_buffer_append_u32(
+            &mut destination,
+            &mut destination_len,
+            u32::try_from(host_pid).unwrap_or(u32::MAX),
+        )
+        .is_none()
+        || native_buffer_append(&mut destination, &mut destination_len, b"/root").is_none()
+        || native_buffer_append(
+            &mut destination,
+            &mut destination_len,
+            &instance_path[..instance_path_len],
+        )
+        .is_none()
+        || destination_len >= destination.len()
+    {
+        return -22;
+    }
+    destination[destination_len] = 0;
+
+    unsafe {
+        syscall5(
+            ginux_core::SYS_LINKAT as usize,
+            AT_FDCWD,
+            source.as_ptr() as usize,
+            AT_FDCWD,
+            destination.as_ptr() as usize,
+            0x400,
+        ) as i64
+    }
+}
+
+fn native_fd_instance_target(host_pid: usize, fd: usize, output: &mut [u8]) -> Option<usize> {
+    let mut root_link = [0u8; 64];
+    let mut root_link_len = 0usize;
+    native_buffer_append(&mut root_link, &mut root_link_len, b"/proc/")?;
+    native_buffer_append_u32(
+        &mut root_link,
+        &mut root_link_len,
+        u32::try_from(host_pid).ok()?,
+    )?;
+    native_buffer_append(&mut root_link, &mut root_link_len, b"/root")?;
+    root_link[root_link_len] = 0;
+
+    let mut fd_link = [0u8; 80];
+    let mut fd_link_len = 0usize;
+    native_buffer_append(&mut fd_link, &mut fd_link_len, b"/proc/")?;
+    native_buffer_append_u32(
+        &mut fd_link,
+        &mut fd_link_len,
+        u32::try_from(host_pid).ok()?,
+    )?;
+    native_buffer_append(&mut fd_link, &mut fd_link_len, b"/fd/")?;
+    native_buffer_append_u32(&mut fd_link, &mut fd_link_len, u32::try_from(fd).ok()?)?;
+    fd_link[fd_link_len] = 0;
+
+    let mut root_target = [0u8; 256];
+    let root_count = unsafe {
+        syscall4(
+            ginux_core::SYS_READLINKAT as usize,
+            AT_FDCWD,
+            root_link.as_ptr() as usize,
+            root_target.as_mut_ptr() as usize,
+            root_target.len(),
+        )
+    };
+    let mut fd_target = [0u8; 512];
+    let fd_count = unsafe {
+        syscall4(
+            ginux_core::SYS_READLINKAT as usize,
+            AT_FDCWD,
+            fd_link.as_ptr() as usize,
+            fd_target.as_mut_ptr() as usize,
+            fd_target.len(),
+        )
+    };
+    if root_count <= 0 || fd_count < root_count {
+        return None;
+    }
+    let root_count = root_count as usize;
+    let fd_count = fd_count as usize;
+    if fd_target[..root_count] != root_target[..root_count] {
+        return None;
+    }
+    if fd_count == root_count {
+        output[0] = b'/';
+        output[1] = 0;
+        return Some(1);
+    }
+    if fd_target[root_count] != b'/' {
+        return None;
+    }
+    let suffix = &fd_target[root_count..fd_count];
+    if suffix.len() >= output.len() {
+        return None;
+    }
+    output[..suffix.len()].copy_from_slice(suffix);
+    output[suffix.len()] = 0;
+    Some(suffix.len())
+}
+
+fn write_uts_field(output: &mut [u8; 65 * 6], field: usize, value: &[u8]) {
+    let start = field * 65;
+    let count = core::cmp::min(value.len(), 64);
+    output[start..start + count].copy_from_slice(&value[..count]);
+}
+
+fn read_tracee_bytes(pid: usize, address: usize, output: &mut [u8]) -> bool {
+    if address == 0 {
+        return false;
+    }
+    let mut offset = 0usize;
+    while offset < output.len() {
+        let mut word = 0u64;
+        if ptrace(
+            PTRACE_PEEKDATA,
+            pid,
+            address.saturating_add(offset),
+            &mut word as *mut _ as usize,
+        ) < 0
+        {
+            return false;
+        }
+        let bytes = word.to_ne_bytes();
+        let count = core::cmp::min(8, output.len() - offset);
+        output[offset..offset + count].copy_from_slice(&bytes[..count]);
+        offset += count;
+    }
+    true
+}
+
+fn native_rewrite_stat_identity(tracee_pid: usize, address: usize, uid: u32, gid: u32) -> bool {
+    // x86-64 struct stat stores st_uid and st_gid at byte offsets 28 and 32.
+    let mut identity = [0u8; 8];
+    identity[..4].copy_from_slice(&uid.to_ne_bytes());
+    identity[4..].copy_from_slice(&gid.to_ne_bytes());
+    write_tracee_bytes(tracee_pid, address.saturating_add(28), &identity)
+}
+
+fn native_virtual_ucred(
+    sender_host_pid: usize,
+    tasks: &[Option<NativeSupervisorTask>; 128],
+    retired: &[NativeRetiredCredential; 128],
+    current: NativeSupervisorTask,
+    processes: &ProcessTable<128>,
+) -> Option<[u8; 12]> {
+    let sender = if current.host_pid == sender_host_pid {
+        Some(current)
+    } else {
+        tasks
+            .iter()
+            .flatten()
+            .find(|candidate| candidate.host_pid == sender_host_pid)
+            .copied()
+    };
+    let mut encoded = [0u8; 12];
+    if let Some(sender) = sender {
+        encoded[..4].copy_from_slice(&sender.virtual_id.pid.to_ne_bytes());
+        if let Ok(view) = processes.view(sender.virtual_id) {
+            encoded[4..8].copy_from_slice(&view.credentials.uid.to_ne_bytes());
+            encoded[8..12].copy_from_slice(&view.credentials.gid.to_ne_bytes());
+        }
+    } else if let Some(sender) = retired
+        .iter()
+        .find(|candidate| candidate.lifetime_pidfd >= 0 && candidate.host_pid == sender_host_pid)
+    {
+        encoded[..4].copy_from_slice(&sender.virtual_pid.to_ne_bytes());
+        encoded[4..8].copy_from_slice(&sender.uid.to_ne_bytes());
+        encoded[8..12].copy_from_slice(&sender.gid.to_ne_bytes());
+    } else {
+        // A queued datagram can outlive its already-reaped sender. Never expose
+        // an unmatched host PID or host credentials through the virtual ABI.
+        encoded[4..8].copy_from_slice(&65534u32.to_ne_bytes());
+        encoded[8..12].copy_from_slice(&65534u32.to_ne_bytes());
+    }
+    Some(encoded)
+}
+
+fn native_rewrite_ucred(
+    tracee_pid: usize,
+    address: usize,
+    tasks: &[Option<NativeSupervisorTask>; 128],
+    retired: &[NativeRetiredCredential; 128],
+    current: NativeSupervisorTask,
+    processes: &ProcessTable<128>,
+) -> bool {
+    let Some(sender_host_pid) = read_tracee_u32(tracee_pid, address).map(|pid| pid as usize) else {
+        return false;
+    };
+    let Some(encoded) = native_virtual_ucred(sender_host_pid, tasks, retired, current, processes)
+    else {
+        return false;
+    };
+    write_tracee_bytes(tracee_pid, address, &encoded)
+}
+
+fn native_rewrite_recvmsg_credentials(
+    tracee_pid: usize,
+    message_address: usize,
+    tasks: &[Option<NativeSupervisorTask>; 128],
+    retired: &[NativeRetiredCredential; 128],
+    current: NativeSupervisorTask,
+    processes: &ProcessTable<128>,
+) -> bool {
+    let mut message = [0u8; 56];
+    if !read_tracee_bytes(tracee_pid, message_address, &mut message) {
+        return false;
+    }
+    let control_address = u64::from_ne_bytes(message[32..40].try_into().unwrap_or([0; 8])) as usize;
+    let control_length = u64::from_ne_bytes(message[40..48].try_into().unwrap_or([0; 8])) as usize;
+    if control_address == 0 || control_length == 0 {
+        return true;
+    }
+    let bounded_length = core::cmp::min(control_length, 1024);
+    let mut control = [0u8; 1024];
+    if !read_tracee_bytes(tracee_pid, control_address, &mut control[..bounded_length]) {
+        return false;
+    }
+    let mut offset = 0usize;
+    while offset.saturating_add(16) <= bounded_length {
+        let length =
+            u64::from_ne_bytes(control[offset..offset + 8].try_into().unwrap_or([0; 8])) as usize;
+        if length < 16 || offset.saturating_add(length) > bounded_length {
+            break;
+        }
+        let level = u32::from_ne_bytes(
+            control[offset + 8..offset + 12]
+                .try_into()
+                .unwrap_or([0; 4]),
+        );
+        let kind = u32::from_ne_bytes(
+            control[offset + 12..offset + 16]
+                .try_into()
+                .unwrap_or([0; 4]),
+        );
+        if level == 1 && kind == 2 && length >= 28 {
+            let credential_address = control_address.saturating_add(offset).saturating_add(16);
+            if !native_rewrite_ucred(
+                tracee_pid,
+                credential_address,
+                tasks,
+                retired,
+                current,
+                processes,
+            ) {
+                return false;
+            }
+        }
+        offset = offset.saturating_add((length + 7) & !7);
+    }
+    true
+}
+
+fn write_tracee_bytes(pid: usize, address: usize, input: &[u8]) -> bool {
+    if address == 0 {
+        return false;
+    }
+    let mut offset = 0usize;
+    while offset < input.len() {
+        let count = core::cmp::min(8, input.len() - offset);
+        let mut bytes = if count == 8 {
+            [0u8; 8]
+        } else {
+            let mut existing = 0u64;
+            if ptrace(
+                PTRACE_PEEKDATA,
+                pid,
+                address.saturating_add(offset),
+                &mut existing as *mut _ as usize,
+            ) < 0
+            {
+                return false;
+            }
+            existing.to_ne_bytes()
+        };
+        bytes[..count].copy_from_slice(&input[offset..offset + count]);
+        if ptrace(
+            PTRACE_POKEDATA,
+            pid,
+            address.saturating_add(offset),
+            u64::from_ne_bytes(bytes) as usize,
+        ) < 0
+        {
+            return false;
+        }
+        offset += count;
+    }
+    true
+}
+
+fn read_tracee_u64_pair(pid: usize, address: usize) -> Option<[u64; 2]> {
+    if address == 0 {
+        return None;
+    }
+    let mut values = [0u64; 2];
+    for (index, value) in values.iter_mut().enumerate() {
+        if ptrace(
+            PTRACE_PEEKDATA,
+            pid,
+            address.saturating_add(index * 8),
+            value as *mut _ as usize,
+        ) < 0
+        {
+            return None;
+        }
+    }
+    Some(values)
+}
+
+fn tracee_decimal_fd_path(pid: usize, address: usize) -> bool {
+    const PREFIX: &[u8] = b"/proc/self/fd/";
+    if address == 0 {
+        return false;
+    }
+    let mut bytes = [0u8; 32];
+    let mut offset = 0usize;
+    while offset < bytes.len() {
+        let mut word = 0u64;
+        if ptrace(
+            PTRACE_PEEKDATA,
+            pid,
+            address.saturating_add(offset),
+            &mut word as *mut _ as usize,
+        ) < 0
+        {
+            return false;
+        }
+        for byte in word.to_ne_bytes() {
+            if byte == 0 {
+                return offset > PREFIX.len()
+                    && bytes[..PREFIX.len()] == *PREFIX
+                    && bytes[PREFIX.len()..offset].iter().all(u8::is_ascii_digit);
+            }
+            bytes[offset] = byte;
+            offset += 1;
+            if offset >= bytes.len() {
+                return false;
+            }
+        }
+    }
+    false
+}
+
+fn tracee_proc_self_fd_number(pid: usize, address: usize) -> Option<usize> {
+    const PREFIX: &[u8] = b"/proc/self/fd/";
+    if address == 0 {
+        return None;
+    }
+    let mut bytes = [0u8; 32];
+    let mut offset = 0usize;
+    while offset < bytes.len() {
+        let mut word = 0u64;
+        if ptrace(
+            PTRACE_PEEKDATA,
+            pid,
+            address.saturating_add(offset),
+            &mut word as *mut _ as usize,
+        ) < 0
+        {
+            return None;
+        }
+        for byte in word.to_ne_bytes() {
+            if byte == 0 {
+                if offset <= PREFIX.len()
+                    || bytes[..PREFIX.len()] != *PREFIX
+                    || !bytes[PREFIX.len()..offset].iter().all(u8::is_ascii_digit)
+                {
+                    return None;
+                }
+                let mut fd = 0usize;
+                for digit in &bytes[PREFIX.len()..offset] {
+                    fd = fd
+                        .checked_mul(10)?
+                        .checked_add(usize::from(*digit - b'0'))?;
+                }
+                return Some(fd);
+            }
+            if offset >= bytes.len() {
+                return None;
+            }
+            bytes[offset] = byte;
+            offset += 1;
+        }
+    }
+    None
+}
+
+#[allow(dead_code)]
+fn tracee_decimal_fdinfo_path(pid: usize, address: usize) -> Option<usize> {
+    const PREFIX: &[u8] = b"/proc/self/fdinfo/";
+    if address == 0 {
+        return None;
+    }
+    let mut bytes = [0u8; 48];
+    let mut offset = 0usize;
+    while offset < bytes.len() {
+        let mut word = 0u64;
+        if ptrace(
+            PTRACE_PEEKDATA,
+            pid,
+            address.saturating_add(offset),
+            &mut word as *mut _ as usize,
+        ) < 0
+        {
+            return None;
+        }
+        for byte in word.to_ne_bytes() {
+            if byte == 0 {
+                if offset <= PREFIX.len()
+                    || bytes[..PREFIX.len()] != *PREFIX
+                    || !bytes[PREFIX.len()..offset].iter().all(u8::is_ascii_digit)
+                {
+                    return None;
+                }
+                let mut fd = 0usize;
+                for digit in &bytes[PREFIX.len()..offset] {
+                    fd = fd
+                        .checked_mul(10)?
+                        .checked_add(usize::from(*digit - b'0'))?;
+                }
+                return Some(fd);
+            }
+            if offset >= bytes.len() {
+                return None;
+            }
+            bytes[offset] = byte;
+            offset += 1;
+        }
+    }
+    None
+}
+
+fn write_tracee_string_to(fd: usize, pid: usize, address: usize) {
+    if address == 0 {
+        write_all_to(fd, b"(null)");
+        return;
+    }
+    let mut offset = 0usize;
+    while offset < 256 {
+        let mut word = 0u64;
+        if ptrace(
+            PTRACE_PEEKDATA,
+            pid,
+            address.saturating_add(offset),
+            &mut word as *mut _ as usize,
+        ) < 0
+        {
+            write_all_to(fd, b"(unreadable)");
+            return;
+        }
+        for byte in word.to_ne_bytes() {
+            if byte == 0 {
+                return;
+            }
+            if byte.is_ascii_graphic() || byte == b' ' {
+                let printable = [byte];
+                write_all_to(fd, &printable);
+            } else {
+                write_all_to(fd, b"?");
+            }
+            offset += 1;
+            if offset >= 256 {
+                return;
+            }
+        }
+    }
+}
+
+fn line_to(fd: usize, message: &[u8]) {
+    write_all_to(fd, message);
+    write_all_to(fd, b"\n");
+}
+
+fn write_all_to(fd: usize, bytes: &[u8]) {
+    let mut offset = 0;
+    while offset < bytes.len() {
+        let result = unsafe {
+            syscall3(
+                SYS_WRITE_HOST,
+                fd,
+                bytes.as_ptr().add(offset) as usize,
+                bytes.len() - offset,
+            )
+        };
+        if result <= 0 {
+            return;
+        }
+        offset += result as usize;
+    }
+}
+
+fn write_u64_to(fd: usize, mut value: u64) {
+    let mut buffer = [0u8; 20];
+    let mut index = buffer.len();
+    if value == 0 {
+        write_all_to(fd, b"0");
+        return;
+    }
+    while value != 0 {
+        index -= 1;
+        buffer[index] = b'0' + (value % 10) as u8;
+        value /= 10;
+    }
+    write_all_to(fd, &buffer[index..]);
+}
+
+fn write_i64_to(fd: usize, value: i64) {
+    if value < 0 {
+        write_all_to(fd, b"-");
+        write_u64_to(fd, value.unsigned_abs());
+    } else {
+        write_u64_to(fd, value as u64);
+    }
+}
+fn fail(reason: &[u8]) -> ! {
+    write_all(b"GATE1: FAIL: ");
+    line(reason);
+    exit_process(1)
+}
diff --git a/crates/ginux-init/src/native_clone.rs b/crates/ginux-init/src/native_clone.rs
new file mode 100644
index 0000000..e236cae
--- /dev/null
+++ b/crates/ginux-init/src/native_clone.rs
@@ -0,0 +1,196 @@
+//! Native clone3 argument ownership. The host reads only a private read-only
+//! anonymous snapshot, never a validated-then-reused caller structure.
+use crate::supervisor::{poke_tracee_bytes, syscall6, UserRegs, EFAULT, EINVAL};
+
+const BASE: u64 = 0x6000_0000_0000;
+const PAGE: u64 = 4096;
+const END: u64 = BASE + 128 * PAGE;
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub enum Phase {
+    Idle,
+    Map,
+    Call,
+    Child,
+    Unmap,
+}
+
+#[derive(Clone, Copy)]
+pub struct Pending {
+    pub phase: Phase,
+    args: [u8; 88],
+    original: [u64; 6],
+    rip: u64,
+    address: u64,
+    pub result: i64,
+    pub sigchld: bool,
+}
+
+impl Pending {
+    pub const fn empty() -> Self {
+        Self {
+            phase: Phase::Idle,
+            args: [0; 88],
+            original: [0; 6],
+            rip: 0,
+            address: 0,
+            result: 0,
+            sigchld: false,
+        }
+    }
+
+    pub fn snapshot(pid: usize, slot: usize, regs: &UserRegs) -> Result<Self, i64> {
+        // Linux 6.12 copy_struct_from_user: min version 64, maximum page,
+        // absent fields zero, unknown extension bytes must all be zero.
+        let size = regs.rsi as usize;
+        if size > PAGE as usize {
+            return Err(-7);
+        }
+        if size < 64 {
+            return Err(-EINVAL);
+        }
+        let mut bytes = [0u8; PAGE as usize];
+        let local = [bytes.as_mut_ptr() as usize, size];
+        let remote = [regs.rdi as usize, size];
+        let read = unsafe {
+            syscall6(
+                310,
+                pid,
+                local.as_ptr() as usize,
+                1,
+                remote.as_ptr() as usize,
+                1,
+                0,
+            )
+        };
+        if read < 0 {
+            return Err(read as i64);
+        }
+        if read as usize != size {
+            return Err(-EFAULT);
+        }
+        if bytes[88..size.max(88)].iter().any(|byte| *byte != 0) {
+            return Err(-7);
+        }
+        let mut args = [0u8; 88];
+        args.copy_from_slice(&bytes[..88]);
+        if u64::from_ne_bytes(args[..8].try_into().unwrap()) & 0x2_0000_0000 != 0 && size < 88 {
+            return Err(-EINVAL);
+        }
+        Ok(Self {
+            phase: Phase::Map,
+            args,
+            original: arguments(regs),
+            rip: regs.rip,
+            address: BASE + slot as u64 * PAGE,
+            result: 0,
+            sigchld: false,
+        })
+    }
+
+    pub fn flags(&self) -> u64 {
+        u64::from_ne_bytes(self.args[..8].try_into().unwrap())
+    }
+    pub fn exit_signal(&self) -> u64 {
+        u64::from_ne_bytes(self.args[32..40].try_into().unwrap())
+    }
+    pub fn cgroup(&self) -> u64 {
+        u64::from_ne_bytes(self.args[80..88].try_into().unwrap())
+    }
+    pub fn clear_cgroup(&mut self) {
+        let flags = self.flags() & !0x2_0000_0000;
+        self.args[..8].copy_from_slice(&flags.to_ne_bytes());
+    }
+    pub fn map(&self, regs: &mut UserRegs) {
+        // Never replace a pre-existing workload mapping. Only this trusted
+        // path can map into the reserved range; the mapping is born read-only.
+        set_call(regs, 9, [self.address, PAGE, 1, 0x100022, u64::MAX, 0]);
+    }
+    pub fn mapped(&mut self, pid: usize, regs: &mut UserRegs) -> Result<(), i64> {
+        if regs.rax != self.address {
+            return Err(regs.rax as i64);
+        }
+        // ptrace intentionally writes this supervisor-owned, read-only page.
+        // No process_vm_writev fallback or caller-memory write is involved.
+        poke_tracee_bytes(pid, self.address as usize, &self.args)?;
+        self.phase = Phase::Call;
+        self.replay(
+            regs,
+            435,
+            [
+                self.address,
+                88,
+                self.original[2],
+                self.original[3],
+                self.original[4],
+                self.original[5],
+            ],
+        );
+        Ok(())
+    }
+    pub fn unmap(&mut self, regs: &mut UserRegs, result: i64) {
+        self.result = result;
+        self.phase = Phase::Unmap;
+        self.replay(regs, 11, [self.address, PAGE, 0, 0, 0, 0]);
+    }
+    pub fn child(&self) -> Self {
+        Self {
+            phase: Phase::Child,
+            sigchld: false,
+            ..*self
+        }
+    }
+    pub fn matches_entry(&self, regs: &UserRegs) -> bool {
+        regs.rip == self.rip
+            && match self.phase {
+                Phase::Call => regs.orig_rax == 435 && regs.rdi == self.address && regs.rsi == 88,
+                Phase::Unmap => regs.orig_rax == 11 && regs.rdi == self.address && regs.rsi == PAGE,
+                _ => false,
+            }
+    }
+    fn replay(&self, regs: &mut UserRegs, syscall: u64, args: [u64; 6]) {
+        set_call(regs, syscall, args);
+        regs.rax = syscall;
+        regs.rip = self.rip - 2;
+    }
+    /// Returns whether the caller's clone3 is reissued instead of returning.
+    pub fn restore(&mut self, regs: &mut UserRegs) -> bool {
+        set_call(regs, 435, self.original);
+        self.phase = Phase::Idle;
+        // A signal made the kernel abandon the replay (ERESTARTNOINTR, the
+        // only restart code clone3 returns). It was delivered before the
+        // cleanup stage ran, so the kernel will not restart the call itself:
+        // reissue the caller's clone3, which takes a fresh snapshot.
+        if self.result == -513 {
+            regs.rip = self.rip - 2;
+            regs.rax = 435;
+            return true;
+        }
+        regs.rip = self.rip;
+        regs.rax = self.result as u64;
+        false
+    }
+}
+
+fn arguments(regs: &UserRegs) -> [u64; 6] {
+    [regs.rdi, regs.rsi, regs.rdx, regs.r10, regs.r8, regs.r9]
+}
+fn set_call(regs: &mut UserRegs, syscall: u64, args: [u64; 6]) {
+    regs.orig_rax = syscall;
+    [regs.rdi, regs.rsi, regs.rdx, regs.r10, regs.r8, regs.r9] = args;
+}
+fn overlaps(address: u64, length: u64) -> bool {
+    address < END && address.saturating_add(length.max(1)) > BASE
+}
+
+/// These calls could overwrite, discard, change permissions, move, or alias
+/// the immutable snapshot. The native dispatcher applies this even before a
+/// particular slot is allocated. Internal map/unmap stages never use this lane.
+pub fn changes_snapshot(syscall: u64, regs: &UserRegs) -> bool {
+    match syscall {
+        9 => overlaps(regs.rdi, regs.rsi),
+        10 | 11 | 28 | 329 => overlaps(regs.rdi, regs.rsi),
+        25 => overlaps(regs.rdi, regs.rsi) || (regs.r10 & 2 != 0 && overlaps(regs.r8, regs.rdx)),
+        _ => false,
+    }
+}
diff --git a/crates/ginux-init/src/native_network.rs b/crates/ginux-init/src/native_network.rs
new file mode 100644
index 0000000..148902b
--- /dev/null
+++ b/crates/ginux-init/src/native_network.rs
@@ -0,0 +1,940 @@
+//! Immutable native network arguments.
+//!
+//! The supervisor copies every userspace object consumed by connect, bind,
+//! sendto, sendmsg, and sendmmsg into a private read-only tracee mapping, then
+//! makes the host syscall consume only that snapshot. sendmmsg is replayed as
+//! bounded sendmsg calls because Linux writes `msg_len` into the caller's
+//! array.
+
+use crate::supervisor::{poke_tracee_bytes, syscall6, UserRegs, EFAULT, EINVAL, EPERM};
+
+const BASE: u64 = 0x6100_0000_0000;
+const SNAPSHOT_SIZE: usize = 16 * 1024;
+const STRIDE: u64 = SNAPSHOT_SIZE as u64;
+const END: u64 = BASE + 128 * STRIDE;
+const MAX_MESSAGES: usize = 16;
+const MAX_IOV: usize = 16;
+const MAX_CONTROL: usize = 4096;
+const MAX_SOCKADDR: usize = 128;
+pub const MAX_RECEIVED_RIGHTS: usize = 253;
+
+const SYS_SENDTO: u64 = 44;
+const SYS_SENDMSG: u64 = 46;
+const SYS_SENDMMSG: u64 = 307;
+const SYS_CONNECT: u64 = 42;
+const SYS_BIND: u64 = 49;
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub enum Phase {
+    Idle,
+    Map,
+    Call,
+    Unmap,
+}
+
+#[derive(Clone, Copy)]
+pub struct Destination {
+    pub port: u16,
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum AddressKind {
+    Internet,
+    UnixPath,
+}
+
+#[derive(Clone, Copy)]
+pub struct Pending {
+    pub phase: Phase,
+    original_syscall: u64,
+    original: [u64; 6],
+    replay: [[u64; 6]; MAX_MESSAGES],
+    message_output: [u64; MAX_MESSAGES],
+    destinations: [Option<Destination>; MAX_MESSAGES],
+    message_count: usize,
+    current: usize,
+    rip: u64,
+    address: u64,
+    pub result: i64,
+    pub netlink_sequence: u32,
+    sockaddr_offset: usize,
+    sockaddr_word: u64,
+}
+
+pub struct Buffer {
+    bytes: [u8; SNAPSHOT_SIZE],
+    used: usize,
+}
+
+#[derive(Clone, Copy)]
+pub struct ReceivedRights {
+    pub fds: [i32; MAX_RECEIVED_RIGHTS],
+    pub count: usize,
+}
+
+impl ReceivedRights {
+    const fn empty() -> Self {
+        Self {
+            fds: [-1; MAX_RECEIVED_RIGHTS],
+            count: 0,
+        }
+    }
+
+    fn push(&mut self, fd: i32) -> Result<(), i64> {
+        if fd < 0 || self.count == self.fds.len() {
+            return Err(-7);
+        }
+        self.fds[self.count] = fd;
+        self.count += 1;
+        Ok(())
+    }
+}
+
+impl Buffer {
+    pub const fn empty() -> Self {
+        Self {
+            bytes: [0; SNAPSHOT_SIZE],
+            used: 0,
+        }
+    }
+
+    fn reset(&mut self) {
+        self.bytes.fill(0);
+        self.used = 0;
+    }
+
+    fn reserve(&mut self, size: usize, alignment: usize) -> Result<usize, i64> {
+        let aligned = self
+            .used
+            .checked_add(alignment - 1)
+            .map(|value| value & !(alignment - 1))
+            .ok_or(-7)?;
+        let end = aligned.checked_add(size).ok_or(-7)?;
+        if end > self.bytes.len() {
+            return Err(-7);
+        }
+        self.used = end;
+        Ok(aligned)
+    }
+
+    fn copy_from_tracee(
+        &mut self,
+        pid: usize,
+        address: u64,
+        size: usize,
+        alignment: usize,
+    ) -> Result<usize, i64> {
+        if size == 0 {
+            return Ok(0);
+        }
+        if address == 0 {
+            return Err(-EFAULT);
+        }
+        let offset = self.reserve(size, alignment)?;
+        let local = [self.bytes[offset..].as_mut_ptr() as usize, size];
+        let remote = [address as usize, size];
+        let read = unsafe {
+            syscall6(
+                310,
+                pid,
+                local.as_ptr() as usize,
+                1,
+                remote.as_ptr() as usize,
+                1,
+                0,
+            )
+        };
+        if read < 0 {
+            return Err(read as i64);
+        }
+        if read as usize != size {
+            return Err(-EFAULT);
+        }
+        Ok(offset)
+    }
+
+    fn read_u32(&self, offset: usize) -> u32 {
+        u32::from_ne_bytes(self.bytes[offset..offset + 4].try_into().unwrap())
+    }
+
+    fn read_u64(&self, offset: usize) -> u64 {
+        u64::from_ne_bytes(self.bytes[offset..offset + 8].try_into().unwrap())
+    }
+
+    fn write_u64(&mut self, offset: usize, value: u64) {
+        self.bytes[offset..offset + 8].copy_from_slice(&value.to_ne_bytes());
+    }
+}
+
+impl Pending {
+    pub const fn empty() -> Self {
+        Self {
+            phase: Phase::Idle,
+            original_syscall: 0,
+            original: [0; 6],
+            replay: [[0; 6]; MAX_MESSAGES],
+            message_output: [0; MAX_MESSAGES],
+            destinations: [None; MAX_MESSAGES],
+            message_count: 0,
+            current: 0,
+            rip: 0,
+            address: 0,
+            result: 0,
+            netlink_sequence: 0,
+            sockaddr_offset: 0,
+            sockaddr_word: 0,
+        }
+    }
+
+    pub fn snapshot_sockaddr(
+        pid: usize,
+        slot: usize,
+        regs: &UserRegs,
+        buffer: &mut Buffer,
+    ) -> Result<Self, i64> {
+        if !matches!(regs.orig_rax, SYS_CONNECT | SYS_BIND) {
+            return Err(-EINVAL);
+        }
+        buffer.reset();
+        let mut pending = Self {
+            phase: Phase::Map,
+            original_syscall: regs.orig_rax,
+            original: arguments(regs),
+            rip: regs.rip,
+            address: BASE + slot as u64 * STRIDE,
+            ..Self::empty()
+        };
+        let (offset, destination) =
+            snapshot_destination(pid, regs.rsi, regs.rdx, buffer, AddressKind::Internet)?;
+        let destination = destination.ok_or(-EINVAL)?;
+        pending.message_count = 1;
+        pending.destinations[0] = Some(destination);
+        pending.sockaddr_offset = offset;
+        pending.sockaddr_word = buffer.read_u64(offset);
+        pending.replay[0] = [regs.rdi, pending.address + offset as u64, regs.rdx, 0, 0, 0];
+        Ok(pending)
+    }
+
+    pub fn sockaddr_word(&self) -> u64 {
+        self.sockaddr_word
+    }
+
+    pub fn set_sockaddr_word(&mut self, buffer: &mut Buffer, word: u64) {
+        buffer.write_u64(self.sockaddr_offset, word);
+        self.sockaddr_word = word;
+    }
+
+    pub fn snapshot(
+        pid: usize,
+        slot: usize,
+        regs: &UserRegs,
+        buffer: &mut Buffer,
+    ) -> Result<Self, i64> {
+        Self::snapshot_for(pid, slot, regs, buffer, AddressKind::Internet)
+    }
+
+    pub fn snapshot_unix(
+        pid: usize,
+        slot: usize,
+        regs: &UserRegs,
+        buffer: &mut Buffer,
+    ) -> Result<Self, i64> {
+        Self::snapshot_for(pid, slot, regs, buffer, AddressKind::UnixPath)
+    }
+
+    fn snapshot_for(
+        pid: usize,
+        slot: usize,
+        regs: &UserRegs,
+        buffer: &mut Buffer,
+        address_kind: AddressKind,
+    ) -> Result<Self, i64> {
+        buffer.reset();
+        let mut pending = Self {
+            phase: Phase::Map,
+            original_syscall: regs.orig_rax,
+            original: arguments(regs),
+            rip: regs.rip,
+            address: BASE + slot as u64 * STRIDE,
+            ..Self::empty()
+        };
+        match regs.orig_rax {
+            SYS_SENDTO => pending.snapshot_sendto(pid, regs, buffer, address_kind)?,
+            SYS_SENDMSG => pending.snapshot_sendmsg(pid, regs, buffer, address_kind)?,
+            SYS_SENDMMSG => pending.snapshot_sendmmsg(pid, regs, buffer, address_kind)?,
+            _ => return Err(-EINVAL),
+        }
+        Ok(pending)
+    }
+
+    /// Snapshot the one host-routed netlink operation currently required by
+    /// systemd: adding the IPv4 loopback address. The immutable replay keeps
+    /// mutable tracee memory out of the host call, and the validator rejects
+    /// every other netlink family, message, interface, and address shape.
+    pub fn snapshot_loopback_netlink(
+        pid: usize,
+        slot: usize,
+        regs: &UserRegs,
+        buffer: &mut Buffer,
+    ) -> Result<Self, i64> {
+        buffer.reset();
+        let mut pending = Self {
+            phase: Phase::Map,
+            original_syscall: regs.orig_rax,
+            original: arguments(regs),
+            rip: regs.rip,
+            address: BASE + slot as u64 * STRIDE,
+            ..Self::empty()
+        };
+        pending.message_count = 1;
+        match regs.orig_rax {
+            SYS_SENDTO => {
+                let length = regs.rdx as usize;
+                if !(24..=256).contains(&length) {
+                    return Err(-7);
+                }
+                let payload = buffer.copy_from_tracee(pid, regs.rsi, length, 8)?;
+                pending.netlink_sequence =
+                    validate_loopback_netlink(&buffer.bytes[payload..payload + length])?;
+                let name = snapshot_netlink_name(pid, regs.r8, regs.r9, buffer)?;
+                pending.replay[0] = [
+                    regs.rdi,
+                    pending.address + payload as u64,
+                    regs.rdx,
+                    regs.r10,
+                    offset_address(pending.address, name, regs.r9 as usize),
+                    regs.r9,
+                ];
+            }
+            SYS_SENDMSG => {
+                let (header, sequence) =
+                    snapshot_loopback_netlink_msghdr(pid, regs.rsi, buffer, pending.address)?;
+                pending.netlink_sequence = sequence;
+                pending.replay[0] = [regs.rdi, pending.address + header as u64, regs.rdx, 0, 0, 0];
+            }
+            _ => return Err(-38),
+        }
+        Ok(pending)
+    }
+
+    pub fn destinations(&self) -> &[Option<Destination>] {
+        &self.destinations[..self.message_count]
+    }
+
+    fn snapshot_sendto(
+        &mut self,
+        pid: usize,
+        regs: &UserRegs,
+        buffer: &mut Buffer,
+        address_kind: AddressKind,
+    ) -> Result<(), i64> {
+        let payload = buffer.copy_from_tracee(pid, regs.rsi, regs.rdx as usize, 8)?;
+        let (name, destination) =
+            snapshot_destination(pid, regs.r8, regs.r9, buffer, address_kind)?;
+        self.message_count = 1;
+        self.destinations[0] = destination;
+        self.replay[0] = [
+            regs.rdi,
+            offset_address(self.address, payload, regs.rdx as usize),
+            regs.rdx,
+            regs.r10,
+            offset_address(self.address, name, regs.r9 as usize),
+            regs.r9,
+        ];
+        Ok(())
+    }
+
+    fn snapshot_sendmsg(
+        &mut self,
+        pid: usize,
+        regs: &UserRegs,
+        buffer: &mut Buffer,
+        address_kind: AddressKind,
+    ) -> Result<(), i64> {
+        let (header, destination) =
+            snapshot_msghdr(pid, regs.rsi, buffer, self.address, address_kind)?;
+        self.message_count = 1;
+        self.destinations[0] = destination;
+        self.replay[0] = [regs.rdi, self.address + header as u64, regs.rdx, 0, 0, 0];
+        Ok(())
+    }
+
+    fn snapshot_sendmmsg(
+        &mut self,
+        pid: usize,
+        regs: &UserRegs,
+        buffer: &mut Buffer,
+        address_kind: AddressKind,
+    ) -> Result<(), i64> {
+        let count = regs.rdx as usize;
+        if count == 0 || count > MAX_MESSAGES || regs.rsi == 0 {
+            return Err(-EINVAL);
+        }
+        self.message_count = count;
+        for index in 0..count {
+            let original = regs.rsi.checked_add((index * 64) as u64).ok_or(-EFAULT)?;
+            let (header, destination) =
+                snapshot_msghdr(pid, original, buffer, self.address, address_kind)?;
+            self.destinations[index] = destination;
+            self.replay[index] = [regs.rdi, self.address + header as u64, regs.r10, 0, 0, 0];
+            self.message_output[index] = original + 56;
+        }
+        Ok(())
+    }
+
+    pub fn map(&self, regs: &mut UserRegs) {
+        set_call(
+            regs,
+            9,
+            [self.address, SNAPSHOT_SIZE as u64, 1, 0x100022, u64::MAX, 0],
+        );
+    }
+
+    pub fn mapped(&mut self, pid: usize, buffer: &Buffer, regs: &mut UserRegs) -> Result<(), i64> {
+        if regs.rax != self.address {
+            return Err(regs.rax as i64);
+        }
+        poke_tracee_bytes(pid, self.address as usize, &buffer.bytes[..buffer.used])?;
+        self.phase = Phase::Call;
+        self.replay_current(regs);
+        Ok(())
+    }
+
+    pub fn completed_call(&mut self, pid: usize, regs: &mut UserRegs) -> Result<bool, i64> {
+        let result = regs.rax as i64;
+        if self.original_syscall == SYS_SENDMMSG && result >= 0 {
+            let length = u32::try_from(result).map_err(|_| -EINVAL)?;
+            poke_tracee_bytes(
+                pid,
+                self.message_output[self.current] as usize,
+                &length.to_ne_bytes(),
+            )?;
+            self.current += 1;
+            if self.current < self.message_count {
+                self.replay_current(regs);
+                return Ok(false);
+            }
+            self.unmap(regs, self.message_count as i64);
+            return Ok(true);
+        }
+        let final_result = if self.original_syscall == SYS_SENDMMSG && self.current > 0 {
+            self.current as i64
+        } else {
+            result
+        };
+        self.unmap(regs, final_result);
+        Ok(true)
+    }
+
+    fn unmap(&mut self, regs: &mut UserRegs, result: i64) {
+        self.result = result;
+        self.phase = Phase::Unmap;
+        self.replay(regs, 11, [self.address, SNAPSHOT_SIZE as u64, 0, 0, 0, 0]);
+    }
+
+    pub fn matches_entry(&self, regs: &UserRegs) -> bool {
+        regs.rip == self.rip
+            && match self.phase {
+                Phase::Call => {
+                    let syscall = if self.original_syscall == SYS_SENDMMSG {
+                        SYS_SENDMSG
+                    } else {
+                        self.original_syscall
+                    };
+                    regs.orig_rax == syscall && regs.rsi == self.replay[self.current][1]
+                }
+                Phase::Unmap => {
+                    regs.orig_rax == 11
+                        && regs.rdi == self.address
+                        && regs.rsi == SNAPSHOT_SIZE as u64
+                }
+                _ => false,
+            }
+    }
+
+    pub fn restore(&mut self, regs: &mut UserRegs) -> bool {
+        set_call(regs, self.original_syscall, self.original);
+        self.phase = Phase::Idle;
+        if matches!(self.result, -512 | -513 | -514 | -516) {
+            regs.rip = self.rip - 2;
+            regs.rax = self.original_syscall;
+            return true;
+        }
+        regs.rip = self.rip;
+        regs.rax = self.result as u64;
+        false
+    }
+
+    fn replay_current(&self, regs: &mut UserRegs) {
+        let syscall = if self.original_syscall == SYS_SENDMMSG {
+            SYS_SENDMSG
+        } else {
+            self.original_syscall
+        };
+        self.replay(regs, syscall, self.replay[self.current]);
+    }
+
+    fn replay(&self, regs: &mut UserRegs, syscall: u64, args: [u64; 6]) {
+        set_call(regs, syscall, args);
+        regs.rax = syscall;
+        regs.rip = self.rip - 2;
+    }
+}
+
+fn snapshot_msghdr(
+    pid: usize,
+    address: u64,
+    buffer: &mut Buffer,
+    base: u64,
+    address_kind: AddressKind,
+) -> Result<(usize, Option<Destination>), i64> {
+    let source = buffer.copy_from_tracee(pid, address, 56, 8)?;
+    let name_pointer = buffer.read_u64(source);
+    let name_length = u64::from(buffer.read_u32(source + 8));
+    let iov_pointer = buffer.read_u64(source + 16);
+    let iov_count = buffer.read_u64(source + 24) as usize;
+    let control_pointer = buffer.read_u64(source + 32);
+    let control_length = buffer.read_u64(source + 40) as usize;
+    if iov_count > MAX_IOV || control_length > MAX_CONTROL {
+        return Err(-7);
+    }
+    let (name, destination) =
+        snapshot_destination(pid, name_pointer, name_length, buffer, address_kind)?;
+    let iov_source = if iov_count == 0 {
+        0
+    } else {
+        buffer.copy_from_tracee(pid, iov_pointer, iov_count * 16, 8)?
+    };
+    let iov_copy = if iov_count == 0 {
+        0
+    } else {
+        buffer.reserve(iov_count * 16, 8)?
+    };
+    for index in 0..iov_count {
+        let pointer = buffer.read_u64(iov_source + index * 16);
+        let length = buffer.read_u64(iov_source + index * 16 + 8) as usize;
+        let payload = buffer.copy_from_tracee(pid, pointer, length, 8)?;
+        buffer.write_u64(iov_copy + index * 16, offset_address(base, payload, length));
+        buffer.write_u64(iov_copy + index * 16 + 8, length as u64);
+    }
+    let control = if control_length == 0 {
+        0
+    } else {
+        buffer.copy_from_tracee(pid, control_pointer, control_length, 8)?
+    };
+    if control_length != 0
+        && ancillary_contains_scm_rights(&buffer.bytes[control..control + control_length])?
+    {
+        return Err(-1);
+    }
+    let header = buffer.reserve(56, 8)?;
+    let mut source_header = [0u8; 56];
+    source_header.copy_from_slice(&buffer.bytes[source..source + 56]);
+    buffer.bytes[header..header + 56].copy_from_slice(&source_header);
+    buffer.write_u64(header, offset_address(base, name, name_length as usize));
+    buffer.write_u64(header + 16, offset_address(base, iov_copy, iov_count * 16));
+    buffer.write_u64(header + 32, offset_address(base, control, control_length));
+    Ok((header, destination))
+}
+
+pub fn sendmsg_has_scm_rights(pid: usize, address: u64) -> Result<bool, i64> {
+    let mut buffer = Buffer::empty();
+    let header = buffer.copy_from_tracee(pid, address, 56, 8)?;
+    let control_pointer = buffer.read_u64(header + 32);
+    let control_length = buffer.read_u64(header + 40) as usize;
+    if control_length == 0 {
+        return Ok(false);
+    }
+    if control_length > MAX_CONTROL {
+        return Err(-7);
+    }
+    let control = buffer.copy_from_tracee(pid, control_pointer, control_length, 8)?;
+    ancillary_contains_scm_rights(&buffer.bytes[control..control + control_length])
+}
+
+pub fn sendmmsg_has_scm_rights(pid: usize, address: u64, count: u64) -> Result<bool, i64> {
+    if count > MAX_MESSAGES as u64 {
+        return Err(-EINVAL);
+    }
+    for index in 0..count {
+        let offset = index.checked_mul(64).ok_or(-EINVAL)?;
+        let message = address.checked_add(offset).ok_or(-EINVAL)?;
+        if sendmsg_has_scm_rights(pid, message)? {
+            return Ok(true);
+        }
+    }
+    Ok(false)
+}
+
+pub fn recvmsg_scm_rights(pid: usize, address: u64) -> Result<ReceivedRights, i64> {
+    let mut rights = ReceivedRights::empty();
+    append_received_rights(pid, address, &mut rights)?;
+    Ok(rights)
+}
+
+pub fn recvmmsg_scm_rights(pid: usize, address: u64, count: u64) -> Result<ReceivedRights, i64> {
+    if count > MAX_MESSAGES as u64 {
+        return Err(-EINVAL);
+    }
+    let mut rights = ReceivedRights::empty();
+    for index in 0..count {
+        let offset = index.checked_mul(64).ok_or(-EINVAL)?;
+        let message = address.checked_add(offset).ok_or(-EINVAL)?;
+        append_received_rights(pid, message, &mut rights)?;
+    }
+    Ok(rights)
+}
+
+fn append_received_rights(
+    pid: usize,
+    address: u64,
+    rights: &mut ReceivedRights,
+) -> Result<(), i64> {
+    let mut buffer = Buffer::empty();
+    let header = buffer.copy_from_tracee(pid, address, 56, 8)?;
+    let control_pointer = buffer.read_u64(header + 32);
+    let control_length = buffer.read_u64(header + 40) as usize;
+    if control_length == 0 {
+        return Ok(());
+    }
+    if control_length > MAX_CONTROL {
+        return Err(-7);
+    }
+    let control = buffer.copy_from_tracee(pid, control_pointer, control_length, 8)?;
+    append_ancillary_rights(&buffer.bytes[control..control + control_length], rights)
+}
+
+fn append_ancillary_rights(control: &[u8], rights: &mut ReceivedRights) -> Result<(), i64> {
+    let mut offset = 0usize;
+    while offset < control.len() {
+        if control.len() - offset < 16 {
+            return Err(-EINVAL);
+        }
+        let length = u64::from_ne_bytes(
+            control[offset..offset + 8]
+                .try_into()
+                .map_err(|_| -EINVAL)?,
+        ) as usize;
+        if length < 16 || length > control.len() - offset {
+            return Err(-EINVAL);
+        }
+        let level = i32::from_ne_bytes(
+            control[offset + 8..offset + 12]
+                .try_into()
+                .map_err(|_| -EINVAL)?,
+        );
+        let kind = i32::from_ne_bytes(
+            control[offset + 12..offset + 16]
+                .try_into()
+                .map_err(|_| -EINVAL)?,
+        );
+        if level == 1 && kind == 1 {
+            let payload = &control[offset + 16..offset + length];
+            if !payload.len().is_multiple_of(4) {
+                return Err(-EINVAL);
+            }
+            for encoded in payload.as_chunks::<4>().0 {
+                rights.push(i32::from_ne_bytes(*encoded))?;
+            }
+        }
+        offset = offset.checked_add((length + 7) & !7).ok_or(-EINVAL)?;
+    }
+    Ok(())
+}
+
+fn ancillary_contains_scm_rights(control: &[u8]) -> Result<bool, i64> {
+    let mut offset = 0usize;
+    while offset < control.len() {
+        if control.len() - offset < 16 {
+            return Err(-EINVAL);
+        }
+        let length = u64::from_ne_bytes(
+            control[offset..offset + 8]
+                .try_into()
+                .map_err(|_| -EINVAL)?,
+        ) as usize;
+        if length < 16 || length > control.len() - offset {
+            return Err(-EINVAL);
+        }
+        let level = i32::from_ne_bytes(
+            control[offset + 8..offset + 12]
+                .try_into()
+                .map_err(|_| -EINVAL)?,
+        );
+        let kind = i32::from_ne_bytes(
+            control[offset + 12..offset + 16]
+                .try_into()
+                .map_err(|_| -EINVAL)?,
+        );
+        if level == 1 && kind == 1 {
+            return Ok(true);
+        }
+        offset = offset.checked_add((length + 7) & !7).ok_or(-EINVAL)?;
+    }
+    Ok(false)
+}
+
+fn snapshot_loopback_netlink_msghdr(
+    pid: usize,
+    address: u64,
+    buffer: &mut Buffer,
+    base: u64,
+) -> Result<(usize, u32), i64> {
+    let source = buffer.copy_from_tracee(pid, address, 56, 8)?;
+    let name_pointer = buffer.read_u64(source);
+    let name_length = u64::from(buffer.read_u32(source + 8));
+    let iov_pointer = buffer.read_u64(source + 16);
+    let iov_count = buffer.read_u64(source + 24) as usize;
+    let control_pointer = buffer.read_u64(source + 32);
+    let control_length = buffer.read_u64(source + 40) as usize;
+    if iov_count != 1 || control_pointer != 0 || control_length != 0 {
+        return Err(-EINVAL);
+    }
+    let name = snapshot_netlink_name(pid, name_pointer, name_length, buffer)?;
+    let iov_source = buffer.copy_from_tracee(pid, iov_pointer, 16, 8)?;
+    let payload_pointer = buffer.read_u64(iov_source);
+    let payload_length = buffer.read_u64(iov_source + 8) as usize;
+    if !(24..=256).contains(&payload_length) {
+        return Err(-EINVAL);
+    }
+    let payload = buffer.copy_from_tracee(pid, payload_pointer, payload_length, 8)?;
+    let sequence = validate_loopback_netlink(&buffer.bytes[payload..payload + payload_length])?;
+    let iov_copy = buffer.reserve(16, 8)?;
+    buffer.write_u64(iov_copy, base + payload as u64);
+    buffer.write_u64(iov_copy + 8, payload_length as u64);
+    let header = buffer.reserve(56, 8)?;
+    let mut source_header = [0u8; 56];
+    source_header.copy_from_slice(&buffer.bytes[source..source + 56]);
+    buffer.bytes[header..header + 56].copy_from_slice(&source_header);
+    buffer.write_u64(
+        header,
+        offset_address(base, name, if name == 0 { 0 } else { 12 }),
+    );
+    buffer.write_u64(header + 16, base + iov_copy as u64);
+    buffer.write_u64(header + 32, 0);
+    Ok((header, sequence))
+}
+
+fn snapshot_netlink_name(
+    pid: usize,
+    address: u64,
+    length: u64,
+    buffer: &mut Buffer,
+) -> Result<usize, i64> {
+    if length == 0 {
+        return Ok(0);
+    }
+    if address == 0 || !(12..=128).contains(&length) {
+        return Err(-EINVAL);
+    }
+    let offset = buffer.copy_from_tracee(pid, address, length as usize, 4)?;
+    if u16::from_ne_bytes(buffer.bytes[offset..offset + 2].try_into().unwrap()) != 16
+        || buffer.bytes[offset + 2..offset + length as usize]
+            .iter()
+            .any(|byte| *byte != 0)
+    {
+        return Err(-EINVAL);
+    }
+    Ok(offset)
+}
+
+fn validate_loopback_netlink(payload: &[u8]) -> Result<u32, i64> {
+    let message_length = u32::from_ne_bytes(payload[0..4].try_into().unwrap()) as usize;
+    let message_type = u16::from_ne_bytes(payload[4..6].try_into().unwrap());
+    let flags = u16::from_ne_bytes(payload[6..8].try_into().unwrap());
+    if message_length < 24
+        || message_length > payload.len()
+        || payload[message_length..].iter().any(|byte| *byte != 0)
+        || flags & 1 == 0
+    {
+        return Err(-EINVAL);
+    }
+    if matches!(message_type, 16 | 19) {
+        if message_length < 32
+            || payload[16] != 0
+            || i32::from_ne_bytes(payload[20..24].try_into().unwrap()) != 1
+            || u32::from_ne_bytes(payload[24..28].try_into().unwrap()) & 1 == 0
+            || u32::from_ne_bytes(payload[28..32].try_into().unwrap()) != 1
+        {
+            return Err(-EINVAL);
+        }
+        let mut offset = 32;
+        while offset < message_length {
+            if message_length - offset < 4 {
+                return Err(-EINVAL);
+            }
+            let length =
+                u16::from_ne_bytes(payload[offset..offset + 2].try_into().unwrap()) as usize;
+            let kind = u16::from_ne_bytes(payload[offset + 2..offset + 4].try_into().unwrap());
+            if length != 7 || kind != 3 || &payload[offset + 4..offset + 7] != b"lo\0" {
+                return Err(-EINVAL);
+            }
+            offset = (offset + length + 3) & !3;
+        }
+        return if offset == (message_length + 3) & !3 {
+            Ok(u32::from_ne_bytes(payload[8..12].try_into().unwrap()))
+        } else {
+            Err(-EINVAL)
+        };
+    }
+    // RTM_NEWADDR + ifaddrmsg: IPv4 127.0.0.1/8 or IPv6 ::1/128,
+    // host scope, and the loopback interface index only.
+    let family = payload[16];
+    if message_type != 20 {
+        return Err(-EINVAL);
+    }
+    if !matches!((family, payload[17]), (2, 8) | (10, 128))
+        || payload[19] != 254
+        || u32::from_ne_bytes(payload[20..24].try_into().unwrap()) != 1
+    {
+        return Err(-EINVAL);
+    }
+    let mut offset = 24;
+    let mut saw_address = false;
+    while offset < message_length {
+        if message_length - offset < 4 {
+            return Err(-EINVAL);
+        }
+        let length = u16::from_ne_bytes(payload[offset..offset + 2].try_into().unwrap()) as usize;
+        let kind = u16::from_ne_bytes(payload[offset + 2..offset + 4].try_into().unwrap());
+        if length < 4
+            || offset
+                .checked_add(length)
+                .is_none_or(|end| end > message_length)
+        {
+            return Err(-EINVAL);
+        }
+        if matches!(kind, 1 | 2) {
+            let address_is_loopback = if family == 2 {
+                length == 8 && payload[offset + 4..offset + 8] == [127, 0, 0, 1]
+            } else {
+                length == 20
+                    && payload[offset + 4..offset + 19]
+                        .iter()
+                        .all(|byte| *byte == 0)
+                    && payload[offset + 19] == 1
+            };
+            if !address_is_loopback {
+                return Err(-EINVAL);
+            }
+            saw_address = true;
+        } else {
+            match kind {
+                3 if length == 7 && &payload[offset + 4..offset + 7] == b"lo\0" => {}
+                4 if family == 2
+                    && length == 8
+                    && payload[offset + 4..offset + 8] == [127, 255, 255, 255] => {}
+                6 if length == 20 => {}
+                8 if length == 8 => {}
+                11 if length == 5 => {}
+                _ => return Err(-EINVAL),
+            }
+        }
+        offset = (offset + length + 3) & !3;
+    }
+    if !saw_address || offset != (message_length + 3) & !3 {
+        return Err(-EINVAL);
+    }
+    Ok(u32::from_ne_bytes(payload[8..12].try_into().unwrap()))
+}
+
+pub fn accept_loopback_ack(
+    pid: usize,
+    header_address: usize,
+    sequences: &[u32],
+) -> Result<Option<usize>, i64> {
+    let mut buffer = Buffer::empty();
+    let header = buffer.copy_from_tracee(pid, header_address as u64, 56, 8)?;
+    let iov_pointer = buffer.read_u64(header + 16);
+    let iov_count = buffer.read_u64(header + 24);
+    if iov_count == 0 || iov_pointer == 0 {
+        return Err(-EINVAL);
+    }
+    let iov = buffer.copy_from_tracee(pid, iov_pointer, 16, 8)?;
+    let payload_pointer = buffer.read_u64(iov);
+    let payload_length = buffer.read_u64(iov + 8);
+    if payload_pointer == 0 || payload_length < 16 {
+        return Err(-EINVAL);
+    }
+    let copied_length = core::cmp::min(payload_length as usize, MAX_CONTROL);
+    let payload = buffer.copy_from_tracee(pid, payload_pointer, copied_length, 4)?;
+    ginux_core::loopback_netlink_ack_index(
+        &buffer.bytes[payload..payload + copied_length],
+        sequences,
+    )
+}
+
+fn snapshot_destination(
+    pid: usize,
+    address: u64,
+    length: u64,
+    buffer: &mut Buffer,
+    address_kind: AddressKind,
+) -> Result<(usize, Option<Destination>), i64> {
+    if address == 0 && length == 0 {
+        return Ok((0, None));
+    }
+    if address == 0 || length as usize > MAX_SOCKADDR {
+        return Err(-EINVAL);
+    }
+    let minimum = match address_kind {
+        AddressKind::Internet => 4,
+        AddressKind::UnixPath => 3,
+    };
+    if length < minimum {
+        return Err(-EINVAL);
+    }
+    let offset = buffer.copy_from_tracee(pid, address, length as usize, 8)?;
+    let family = u16::from_ne_bytes(
+        buffer.bytes[offset..offset + 2]
+            .try_into()
+            .map_err(|_| -EINVAL)?,
+    );
+    if address_kind == AddressKind::UnixPath {
+        if family != 1 || buffer.bytes[offset + 2] == 0 {
+            return Err(-EPERM);
+        }
+        return Ok((offset, None));
+    }
+    let word = buffer.read_u64(offset);
+    let required = match family {
+        2 => 16,
+        10 => 28,
+        _ => return Err(-EINVAL),
+    };
+    if length < required {
+        return Err(-EINVAL);
+    }
+    let port = ((((word >> 16) & 0xff) << 8) | ((word >> 24) & 0xff)) as u16;
+    Ok((offset, Some(Destination { port })))
+}
+
+fn offset_address(base: u64, offset: usize, length: usize) -> u64 {
+    if length == 0 {
+        0
+    } else {
+        base + offset as u64
+    }
+}
+
+fn arguments(regs: &UserRegs) -> [u64; 6] {
+    [regs.rdi, regs.rsi, regs.rdx, regs.r10, regs.r8, regs.r9]
+}
+
+fn set_call(regs: &mut UserRegs, syscall: u64, args: [u64; 6]) {
+    regs.orig_rax = syscall;
+    [regs.rdi, regs.rsi, regs.rdx, regs.r10, regs.r8, regs.r9] = args;
+}
+
+fn overlaps(address: u64, length: u64) -> bool {
+    address < END && address.saturating_add(length.max(1)) > BASE
+}
+
+pub fn changes_snapshot(syscall: u64, regs: &UserRegs) -> bool {
+    match syscall {
+        9 => overlaps(regs.rdi, regs.rsi),
+        10 | 11 | 28 | 329 => overlaps(regs.rdi, regs.rsi),
+        25 => overlaps(regs.rdi, regs.rsi) || (regs.r10 & 2 != 0 && overlaps(regs.r8, regs.rdx)),
+        _ => false,
+    }
+}
diff --git a/crates/ginux-init/src/process_hooks.rs b/crates/ginux-init/src/process_hooks.rs
new file mode 100644
index 0000000..3948bfc
--- /dev/null
+++ b/crates/ginux-init/src/process_hooks.rs
@@ -0,0 +1,266 @@
+//! Syscall validation for native process supervision.
+//!
+//! The `process-native` loop runs supported fork, clone, vfork, and exec
+//! calls under ptrace, then records their outcomes in `ProcessTable`.
+//! Unsupported clone flags and execveat forms return ENOSYS before execution.
+//! Host-namespace creation is a supported Linux operation denied by the Ginux
+//! boundary, so it returns EPERM rather than pretending the syscall is absent.
+//! Supported clone3 shapes use the same managed process policy through an
+//! immutable argument snapshot.
+//!
+//! The loop also handles virtual identities, blocking/nonblocking child
+//! waits, termination signals, and descriptor inheritance. Pipes and stdio
+//! aliases are mirrored in `PipeSpace`; ordinary file opens are unsupported.
+//! Signal handlers, job control, and PI futex operations are unsupported.
+//! These hooks do not enable process creation in configured `launch`.
+
+use crate::supervisor::{ENOSYS, EPERM, SYS_FORK};
+
+/// Raw clone entry: what glibc `fork()` and the `posix_spawn` fallback emit.
+pub const SYS_CLONE: u64 = 56;
+/// Raw vfork entry: classic process-creation spelling, parent-blocked.
+pub const SYS_VFORK: u64 = 58;
+/// Raw execve entry: replaces the calling task's image, same pid.
+pub const SYS_EXECVE: u64 = 59;
+/// Raw execveat entry: dirfd-relative executable replacement.
+pub const SYS_EXECVEAT: u64 = 322;
+
+/// `AT_FDCWD` dirfd: resolve the path against the working directory.
+pub const AT_FDCWD: u64 = (-100i64) as u64;
+
+/// Share the descriptor table when cloning.
+pub const CLONE_FILES: u64 = 0x0000_0400;
+pub const CLONE_PARENT_SETTID: u64 = 0x0010_0000;
+pub const CLONE_CHILD_SETTID: u64 = 0x0100_0000;
+/// `CLONE_THREAD` flag (bit 16): create a thread-group member.
+pub const CLONE_THREAD: u64 = 0x0001_0000;
+/// `CLONE_VM` flag (bit 8): child shares the parent's address space.
+pub const CLONE_VM: u64 = 0x0000_0100;
+/// `CLONE_VFORK` flag (bit 14): parent stays blocked until the child
+/// releases shared memory by exiting or executing.
+pub const CLONE_VFORK: u64 = 0x0000_4000;
+/// `CLONE_SIGHAND` flag (bit 11): child shares the parent's signal handlers.
+/// Required alongside `CLONE_VM` for every supported thread shape.
+pub const CLONE_SIGHAND: u64 = 0x0000_0800;
+/// `CLONE_PARENT` flag (bit 15): child takes the caller's parent, which
+/// would break managed ownership; thread shapes carrying it are denied.
+pub const CLONE_PARENT: u64 = 0x0000_8000;
+/// Host-namespace creation flags: a thread that also unshares host state has
+/// no managed representation; thread shapes carrying any of them are denied.
+pub const CLONE_NEWNS: u64 = 0x0002_0000;
+pub const CLONE_NEWCGROUP: u64 = 0x0200_0000;
+pub const CLONE_NEWUTS: u64 = 0x0400_0000;
+pub const CLONE_NEWIPC: u64 = 0x0800_0000;
+pub const CLONE_NEWUSER: u64 = 0x1000_0000;
+pub const CLONE_NEWPID: u64 = 0x2000_0000;
+pub const CLONE_NEWNET: u64 = 0x4000_0000;
+pub const CLONE_NEWTIME: u64 = 0x0000_0080;
+pub const CLONE_NAMESPACES: u64 = CLONE_NEWNS
+    | CLONE_NEWCGROUP
+    | CLONE_NEWUTS
+    | CLONE_NEWIPC
+    | CLONE_NEWUSER
+    | CLONE_NEWPID
+    | CLONE_NEWNET
+    | CLONE_NEWTIME;
+/// `CLONE_UNTRACED` flag (bit 23): an untraced child would escape
+/// supervision; thread shapes carrying it are denied.
+pub const CLONE_UNTRACED: u64 = 0x0080_0000;
+/// Low byte of the clone flags: the child exit signal. Threads never carry
+/// one; any nonzero value in a thread shape is denied.
+pub const CLONE_EXIT_SIGNAL_MASK: u64 = 0x0000_00ff;
+
+/// Raw `read` entry: gated in the supervision loop to stdio and tracked
+/// pipe ends; anything else fails closed with `-EBADF`.
+pub const SYS_READ: u64 = 0;
+/// Raw `close` entry: always executes on the host; the loop drops the
+/// mirrored entry when the host reports success.
+pub const SYS_CLOSE: u64 = 3;
+/// Raw `pipe` entry: creates a connected pair, both ends owned by the caller.
+pub const SYS_PIPE: u64 = 22;
+/// Raw `dup` entry: lowest-free alias with `FD_CLOEXEC` cleared.
+pub const SYS_DUP: u64 = 32;
+/// Raw `dup2` entry: alias at an explicit number with `FD_CLOEXEC` cleared.
+pub const SYS_DUP2: u64 = 33;
+/// Raw `fcntl` entry: only the duplication and flag commands below run.
+pub const SYS_FCNTL: u64 = 72;
+/// Raw `dup3` entry: alias at an explicit number with `O_CLOEXEC` choice.
+pub const SYS_DUP3: u64 = 292;
+/// Raw `pipe2` entry: pipe pair with atomic flags.
+pub const SYS_PIPE2: u64 = 293;
+
+/// `O_CLOEXEC` creation flag: the end dies with executable replacement.
+pub const O_CLOEXEC: u64 = 0o2000000;
+/// `O_NONBLOCK` creation flag: the only other flag a pipe pair accepts.
+pub const O_NONBLOCK: u64 = 0o4000;
+/// `O_DIRECT` creation flag: packetized pipe mode the mirror does not
+/// represent; explicitly denied on pipes.
+pub const O_DIRECT: u64 = 0o40000;
+/// The only `pipe2` flags the mirror represents.
+pub const PIPE2_ALLOWED_FLAGS: u64 = O_CLOEXEC | O_NONBLOCK;
+/// `fcntl` duplication/flag commands the mirror represents.
+pub const F_DUPFD: u64 = 0;
+pub const F_GETFD: u64 = 1;
+pub const F_SETFD: u64 = 2;
+pub const F_DUPFD_CLOEXEC: u64 = 1030;
+/// `FD_CLOEXEC` flag bit for `F_GETFD`/`F_SETFD`.
+pub const FD_CLOEXEC: u64 = 1;
+
+/// Whether a `pipe2` flag word names a representable pair: the allowed
+/// subset only. `O_DIRECT` and every other bit fail explicitly with
+/// `-EINVAL` before the host runs.
+pub fn pipe2_flags_valid(flags: u64) -> bool {
+    flags & !PIPE2_ALLOWED_FLAGS == 0 && flags & O_DIRECT == 0
+}
+
+/// Whether a `dup3` flag word names a representable alias: empty or
+/// `O_CLOEXEC` only. Anything else fails explicitly with `-EINVAL`.
+pub fn dup3_flags_valid(flags: u64) -> bool {
+    flags == 0 || flags == O_CLOEXEC
+}
+
+/// Whether an `fcntl` command belongs to the mediated duplication/flag
+/// subset. Anything else (file status flags, locks, leases, signals,
+/// pipe sizing) keeps the existing explicit `-ENOSYS` denial.
+pub fn fcntl_supported(command: u64) -> bool {
+    command == F_DUPFD || command == F_GETFD || command == F_SETFD || command == F_DUPFD_CLOEXEC
+}
+
+/// Raw `arch_prctl` entry: installs or reads the calling thread's TLS base.
+/// Thread-local register state only; mediated for every subcommand.
+pub const SYS_ARCH_PRCTL: u64 = 158;
+/// Raw `gettid` entry: translated to the virtual tid like `getpid`.
+pub const SYS_GETTID: u64 = 186;
+/// Raw `futex` entry: wait/wake on the thread group's own shared memory.
+/// The host kernel performs the blocking and wakeup, so join/mutex observe
+/// real results. PI operations are denied because they expose host tids.
+pub const SYS_FUTEX: u64 = 202;
+/// Raw `set_tid_address` entry: per-thread exit-clear registration. The
+/// returned tid is translated to the virtual tid at the exit stop.
+pub const SYS_SET_TID_ADDRESS: u64 = 218;
+/// Raw `set_robust_list` entry: per-thread robust-mutex registration in
+/// tracee memory; mediated.
+pub const SYS_SET_ROBUST_LIST: u64 = 273;
+/// Raw `get_robust_list` entry: reads back the calling thread's own
+/// registration; only pid 0 or its own virtual tid is accepted.
+pub const SYS_GET_ROBUST_LIST: u64 = 274;
+/// Raw `rseq` entry: per-thread restartable-sequence registration in tracee
+/// memory; mediated.
+pub const SYS_RSEQ: u64 = 334;
+
+/// Ptrace fork-event stops delivered for the three mediated entries.
+pub const PTRACE_EVENT_VFORK: usize = 2;
+pub const PTRACE_EVENT_CLONE: usize = 3;
+
+/// Ptrace options requesting the vfork/clone event stops alongside fork.
+/// Each option is the event number as a bit, per `linux/ptrace.h`.
+pub const PTRACE_O_TRACECLONE: usize = 1 << PTRACE_EVENT_CLONE;
+pub const PTRACE_O_TRACEVFORK: usize = 1 << PTRACE_EVENT_VFORK;
+
+/// Lane membership by syscall number: the three process-creation entries
+/// plus the two executable-replacement entries belong to the process lane.
+/// Other entries are handled directly by the supervision loop.
+pub const fn claims(syscall: u64) -> bool {
+    syscall == SYS_FORK as u64
+        || syscall == SYS_CLONE
+        || syscall == SYS_VFORK
+        || syscall == SYS_EXECVE
+        || syscall == SYS_EXECVEAT
+}
+
+/// Whether a `CLONE_THREAD` flag word names the one supported thread shape:
+/// a thread-group member sharing memory and signal handlers (`CLONE_VM` +
+/// `CLONE_SIGHAND`, the glibc `pthread_create` basis), without `CLONE_VFORK`
+/// (parent blocking is meaningless inside a thread group), without an exit
+/// signal, without reparenting (`CLONE_PARENT`), without host-namespace
+/// creation, and without `CLONE_UNTRACED` (which would evade supervision).
+/// The remaining sharing flags (`CLONE_FS`, `CLONE_FILES`), `CLONE_SYSVSEM`,
+/// and the `CLONE_SETTLS` / `CLONE_PARENT_SETTID` / `CLONE_CHILD_CLEARTID`
+/// tid plumbing are accepted in any combination: they stay inside the thread
+/// group's own memory. Anything else with `CLONE_THREAD` fails explicitly
+/// with `-ENOSYS` and never executes on the host.
+pub fn thread_supported(flags: u64) -> bool {
+    flags & CLONE_THREAD != 0
+        && flags & (CLONE_VM | CLONE_SIGHAND) == (CLONE_VM | CLONE_SIGHAND)
+        && flags & (CLONE_VFORK | CLONE_PARENT | CLONE_UNTRACED | CLONE_NAMESPACES) == 0
+        && flags & CLONE_EXIT_SIGNAL_MASK == 0
+}
+
+/// Reject unsupported clone flags and concurrent address-space sharing
+/// outside a thread group. `None` lets the supervision loop handle the call;
+/// it is not permission for other callers to execute a host syscall.
+pub fn claim(syscall: u64, rdi: u64, _rsi: u64, _rdx: u64) -> Option<i64> {
+    if syscall == SYS_CLONE {
+        if rdi & CLONE_NAMESPACES != 0 {
+            return Some(-EPERM);
+        }
+        // Accept only the flags represented by managed process ownership.
+        // CLONE_UNTRACED and CLONE_PARENT must be rejected for processes too.
+        const ALLOWED: u64 = CLONE_VM
+            | 0x200
+            | CLONE_FILES
+            | CLONE_SIGHAND
+            | CLONE_VFORK
+            | CLONE_THREAD
+            | 0x40000
+            | 0x80000
+            | CLONE_PARENT_SETTID
+            | 0x200000
+            | CLONE_CHILD_SETTID
+            | 0xff;
+        if rdi & !ALLOWED != 0 || rdi & CLONE_UNTRACED != 0 {
+            return Some(-ENOSYS);
+        }
+        if (rdi & CLONE_THREAD) != 0 {
+            return if thread_supported(rdi) {
+                None
+            } else {
+                Some(-ENOSYS)
+            };
+        }
+        if rdi & CLONE_EXIT_SIGNAL_MASK != 17 {
+            return Some(-ENOSYS);
+        }
+        if (rdi & (CLONE_VM | CLONE_VFORK)) == CLONE_VM {
+            return Some(-ENOSYS);
+        }
+    }
+    None
+}
+
+/// Apply the legacy clone ownership policy to clone3's split flags and exit
+/// signal while preserving clone3-only features already mediated elsewhere.
+/// Return the fail-closed errno for an unsupported clone3 shape. Namespace
+/// creation is denied as a privilege boundary; other unimplemented shapes
+/// remain ENOSYS so callers can distinguish policy from missing emulation.
+pub fn clone3_denial(flags: u64, exit_signal: u64) -> Option<i64> {
+    const CLONE_PIDFD: u64 = 0x0000_1000;
+    const CLONE_CLEAR_SIGHAND: u64 = 0x1_0000_0000;
+    const CLONE_INTO_CGROUP: u64 = 0x2_0000_0000;
+    if flags & CLONE_NAMESPACES != 0 {
+        return Some(-EPERM);
+    }
+    if flags & CLONE_CLEAR_SIGHAND != 0 && flags & CLONE_SIGHAND != 0 {
+        return Some(-ENOSYS);
+    }
+    let legacy = flags & !(CLONE_PIDFD | CLONE_CLEAR_SIGHAND | CLONE_INTO_CGROUP);
+    if exit_signal > u8::MAX as u64 {
+        return Some(-ENOSYS);
+    }
+    claim(SYS_CLONE, legacy | exit_signal, 0, 0)
+}
+
+/// Whether an executable-replacement entry executes under supervision.
+/// Plain `execve` and `execveat(AT_FDCWD, path, argv, envp, 0)` are mediated:
+/// the host kernel performs shebang and loader transitions with the tracee
+/// still attached. Any other `execveat` shape (non-CWD dirfd, or nonzero
+/// flags such as `AT_EMPTY_PATH`) is unsupported and never executes on the host.
+pub fn exec_mediated(syscall: u64, dirfd: u64, flags: u64) -> bool {
+    if syscall == SYS_EXECVE {
+        return true;
+    }
+    if syscall == SYS_EXECVEAT {
+        return dirfd as i32 == AT_FDCWD as i32 && flags == 0;
+    }
+    false
+}
