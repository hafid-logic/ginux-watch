+                latency=$(printf "%s\n" "$values" | sed -n "s/.*latency_ns=\([0-9.]*\).*/\1/p")
+                peak=$(printf "%s\n" "$values" | sed -n "s/.*peak_rss_kib=\([0-9]*\).*/\1/p")
+                requested=$(printf "%s\n" "$values" | sed -n "s/.*live_requested_bytes=\([0-9]*\).*/\1/p")
+                resident=$(printf "%s\n" "$values" | sed -n "s/.*live_rss_delta_bytes=\([0-9]*\).*/\1/p")
+                fragmentation=$(printf "%s\n" "$values" | sed -n "s/.*fragmentation_ratio=\([0-9.]*\).*/\1/p")
+                test -n "$operations" && test -n "$elapsed" && test -n "$rate" && \
+                    test -n "$latency" && test -n "$peak" && test -n "$requested" && \
+                    test -n "$resident" && test -n "$fragmentation"
+                printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" \
+                    "$kind" "$threads" "$repetition" "$operations" "$elapsed" "$rate" \
+                    "$latency" "$peak" "$requested" "$resident" "$fragmentation" >>"$report"
+            done
+            repetition=$((repetition + 1))
+        done
+    done
+    cat "$report"
+'
+mkdir -p .artifacts/allocator
+rocky_scp \
+    "$ROCKY_SSH_USER@127.0.0.1:/var/tmp/allocator-benchmark.tsv" \
+    .artifacts/allocator/rocky-benchmark.tsv
+rocky_scp \
+    "$ROCKY_SSH_USER@127.0.0.1:/var/tmp/allocator-provenance.txt" \
+    .artifacts/allocator/rocky-provenance.txt
+printf 'source_commit=%s\n' "$(git rev-parse HEAD)" >> \
+    .artifacts/allocator/rocky-provenance.txt
+printf '%s\n' 'GINUX_ALLOCATOR_ROCKY: PASS'
diff --git a/scripts/test-bench-compare.sh b/scripts/test-bench-compare.sh
new file mode 100755
index 0000000..49f8976
--- /dev/null
+++ b/scripts/test-bench-compare.sh
@@ -0,0 +1,112 @@
+#!/bin/sh
+set -eu
+
+test_dir=$(mktemp -d "${TMPDIR:-/tmp}/ginux-bench-compare.XXXXXX")
+cleanup() {
+    rm -rf "$test_dir"
+}
+trap cleanup 0 HUP INT TERM
+
+metadata() {
+    destination=$1
+    kernel=$2
+    cat >"$destination" <<EOF
+host_kernel=$kernel
+host_arch=x86_64
+host_vcpus=4
+sysbench_nevra=sysbench-test
+sysbench_sha256=test-digest
+rocky_release=Rocky test
+instance_image=test-image
+instance_config_sha256=test-config
+benchmark_duration_seconds=5
+repetitions=3
+memory_limit_bytes=1073741824
+cpu_affinity=test-affinity
+audit_enabled=1
+dispatch_mode=selective
+ginux_supervisor_cpu=shared-with-instance
+EOF
+}
+
+results() {
+    destination=$1
+    native=$2
+    ginux=$3
+    cat >"$destination" <<EOF
+side	workload	vcpus	threads	repetition	direction	unit	value
+native	cpu	1	1	1	higher	events/s	$native
+native	cpu	1	1	2	higher	events/s	$native
+native	cpu	1	1	3	higher	events/s	$native
+ginux	cpu	1	1	1	higher	events/s	$ginux
+ginux	cpu	1	1	2	higher	events/s	$ginux
+ginux	cpu	1	1	3	higher	events/s	$ginux
+EOF
+}
+
+metadata "$test_dir/current.meta" test-kernel
+metadata "$test_dir/accepted.meta" test-kernel
+results "$test_dir/accepted.tsv" 100 100
+results "$test_dir/accepted-native-fail.tsv" 100 95
+results "$test_dir/pass.tsv" 100 97
+results "$test_dir/native-fail.tsv" 100 95
+results "$test_dir/regression-fail.tsv" 100 95
+
+./scripts/bench-compare.sh "$test_dir/pass.tsv" "$test_dir/current.meta" \
+    "$test_dir/accepted.tsv" "$test_dir/accepted.meta" >/dev/null
+
+if ./scripts/bench-compare.sh "$test_dir/native-fail.tsv" "$test_dir/current.meta" \
+    "$test_dir/accepted.tsv" "$test_dir/accepted.meta" >/dev/null 2>&1; then
+    printf '%s\n' 'native budget perturbation unexpectedly passed' >&2
+    exit 1
+fi
+
+GINUX_BENCH_REQUIRE_NATIVE_BUDGET=0 ./scripts/bench-compare.sh \
+    "$test_dir/native-fail.tsv" "$test_dir/current.meta" \
+    "$test_dir/accepted-native-fail.tsv" "$test_dir/accepted.meta" >/dev/null
+
+# This row passes a 4% native budget when native is lowered to 98, while
+# still regressing 5% from the accepted Ginux value of 100.
+results "$test_dir/regression-fail.tsv" 98 95
+if ./scripts/bench-compare.sh "$test_dir/regression-fail.tsv" "$test_dir/current.meta" \
+    "$test_dir/accepted.tsv" "$test_dir/accepted.meta" >/dev/null 2>&1; then
+    printf '%s\n' 'accepted Ginux regression perturbation unexpectedly passed' >&2
+    exit 1
+fi
+
+metadata "$test_dir/incompatible.meta" other-kernel
+set +e
+./scripts/bench-compare.sh "$test_dir/pass.tsv" "$test_dir/incompatible.meta" \
+    "$test_dir/accepted.tsv" "$test_dir/accepted.meta" >/dev/null 2>&1
+status=$?
+set -e
+test "$status" -eq 2
+
+sed 's/^dispatch_mode=selective$/dispatch_mode=paranoid/' \
+    "$test_dir/current.meta" >"$test_dir/incompatible-dispatch.meta"
+set +e
+./scripts/bench-compare.sh "$test_dir/pass.tsv" "$test_dir/incompatible-dispatch.meta" \
+    "$test_dir/accepted.tsv" "$test_dir/accepted.meta" >/dev/null 2>&1
+status=$?
+set -e
+test "$status" -eq 2
+
+if GINUX_BENCH_TOLERANCE=invalid ./scripts/bench-compare.sh \
+    "$test_dir/pass.tsv" "$test_dir/current.meta" \
+    "$test_dir/accepted.tsv" "$test_dir/accepted.meta" >/dev/null 2>&1; then
+    printf '%s\n' 'invalid tolerance unexpectedly passed' >&2
+    exit 1
+fi
+
+
+if GINUX_BENCH_REQUIRE_NATIVE_BUDGET=invalid ./scripts/bench-compare.sh \
+    "$test_dir/pass.tsv" "$test_dir/current.meta" \
+    "$test_dir/accepted.tsv" "$test_dir/accepted.meta" >/dev/null 2>&1; then
+    printf '%s\n' 'invalid native-budget requirement unexpectedly passed' >&2
+    exit 1
+fi
+
+./scripts/bench-compare.sh "$test_dir/pass.tsv" "$test_dir/current.meta" \
+    "$test_dir/missing.tsv" "$test_dir/missing.meta" >/dev/null
+
+printf '%s\n' 'test-bench-compare: PASS'
diff --git a/scripts/test-ci-changes.sh b/scripts/test-ci-changes.sh
new file mode 100755
index 0000000..3123643
--- /dev/null
+++ b/scripts/test-ci-changes.sh
@@ -0,0 +1,102 @@
+#!/bin/sh
+# Check scripts/ci-changes.sh against a scratch repository.
+set -eu
+
+script=$(cd "$(dirname "$0")" && pwd)/ci-changes.sh
+work=$(mktemp -d)
+trap 'rm -rf "$work"' EXIT
+cd "$work"
+
+git -c init.defaultBranch=main init -q repo
+cd repo
+commit() {
+    git add -A
+    git -c user.name=test -c user.email=test@example.invalid \
+        commit -q --allow-empty -m "$1"
+    git rev-parse HEAD
+}
+put() {
+    mkdir -p "$(dirname "$1")"
+    printf '%s\n' "$2" >"$1"
+}
+
+# main: code1 - docs1 - code2 - nested - moved - empty
+put crates/core/src/lib.rs 'pub fn one() {}'
+put README.md 'readme'
+code1=$(commit 'code')
+put docs/notes.md 'notes'
+put hdae/gates-todo/11.md 'gate'
+put README.md 'readme, edited'
+put LICENSE 'license'
+docs1=$(commit 'docs only')
+put crates/core/src/lib.rs 'pub fn two() {}'
+code2=$(commit 'more code')
+put crates/core/README.md 'crate readme'
+nested=$(commit 'markdown inside a crate')
+git mv crates/core/src/lib.rs docs/lib.rs.md
+moved=$(commit 'move code into docs')
+empty=$(commit 'empty')
+
+# A pull request branched at code1 that adds documentation, and a target
+# branch that, unlike main, gained only documentation since code1.
+git checkout -q -b pr "$code1"
+put docs/pr.md 'pr notes'
+pr_docs=$(commit 'pr docs')
+git checkout -q -b docs-target "$code1"
+put docs/target.md 'target notes'
+docs_target=$(commit 'target docs')
+git checkout -q main
+
+failures=0
+check() {
+    want=$1 name=$2
+    shift 2
+    got=$(sh "$script" "$@" 2>/dev/null)
+    if test "$got" = "code=$want"; then
+        printf 'ok   %s\n' "$name"
+    else
+        printf 'FAIL %s: got %s, want code=%s\n' "$name" "$got" "$want"
+        failures=$((failures + 1))
+    fi
+}
+# expect WANT NAME HEAD TARGET PASSED...
+expect() {
+    want=$1 name=$2 head=$3 target=$4
+    shift 4
+    printf '%s\n' "$@" >../passed
+    if test -n "$target"; then
+        check "$want" "$name" "$head" ../passed "$target"
+    else
+        check "$want" "$name" "$head" ../passed
+    fi
+}
+
+expect false 'docs after a passing commit' "$docs1" '' "$code1"
+expect false 'newest passing ancestor wins' "$docs1" '' "$code2" "$code1"
+expect true 'code after a passing commit' "$code2" '' "$docs1"
+expect true 'code before the passing docs commit' "$code2" '' "$code1"
+expect true 'no passing ancestor' "$docs1" '' "$code2"
+expect true 'empty passing list' "$docs1" ''
+expect true 're-run of a passing commit' "$docs1" '' "$docs1" "$code1"
+expect true 'markdown inside a crate' "$nested" '' "$code2"
+expect true 'code moved into docs/' "$moved" '' "$nested"
+expect true 'no files changed' "$empty" '' "$moved"
+expect true 'unknown head' 0123456789abcdef0123456789abcdef01234567 '' "$code1"
+check true 'missing passing list' "$docs1" ../missing
+expect false 'pull request, target gained docs' "$pr_docs" "$docs_target" "$code1"
+expect true 'pull request, target gained code' "$pr_docs" "$empty" "$code1"
+expect true 'pull request, unknown target' "$pr_docs" 0123456789abcdef0123456789abcdef01234567 "$code1"
+
+# CI clones with --filter=blob:none; the script must not need file contents.
+# GIT_NO_LAZY_FETCH makes a missing blob an error instead of a fetch.
+git config uploadpack.allowFilter true
+git -C .. clone -q --no-local --filter=blob:none --no-checkout repo partial
+cd ../partial
+GIT_NO_LAZY_FETCH=1
+export GIT_NO_LAZY_FETCH
+expect false 'blobless clone, docs only' "$docs1" '' "$code1"
+expect false 'blobless clone, pull request' "$pr_docs" "$docs_target" "$code1"
+expect true 'blobless clone, code' "$code2" '' "$docs1"
+
+test "$failures" -eq 0 || exit 1
+printf '%s\n' 'test-ci-changes: PASS'
