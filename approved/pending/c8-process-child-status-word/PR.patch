+            | 285
+            | 306
+            | SYS_UNLINKAT
+            | SYS_RENAMEAT
+            | SYS_LINKAT
+            | SYS_SYMLINKAT
+    ) {
+        BalancedSurface::InstanceWrite
+    } else if syscall == 153 {
+        BalancedSurface::Console
+    } else if matches!(syscall, 25 | SYS_MEMFD_CREATE) {
+        BalancedSurface::Memory
+    } else if matches!(
+        syscall,
+        SYS_SETUID
+            | SYS_SETGID
+            | SYS_SETREUID
+            | SYS_SETREGID
+            | SYS_SETGROUPS
+            | SYS_SETRESUID
+            | SYS_SETRESGID
+    ) {
