+fn text_list_contains<const N: usize>(values: &[ginux_instance::Text<N>], expected: &[u8]) -> bool {
+    values.iter().any(|value| value.as_bytes() == expected)
+}
+
+fn device_fail(reason: &[u8]) -> ! {
+    write_all(b"GATE6_DEVICES: FAIL: ");
+    line(reason);
+    exit_process(1)
+}
