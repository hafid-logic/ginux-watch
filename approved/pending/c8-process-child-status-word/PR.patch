+    owner: usize,
+) {
+    for entry in entries
+        .iter_mut()
+        .filter(|entry| entry.owner == owner && entry.close_on_exec)
+    {
+        *entry = EMPTY_VIRTUAL_KERNEL_FD;
+    }
