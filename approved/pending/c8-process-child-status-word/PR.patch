+pub fn managed_host_identity() -> ManagedHostIdentity {
+    let uid = unsafe { syscall0(SYS_GETUID) } as usize;
+    let gid = unsafe { syscall0(SYS_GETGID) } as usize;
+    if uid == 0 {
+        ManagedHostIdentity {
+            uid: HOST_NOBODY_UID,
+            gid: HOST_NOBODY_GID,
+            drop_root: true,
+        }
+    } else {
+        ManagedHostIdentity {
+            uid,
+            gid,
+            drop_root: false,
+        }
+    }
