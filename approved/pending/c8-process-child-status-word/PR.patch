+    if(value<0)buffer[n++]='-';
+    do { digits[count++]='0'+u%10;u/=10; }while(u);
+    while(count)buffer[n++]=digits[--count];
+    buffer[n++]='\n';
+    call3(1,1,(word)buffer,n);
