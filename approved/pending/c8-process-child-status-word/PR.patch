+++ b/scripts/test-native-vfs.sh
@@ -0,0 +1,110 @@
+#!/bin/sh
+set -eu
+
+. ./scripts/rocky-host-common.sh
+. ./scripts/oci-common.sh
+
+rootfs=$GINUX_OCI_CACHE_DIR/$GINUX_OCI_ROOTFS_LAYER
+native_log=build/gate5-native.log
+instance_root=/var/lib/ginux/instances/gate5/root
+
+./scripts/check-rocky-host.sh
+rocky_scp target/x86_64-unknown-linux-gnu/release/ginux \
+    "$ROCKY_SSH_USER@127.0.0.1:/var/tmp/ginux"
+rocky_scp config/instance-gate5.toml \
+    "$ROCKY_SSH_USER@127.0.0.1:/var/tmp/gate5.toml"
+rocky_scp "$rootfs" \
+    "$ROCKY_SSH_USER@127.0.0.1:/var/tmp/ginux-oci-rootfs.tar"
+
+rocky_ssh "set -eu; sudo rm -rf /var/lib/ginux/instances/gate5; sudo mkdir -p '$instance_root'; sudo tar -xf /var/tmp/ginux-oci-rootfs.tar -C '$instance_root'; sudo chmod -R a-w /var/lib/ginux/instances/gate5; test -x '$instance_root/usr/bin/bash'; test -x '$instance_root/usr/lib64/ld-linux-x86-64.so.2'; sha256sum '$instance_root/usr/bin/bash'" > build/gate5-bash-before.sha256
+
+rocky_ssh "sudo /var/tmp/ginux native /var/tmp/gate5.toml '$instance_root'" > "$native_log" 2>&1
+grep -Fqx 'GINUX_NATIVE: backend=ptrace-native profile=balanced elf-loader=host contract=self-contained-v1' "$native_log"
+grep -Fqx 'GINUX_NATIVE: tracee-uid=65534 tracee-gid=65534 root=oci-read-only' "$native_log"
+grep -Fqx 'GINUX_NATIVE_AUTHORITY: supervisor-uid=65534 supervisor-gid=65534 capabilities=none no-new-privileges=1 inherited-fds=bounded root=instance-only' "$native_log"
+grep -Fqx 'GINUX_NATIVE_SHELL: PASS' "$native_log"
+grep -Fqx 'GINUX_NATIVE: supervisor=attached dispatch=paranoid direct-safe-syscalls=0' "$native_log"
+grep -Fqx 'GINUX_NATIVE_CHECK: PASS' "$native_log"
+grep -Eq '^GINUX_NATIVE_AUDIT: sequence=[0-9]+ instance=gate5-demo .*phase=entry syscall=[0-9]+ action=(mediate|emulate|deny)' "$native_log"
+grep -Eq '^GINUX_NATIVE_AUDIT: sequence=[0-9]+ instance=gate5-demo .*phase=entry syscall=39 action=emulate surface=virtual-identity result=4242$' "$native_log"
+grep -Eq '^GINUX_NATIVE_AUDIT: sequence=[0-9]+ instance=gate5-demo .*phase=entry syscall=110 action=emulate surface=virtual-identity result=1$' "$native_log"
+grep -Eq '^GINUX_NATIVE_AUDIT: sequence=[0-9]+ instance=gate5-demo .*phase=entry syscall=102 action=emulate surface=virtual-identity result=0$' "$native_log"
+grep -Eq '^GINUX_NATIVE_AUDIT: sequence=[0-9]+ instance=gate5-demo .*phase=entry syscall=104 action=emulate surface=virtual-identity result=0$' "$native_log"
+grep -Eq '^GINUX_NATIVE_AUDIT: sequence=[0-9]+ instance=gate5-demo .*phase=entry syscall=16 action=deny result=-38$' "$native_log"
+grep -Eq '^GINUX_NATIVE_AUDIT: sequence=[0-9]+ instance=gate5-demo .*phase=entry syscall=257 action=mediate surface=immutable-image result=pending$' "$native_log"
+grep -Eq '^GINUX_NATIVE_AUDIT: sequence=[0-9]+ instance=gate5-demo .*phase=entry syscall=1 action=mediate surface=bootstrap-console result=pending$' "$native_log"
+printf '%s\n' '  native shell: PASS (Rocky loader and Bash, balanced audit surfaces)'
+
+rocky_ssh "sudo /var/tmp/ginux native /var/tmp/gate5.toml '$instance_root' probe" > build/gate5-balanced-probe.log 2>&1
+grep -Fq 'GINUX_BALANCED_MUTATION: BLOCKED' build/gate5-balanced-probe.log
+grep -Fq 'GINUX_BALANCED_NETWORK: BLOCKED' build/gate5-balanced-probe.log
+grep -Eq '^GINUX_NATIVE_AUDIT: sequence=[0-9]+ instance=gate5-demo .*phase=entry syscall=257 action=deny result=-1 reason=invalid-arguments$' build/gate5-balanced-probe.log
+grep -Eq '^GINUX_NATIVE_AUDIT: sequence=[0-9]+ instance=gate5-demo .*phase=entry syscall=41 action=deny result=-38$' build/gate5-balanced-probe.log
+rocky_ssh "test ! -e '$instance_root/tmp/ginux-mutation'"
+printf '%s\n' '  sensitive probes: PASS (mutation and networking denied before effect)'
+
+hold_pid=$(rocky_ssh "sudo sh -c 'exec /var/tmp/ginux native /var/tmp/gate5.toml \"$instance_root\" hold > /var/tmp/ginux-hold.log 2>&1 & echo \$!'")
+case "$hold_pid" in *[!0-9]*|'') printf '%s\n' 'invalid hold supervisor PID' >&2; exit 1 ;; esac
+ready=0
+attempt=0
+while [ "$attempt" -lt 50 ]; do
+    if rocky_ssh "grep -Fqx 'GINUX_NATIVE_HOLD: READY' /var/tmp/ginux-hold.log" >/dev/null 2>&1; then
+        ready=1
+        break
+    fi
+    sleep 1
+    attempt=$((attempt + 1))
+done
+test "$ready" -eq 1
+tracee_pid=$(rocky_ssh "pgrep -P '$hold_pid' -x bash")
+case "$tracee_pid" in *[!0-9]*|'') printf '%s\n' 'invalid held tracee PID' >&2; exit 1 ;; esac
+rocky_ssh "sudo awk '/^Uid:/{if (\$2 != 65534 || \$3 != 65534 || \$4 != 65534 || \$5 != 65534) exit 1} /^Gid:/{if (\$2 != 65534 || \$3 != 65534 || \$4 != 65534 || \$5 != 65534) exit 1} /^CapEff:/{if (\$2 != \"0000000000000000\") exit 1} /^NoNewPrivs:/{if (\$2 != 1) exit 1}' /proc/'$hold_pid'/status"
+supervisor_fds=$(rocky_ssh "sudo find /proc/'$hold_pid'/fd -mindepth 1 -maxdepth 1 -printf . | wc -c")
+case "$supervisor_fds" in *[!0-9]*|'') printf '%s\n' 'invalid supervisor descriptor count' >&2; exit 1 ;; esac
+test "$supervisor_fds" -le 4
+printf '%s\n' '  supervisor authority: PASS (nobody identity, zero capabilities, NoNewPrivs, bounded descriptors)'
+rocky_ssh "sudo kill -9 '$hold_pid'; attempt=0; while sudo kill -0 '$tracee_pid' 2>/dev/null; do attempt=\$((attempt + 1)); test \$attempt -lt 50 || exit 1; sleep 0.1; done"
+if rocky_ssh "sudo kill -0 '$tracee_pid'" >/dev/null 2>&1; then
+    printf '%s\n' 'tracee survived supervisor loss' >&2
+    exit 1
+fi
+printf '%s\n' '  supervisor loss: PASS (held tracee terminated by PTRACE_O_EXITKILL)'
+
+stop_pid=$(rocky_ssh "sudo sh -c 'exec /var/tmp/ginux native /var/tmp/gate5.toml \"$instance_root\" hold > /var/tmp/ginux-stop.log 2>&1 & echo \$!'")
+case "$stop_pid" in *[!0-9]*|'') printf '%s\n' 'invalid unexpected-stop supervisor PID' >&2; exit 1 ;; esac
+ready=0
+attempt=0
+while [ "$attempt" -lt 50 ]; do
+    if rocky_ssh "grep -Fqx 'GINUX_NATIVE_HOLD: READY' /var/tmp/ginux-stop.log" >/dev/null 2>&1; then
+        ready=1
+        break
+    fi
+    sleep 1
+    attempt=$((attempt + 1))
+done
+test "$ready" -eq 1
+stopped_tracee_pid=$(rocky_ssh "pgrep -P '$stop_pid' -x bash")
+case "$stopped_tracee_pid" in *[!0-9]*|'') printf '%s\n' 'invalid unexpected-stop tracee PID' >&2; exit 1 ;; esac
+rocky_ssh "sudo kill -STOP '$stopped_tracee_pid'"
+attempt=0
+while [ "$attempt" -lt 50 ]; do
+    if rocky_ssh "grep -Fqx 'GINUX_INSTANCE: failed reason=unexpected native trace stop' /var/tmp/ginux-stop.log" >/dev/null 2>&1; then
+        break
+    fi
+    sleep 0.1
+    attempt=$((attempt + 1))
+done
+grep_result=$(rocky_ssh "grep -Fxc 'GINUX_INSTANCE: failed reason=unexpected native trace stop' /var/tmp/ginux-stop.log")
+test "$grep_result" -eq 1
+if rocky_ssh "sudo kill -0 '$stopped_tracee_pid'" >/dev/null 2>&1; then
+    printf '%s\n' 'tracee survived unexpected ptrace stop' >&2
+    exit 1
+fi
+rocky_ssh "grep -Fqx 'GINUX_INSTANCE: cleanup resources=false managed-task=false' /var/tmp/ginux-stop.log"
+printf '%s\n' '  unexpected stop: PASS (tracee killed, reaped, and instance cleaned)'
+
+rocky_ssh "sha256sum '$instance_root/usr/bin/bash'" > build/gate5-bash-after.sha256
+cmp build/gate5-bash-before.sha256 build/gate5-bash-after.sha256
+printf '%s\n' '  immutable Bash: PASS (digest unchanged)'
+rocky_ssh 'sudo rm -rf /var/lib/ginux/instances/gate5 /var/tmp/ginux-hold.log /var/tmp/ginux-stop.log; rm -f /var/tmp/ginux /var/tmp/gate5.toml /var/tmp/ginux-oci-rootfs.tar'
+printf '%s\n' 'test-native-vfs: PASS'
diff --git a/scripts/test-native-yield-broker.py b/scripts/test-native-yield-broker.py
new file mode 100644
index 0000000..4395e49
--- /dev/null
+++ b/scripts/test-native-yield-broker.py
@@ -0,0 +1,224 @@
+#!/usr/bin/env python3
+"""Deterministically race the paranoid yield broker against signals (Linux/root).
+
+Seize only the broker, never Ginux or the workload: Ginux remains the
+workload's ptracer. Interrupt the broker's own receive, then hold it at its
+real receive and reply ioctls while a signal takes the workload out of its
+pending sched_yield. Both ioctls must report the race with ENOENT and the
+broker must keep serving. No test hook, timing-based race, or replacement runtime is used.
+"""
+import ctypes
+import os
+from pathlib import Path
+import re
+import shutil
+import signal
+import subprocess
+import sys
+import tempfile
+import time
+
+RECV, SEND = 0xc0502100, 0xc0182101
+ENOENT, EINTR, ERESTARTSYS = 2, 4, 512
+
+
+class Regs(ctypes.Structure):
+    _fields_ = [(name, ctypes.c_ulonglong) for name in (
+        "r15 r14 r13 r12 rbp rbx r11 r10 r9 r8 rax rcx rdx rsi rdi orig_rax "
+        "rip cs eflags rsp ss fs_base gs_base ds es fs gs").split()]
+
+
+def main():
+    if len(sys.argv) != 3 or os.geteuid() != 0:
+        sys.exit("usage (as root): test-native-yield-broker.py <ginux> <native fixture>")
+    binary, fixture = (Path(arg).resolve() for arg in sys.argv[1:])
+    template = (Path(__file__).resolve().parent.parent / "config/instance-gate5.toml").read_text()
+    if 'control = "paranoid"' not in template:
+        raise RuntimeError("the native template no longer selects the paranoid yield broker")
+    libc = ctypes.CDLL(None, use_errno=True)
+    libc.ptrace.argtypes = [ctypes.c_uint, ctypes.c_uint, ctypes.c_void_p, ctypes.c_void_p]
+    libc.ptrace.restype = ctypes.c_long
+
+    def ptrace(request, pid, address=0, data=0):
+        ctypes.set_errno(0)
+        value = libc.ptrace(request, pid, address, data)
+        if value == -1 and ctypes.get_errno():
+            raise OSError(ctypes.get_errno(), f"ptrace {request}")
+        return value
+
+    with tempfile.TemporaryDirectory(prefix="ginux-yield-broker-") as directory:
+        work = Path(directory)
+        work.chmod(0o755)
+        shutil.copy2(binary, work / "ginux")
+        (work / "ginux").chmod(0o755)
+        root = work / "root"
+        (root / "usr/bin").mkdir(parents=True)
+        shutil.copy2(fixture, root / "usr/bin/bash")
+        (root / "usr/bin/bash").chmod(0o755)
+        (root / "scenario").write_text("Yield-broker")
+        config = work / "instance.toml"
+        config.write_text(template.replace('init = "/bin/bash"', 'init = "/usr/bin/bash"'))
+        ginux = subprocess.Popen([str(work / "ginux"), "native", str(config), str(root)],
+                                 stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+                                 stderr=subprocess.STDOUT)
+        os.set_blocking(ginux.stdout.fileno(), False)
+        output = bytearray()
+        broker = workload = None
+
+        def drain():
+            while True:
+                try:
+                    data = os.read(ginux.stdout.fileno(), 65536)
+                except BlockingIOError:
+                    return
+                if not data:
+                    return
+                output.extend(data)
+
+        def descendants(pid):
+            found = []
+            try:
+                for task in Path(f"/proc/{pid}/task").iterdir():
+                    for child in (task / "children").read_text().split():
+                        found += [int(child)] + descendants(int(child))
+            except OSError:
+                pass
+            return found
+
+        def running(pid, command):
+            try:
+                return Path(f"/proc/{pid}/comm").read_text() == command + "\n"
+            except OSError:
+                return False
+
+        def blocked_in(pid, syscall, argument=None):
+            try:
+                fields = Path(f"/proc/{pid}/syscall").read_text().split()
+            except OSError:
+                return False
+            return (fields[0] == str(syscall)
+                    and (argument is None or int(fields[2], 16) == argument))
+
+        def until(condition, what):
+            while not condition():
+                drain()
+                if ginux.poll() is not None:
+                    drain()
+                    raise RuntimeError(f"Ginux exited while waiting for {what}: "
+                                       f"exit={ginux.returncode}\n{output.decode(errors='replace')}")
+                time.sleep(0.001)
+
+        def release_yield():
+            ginux.stdin.write(b"g")
+            ginux.stdin.flush()
+
+        def step():
+            """Resume the broker to its next syscall stop: (op, request or result)."""
+            ptrace(24, broker)
+            while True:
+                _, status = os.waitpid(broker, 0x40000000)
+                if os.WIFEXITED(status) or os.WIFSIGNALED(status):
+                    drain()
+                    raise RuntimeError(f"yield broker ended: status={status}\n"
+                                       f"{output.decode(errors='replace')}")
+                if os.WSTOPSIG(status) == signal.SIGTRAP | 0x80:
+                    info = ctypes.create_string_buffer(128)
+                    ptrace(0x420e, broker, len(info), ctypes.addressof(info))
+                    regs = Regs()
+                    ptrace(12, broker, 0, ctypes.addressof(regs))
+                    if info.raw[0] == 1:
+                        return "entry", regs.orig_rax, regs.rsi
+                    return "exit", regs.orig_rax, ctypes.c_longlong(regs.rax).value
+                ptrace(24, broker, 0, os.WSTOPSIG(status) if status >> 16 == 0 else 0)
+
+        def step_to(op, request):
+            while True:
+                stop = step()
+                if stop[0] == op and stop[1] == 16 and (op == "exit" or stop[2] == request):
+                    return stop[2]
+
+        def expired(_signal, _frame):
+            raise TimeoutError(f"yield broker fixture timed out\n{output.decode(errors='replace')}")
+
+        previous_alarm = signal.signal(signal.SIGALRM, expired)
+        signal.setitimer(signal.ITIMER_REAL, 30)
+        try:
+            # The workload waits on stdin before every yield, so the broker
+            # is blocked in a receive with nothing pending.
+            def find_broker():
+                nonlocal broker
+                broker = next((pid for pid in descendants(ginux.pid)
+                               if blocked_in(pid, 16, RECV)), None)
+                return broker is not None
+            until(find_broker, "the broker's receive")
+            # Ginux forks the broker at the workload's execve stop, so the
+            # broker can be waiting before the workload has replaced Ginux.
+            def find_workload():
+                nonlocal workload
+                workload = next((pid for pid in descendants(ginux.pid)
+                                 if running(pid, "bash")), None)
+                return workload is not None
+            until(find_workload, "the workload's exec")
+            # TRACESYSGOOD and EXITKILL. The interrupt wakes the receive:
+            # Linux 6.6 and later restart it, earlier kernels return EINTR.
+            ptrace(0x4206, broker, 0, 1 | (1 << 20))
+            ptrace(0x4207, broker)
+            _, status = os.waitpid(broker, 0x40000000)
+            regs = Regs()
+            ptrace(12, broker, 0, ctypes.addressof(regs))
+            if (status >> 16 != 128 or regs.orig_rax != 16
+                    or ctypes.c_longlong(regs.rax).value not in (-EINTR, -ERESTARTSYS)):
+                raise RuntimeError(f"broker receive was not interrupted: status={status:#x} "
+                                   f"syscall={regs.orig_rax} result={ctypes.c_longlong(regs.rax).value}")
+            # A signal ends the pending yield before the broker receives it.
+            step_to("entry", RECV)
+            release_yield()
+            until(lambda: blocked_in(workload, 24), "the first yield")
+            os.kill(workload, signal.SIGUSR1)
+            until(lambda: b"GINUX_FIXTURE: yield-before-receive=" in output, "the first result")
+            if (result := step_to("exit", RECV)) != -ENOENT:
+                raise RuntimeError(f"stale receive returned {result}, not -ENOENT")
+            # A signal ends the yield after the receive, before the reply.
+            step_to("entry", RECV)
+            release_yield()
+            if (result := step_to("exit", RECV)) != 0:
+                raise RuntimeError(f"receive returned {result}")
+            step_to("entry", SEND)
+            until(lambda: blocked_in(workload, 24), "the second yield")
+            os.kill(workload, signal.SIGUSR1)
+            until(lambda: b"GINUX_FIXTURE: yield-before-reply=" in output, "the second result")
+            if (result := step_to("exit", SEND)) != -ENOENT:
+                raise RuntimeError(f"late reply returned {result}, not -ENOENT")
+            ptrace(17, broker)
+            broker = None
+            release_yield()
+            ginux.stdin.close()
+            ginux.wait()
+            drain()
+        finally:
+            signal.setitimer(signal.ITIMER_REAL, 0)
+            signal.signal(signal.SIGALRM, previous_alarm)
+            if ginux.poll() is None:
+                for pid in descendants(ginux.pid):
+                    try:
+                        os.kill(pid, signal.SIGKILL)
+                    except ProcessLookupError:
+                        pass
+                ginux.kill()
+                ginux.wait()
+        text = output.decode(errors="replace")
+        records = re.findall(r"^GINUX_NATIVE_AUDIT: .*operation=syscall\.sched_yield .*$", text, re.M)
+        if (ginux.returncode != 0
+                or "GINUX_FIXTURE: yield-before-receive=-4\n" not in text
+                or "GINUX_FIXTURE: yield-before-reply=-4\n" not in text
+                or "GINUX_FIXTURE: yield-after=0\n" not in text
+                or "GINUX_FIXTURE: yield-signals=2\n" not in text
+                or len(records) != 2
+                or not all(record.endswith(" result=0") for record in records)):
+            raise RuntimeError(f"yield broker did not survive the races: exit={ginux.returncode}\n{text}")
+        print("PASS native yield broker: interrupted receive retried")
+        print("PASS native yield broker: yield interrupted before receive or reply; broker keeps serving")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/test-oci-layers.sh b/scripts/test-oci-layers.sh
