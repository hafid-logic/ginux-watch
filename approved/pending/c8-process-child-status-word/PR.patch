+    #[test]
+    fn identity_tokens_are_stable_and_separate_instances() {
+        assert_eq!(identity_token(b"rocky"), identity_token(b"rocky"));
+        assert_ne!(identity_token(b"rocky"), identity_token(b"peer"));
+        assert_ne!(identity_token(b""), 0);
+    }
+
+    fn path_admission_context() -> CallContext {
+        let cap = Capability::new(
+            CapabilityKind::Root,
+            2,
+            3,
+            5,
+            ObjectId {
+                device: 7,
+                inode: 11,
+            },
+            Rights::LOOKUP,
+        );
+        let typed = |kind| Capability { kind, ..cap };
+        CallContext::x86_64(
+            2,
+            [0; 6],
+            TaskContext {
+                host: 13,
+                virtual_id: 17,
+                generation: 19,
+            },
+            InstanceContext {
+                identity: 2,
+                lifetime: 3,
+                root_generation: 5,
+            },
+            AuthorityContext {
+                root: cap,
+                cwd: typed(CapabilityKind::WorkingDirectory),
+                descriptor_table: typed(CapabilityKind::DescriptorTable),
+                cwd_generation: 5,
+                descriptor_generation: 5,
+            },
+            ContractAuthorization::Mediate,
+        )
+    }
+
+    #[test]
+    fn path_admission_requires_complete_identity_and_capability_kinds() {
+        let base = path_admission_context();
+        assert!(filesystem_hook_authorized(&base, true));
+        for zero in [
+            |c: &mut CallContext| c.task.host = 0,
+            |c: &mut CallContext| c.task.virtual_id = 0,
+            |c: &mut CallContext| c.task.generation = 0,
+            |c: &mut CallContext| c.instance.identity = 0,
+            |c: &mut CallContext| c.instance.lifetime = 0,
+            |c: &mut CallContext| c.authority.root.kind = CapabilityKind::WorkingDirectory,
+            |c: &mut CallContext| c.authority.cwd.kind = CapabilityKind::Root,
+        ] {
+            let mut c = base;
+            zero(&mut c);
+            assert!(!filesystem_hook_authorized(&c, true));
+        }
+    }
+
+    #[test]
+    fn filesystem_lookup_fails_closed_for_denial_unknown_abi_and_wrong_owner() {
+        let capability = Capability::new(
+            CapabilityKind::Root,
+            2,
+            3,
+            5,
+            ObjectId {
+                device: 7,
+                inode: 11,
+            },
+            Rights::LOOKUP,
+        );
+        let context = CallContext::x86_64(
+            2,
+            [0; 6],
+            TaskContext {
+                host: 13,
+                virtual_id: 17,
+                generation: 19,
+            },
+            InstanceContext {
+                identity: 2,
+                lifetime: 3,
+                root_generation: 5,
+            },
+            AuthorityContext {
+                root: capability,
+                cwd: Capability {
+                    kind: CapabilityKind::WorkingDirectory,
+                    ..capability
+                },
+                descriptor_table: Capability {
+                    kind: CapabilityKind::DescriptorTable,
+                    ..capability
+                },
+                cwd_generation: 5,
+                descriptor_generation: 5,
+            },
+            ContractAuthorization::Mediate,
+        );
+        assert_eq!(filesystem_operation(&context).unwrap().name, "open");
+
+        let mut denied = context;
+        denied.contract = ContractAuthorization::Deny(1);
+        assert_eq!(filesystem_operation(&denied), Err(ENOSYS));
+
+        let mut unknown_abi = context;
+        unknown_abi.abi = 0;
+        assert_eq!(filesystem_operation(&unknown_abi), Err(ENOSYS));
+
+        let mut wrong_owner = context;
+        wrong_owner.syscall = 0;
+        assert_eq!(filesystem_operation(&wrong_owner), Err(ENOSYS));
+
+        let mut unknown = context;
+        unknown.syscall = u64::MAX;
+        assert_eq!(filesystem_operation(&unknown), Err(ENOSYS));
+
+        assert!(filesystem_hook_authorized(&context, true));
+        assert!(!filesystem_hook_authorized(&context, false));
+        assert!(!filesystem_hook_authorized(&denied, true));
+        assert!(!filesystem_hook_authorized(&unknown_abi, true));
+        assert!(!filesystem_hook_authorized(&wrong_owner, true));
+        assert!(!filesystem_hook_authorized(&unknown, true));
+
+        let mut stale = context;
+        stale.authority.descriptor_generation += 1;
+        assert!(!filesystem_hook_authorized(&stale, true));
+    }
+
+    #[test]
+    fn rights_contains_requires_every_requested_bit() {
+        let all = [
+            Rights::LOOKUP,
+            Rights::READ,
+            Rights::WRITE,
+            Rights::CREATE,
+            Rights::METADATA,
+            Rights::EXECUTE,
+        ];
+        for required in all {
+            assert!(required.contains(required));
+            for other in all {
+                let joined = required.union(other);
+                assert!(joined.contains(required));
+                assert!(joined.contains(other));
+            }
+        }
+        let need = Rights::READ.union(Rights::WRITE);
+        assert!(need.contains(Rights::READ.union(Rights::WRITE)));
+        assert!(!need.contains(Rights::READ.union(Rights::EXECUTE)));
+        assert!(!Rights::READ.contains(need));
+        assert!(!Rights(0).contains(Rights::LOOKUP));
+    }
+}
