+
+/usr/local/bin/ginux unlock "$name"
+test "$(awk -F '\\t' '$1 == "contract" && $2 == "unlocked" { count++ } END { print count + 0 }' "$directory/deployment.state")" -eq 1
+/usr/local/bin/ginux status "$name" | grep -Fqx 'contract: unlocked'
+/usr/local/bin/ginux list | grep -Eq '^maintenance[[:space:]]+stopped[[:space:]]+unlocked[[:space:]]+-$'
+test "$config_before" = "$(sha256sum "$directory/config.toml" | awk '{ print $1 }')"
+grep -Fqx 'allow = ["*"]' "$directory/runtime.toml"
+grep -Fqx 'deny = []' "$directory/runtime.toml"
+grep -Fqx 'write = ["/"]' "$directory/runtime.toml"
+grep -Fqx 'create = ["/"]' "$directory/runtime.toml"
+grep -Fqx 'setuid = ["/"]' "$directory/runtime.toml"
+grep -Fqx 'proc_write = []' "$directory/runtime.toml"
+grep -Fqx 'sys_write = []' "$directory/runtime.toml"
+
+set +e
+start_output=$(/usr/local/bin/ginux start "$name" 2>&1)
+start_status=$?
+set -e
+printf '%s\n' "$start_output" |
+    grep -Fqx 'WARNING: maintenance is starting with its contract unlocked for maintenance.'
+if test "$start_status" -eq 0; then
+    /usr/local/bin/ginux stop "$name" >/dev/null
+fi
+
+/usr/local/bin/ginux unlock "$name" |
+    grep -Fqx 'Instance "maintenance" contract is already unlocked.'
+
+sleep 60 &
+fake_pid=$!
+fake_start=$(awk '{ print $22 }' "/proc/$fake_pid/stat")
+mkdir -p "$runtime_directory"
+printf '%s %s\n' "$fake_pid" "$fake_start" >"$runtime_directory/supervisor.pid"
+if /usr/local/bin/ginux lock "$name" >/dev/null 2>&1; then
+    printf '%s\n' 'running instance contract lock was incorrectly changed' >&2
+    exit 1
+fi
+test "$(awk -F '\\t' '$1 == "contract" && $2 == "unlocked" { count++ } END { print count + 0 }' "$directory/deployment.state")" -eq 1
+rm -f "$runtime_directory/supervisor.pid"
+kill "$fake_pid"
+wait "$fake_pid" 2>/dev/null || true
+fake_pid=
+
+/usr/local/bin/ginux lock "$name"
+test "$(awk -F '\\t' '$1 == "contract" && $2 == "locked" { count++ } END { print count + 0 }' "$directory/deployment.state")" -eq 1
+cmp /var/tmp/ginux-gate125-locked.toml "$directory/runtime.toml"
+test "$config_before" = "$(sha256sum "$directory/config.toml" | awk '{ print $1 }')"
+
+# A pre-Gate-12.5 deployment file has no contract record and must fail closed.
+sed -i '/^contract/d' "$directory/deployment.state"
+/usr/local/bin/ginux status "$name" | grep -Fqx 'contract: locked'
+
+printf 'unknown\tvalue\n' >>"$directory/deployment.state"
+malformed_before=$(sha256sum "$directory/deployment.state" | awk '{ print $1 }')
+if /usr/local/bin/ginux unlock "$name" >/dev/null 2>&1; then
+    printf '%s\n' 'malformed deployment state was incorrectly unlocked' >&2
+    exit 1
+fi
+test "$malformed_before" = "$(sha256sum "$directory/deployment.state" | awk '{ print $1 }')"
+
+printf '%s\n' 'GATE12.5_LOCK: PASS (default locked, persistent maintenance mode, atomic relock, running and malformed rejection)'
diff --git a/scripts/gate15-report.awk b/scripts/gate15-report.awk
new file mode 100644
index 0000000..8994a29
--- /dev/null
+++ b/scripts/gate15-report.awk
@@ -0,0 +1,66 @@
+BEGIN {
+    FS = "\t"
+    workload_count = split(workload_list, workloads, ",")
+    allocation_count = split(allocation_list, allocations, ",")
+}
+
+NR == 1 { next }
+
+{
+    key = $1 SUBSEP $2 SUBSEP $3 SUBSEP $4 SUBSEP $5
+    count[key]++
+    sum[key] += $9 + 0
+    sumsq[key] += ($9 + 0) ^ 2
+    direction[$3 SUBSEP $4 SUBSEP $5] = $7
+    unit[$3 SUBSEP $4 SUBSEP $5] = $8
+}
+
+function mean(key) {
+    return sum[key] / count[key]
+}
+
+function sd(key,    variance) {
+    if (count[key] < 2) return 0
+    variance = (sumsq[key] - (sum[key] ^ 2 / count[key])) / (count[key] - 1)
+    if (variance < 0) variance = 0
+    return sqrt(variance)
+}
+
+function ratio(control, measured, direction_value) {
+    if (direction_value == "higher") return measured / control
+    return control / measured
+}
+
+function print_mode_table(mode, label,    w, a, t, workload, vcpus, threads, row, native_key, measured_key, native_mean, measured_mean, performance, difference) {
+    print "### " label
+    print ""
+    print "| Workload | vCPUs | Threads | Native mean | Native SD | Ginux mean | Ginux SD | Performance | Difference | Samples (native/Ginux) |"
+    print "|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|"
+    for (w = 1; w <= workload_count; w++) {
+        workload = workloads[w]
+        for (a = 1; a <= allocation_count; a++) {
+            vcpus = allocations[a]
+            for (t = 1; t <= 2; t++) {
+                threads = (t == 1 ? 1 : vcpus)
+                if (t == 2 && vcpus == 1) continue
+                row = workload SUBSEP vcpus SUBSEP threads
+                native_key = "native" SUBSEP mode SUBSEP row
+                measured_key = mode SUBSEP mode SUBSEP row
+                native_mean = mean(native_key)
+                measured_mean = mean(measured_key)
+                performance = ratio(native_mean, measured_mean, direction[row])
+                difference = (performance - 1) * 100
+                printf "| %s | %d | %d | %.3f %s | %.3f | %.3f %s | %.3f | %.4fx | %+.2f%% | %d/%d |\n", \
+                    workload, vcpus, threads, native_mean, unit[row], sd(native_key), \
+                    measured_mean, unit[row], sd(measured_key), performance, difference, \
+                    count[native_key], count[measured_key]
+            }
+        }
+    }
+    print ""
+}
+
+END {
+    print_mode_table("selective", "Selective")
+    print_mode_table("paranoid", "Paranoid")
+}
diff --git a/scripts/gate15-report.sh b/scripts/gate15-report.sh
new file mode 100755
index 0000000..4583a9f
--- /dev/null
+++ b/scripts/gate15-report.sh
@@ -0,0 +1,49 @@
+#!/bin/sh
+set -eu
+
+output_dir=${1:-build/gate15}
+config_dir=${2:-benchmarks/gate15}
+results=$output_dir/results.tsv
+selective_metadata=$output_dir/selective/metadata.txt
+paranoid_metadata=$output_dir/paranoid/metadata.txt
+report=$output_dir/report.md
+graph=$output_dir/performance.svg
+
+./scripts/validate-gate15-results.sh "$results" "$selective_metadata" \
+    "$paranoid_metadata" "$config_dir" >/dev/null
+
+config_value() {
+    awk -F= -v key="$2" '$1 == key { print substr($0, index($0, "=") + 1); found=1 } END { if (!found) exit 1 }' "$1"
+}
+workloads=$(config_value "$config_dir/suite.conf" workloads)
+allocations=$(config_value "$config_dir/suite.conf" vcpus)
+
+awk -v workload_list="$workloads" -v allocation_list="$allocations" \
+    -f scripts/gate15-svg.awk "$results" >"$graph"
+
+{
+    printf '%s\n\n' '# Gate 15 dispatch-mode performance matrix'
+    printf '%s\n\n' 'Native Rocky is the no-Ginux control. Selective and paranoid values are normalized to the native samples paired with that mode; higher ratios are always better.'
+    printf '%s\n\n' '![Native-relative performance](performance.svg)'
+    printf '%s\n\n' '## Results'
+    awk -v workload_list="$workloads" -v allocation_list="$allocations" \
+        -f scripts/gate15-report.awk "$results"
+    # shellcheck disable=SC2016
+    printf '\n%s\n\n' 'Standard deviation is shown in each workload unit. Raw samples remain in `results.tsv`; each mode retains its own raw transcripts and metadata directory.'
+    printf '%s\n\n' '## Security and interpretation'
+    printf '%s\n' \
+        '- **Native** executes without Ginux and is not an instance mode.' \
+        '- **Selective** permits only contract-allowed, independently classified direct-safe syscalls to execute directly; all other operations remain controlled by Ginux.' \
+        '- **Paranoid** routes every syscall through the Ginux userspace decision path before completion.'
+    printf '\n'
+    printf '%s\n\n' 'Do not compare modes as if they provide identical enforcement. These workloads characterize fixed and workload-sensitive overhead; they do not establish universal application performance.'
+    printf '%s\n\n' '## Reproduction metadata'
+    printf '%s\n' '### Selective pair' '```text'
+    cat "$selective_metadata"
+    printf '%s\n\n' '```'
+    printf '%s\n' '### Paranoid pair' '```text'
+    cat "$paranoid_metadata"
+    printf '%s\n' '```'
+} >"$report"
+
+printf 'Gate 15 report: %s\nGate 15 graph: %s\n' "$report" "$graph"
