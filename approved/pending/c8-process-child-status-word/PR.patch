@@ -0,0 +1,2788 @@
+#![no_std]
+
+use core::fmt;
+
+pub const CATALOG_VERSION: u32 = 2;
+pub const MAX_OPERATIONS: usize = 192;
+pub const DIGEST_HEX_BYTES: usize = 64;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum AuditDisposition {
+    Emit,
+    Drop,
+    DropAndReport(u64),
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct AuditBudget {
+    limit: u64,
+    emitted: u64,
+    dropped: u64,
+}
+
+impl AuditBudget {
+    pub const fn new(limit: u64) -> Self {
+        Self {
+            limit,
+            emitted: 0,
+            dropped: 0,
+        }
+    }
+
+    pub fn admit(&mut self) -> AuditDisposition {
+        if self.emitted < self.limit {
+            self.emitted += 1;
+            return AuditDisposition::Emit;
+        }
+        self.dropped = self.dropped.saturating_add(1);
+        if self.dropped.is_power_of_two() {
+            AuditDisposition::DropAndReport(self.dropped)
+        } else {
+            AuditDisposition::Drop
+        }
+    }
+
+    pub const fn emitted(self) -> u64 {
+        self.emitted
+    }
+
+    pub const fn dropped(self) -> u64 {
+        self.dropped
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Action {
+    Emulate,
+    Mediate,
+    Deny(i32),
+}
+
+impl Action {
+    pub const fn name(self) -> &'static str {
+        match self {
+            Self::Emulate => "emulate",
+            Self::Mediate => "mediate",
+            Self::Deny(_) => "deny",
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Status {
+    Complete,
+    Partial,
+    Denied,
+    Planned,
+    OutOfScope,
+}
+
+impl Status {
+    pub const fn name(self) -> &'static str {
+        match self {
+            Self::Complete => "complete",
+            Self::Partial => "partial",
+            Self::Denied => "denied",
+            Self::Planned => "planned",
+            Self::OutOfScope => "out-of-scope",
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Kind {
+    Syscall,
+    Ioctl,
+    Network,
+    Device,
+    Filesystem,
+    Proc,
+    Sys,
+    Cgroup,
+    Credential,
+    Signal,
+    Time,
+    Memory,
+}
+
+impl Kind {
+    pub const fn name(self) -> &'static str {
+        match self {
+            Self::Syscall => "syscall",
+            Self::Ioctl => "ioctl",
+            Self::Network => "network",
+            Self::Device => "device",
+            Self::Filesystem => "filesystem",
+            Self::Proc => "proc",
+            Self::Sys => "sys",
+            Self::Cgroup => "cgroup",
+            Self::Credential => "credential",
+            Self::Signal => "signal",
+            Self::Time => "time",
+            Self::Memory => "memory",
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct Operation {
+    pub id: &'static str,
+    pub kind: Kind,
+    pub abi_number: Option<u64>,
+    pub status: Status,
+    pub action: Action,
+    pub direct_safe: bool,
+    pub constraint: &'static str,
+    pub evidence: &'static str,
+    pub limitation: &'static str,
+}
+
+macro_rules! syscall {
+    ($name:literal, $number:literal, $status:ident, $action:expr, $constraint:literal, $evidence:literal) => {
+        Operation {
+            id: concat!("syscall.", $name),
+            kind: Kind::Syscall,
+            abi_number: Some($number),
+            status: Status::$status,
+            action: $action,
+            direct_safe: false,
+            constraint: $constraint,
+            evidence: $evidence,
+            limitation: "x86-64 Linux ABI only",
+        }
+    };
+}
+
+macro_rules! direct_syscall {
+    ($name:literal, $number:literal, $status:ident, $action:expr, $constraint:literal, $evidence:literal) => {
+        Operation {
+            id: concat!("syscall.", $name),
+            kind: Kind::Syscall,
+            abi_number: Some($number),
+            status: Status::$status,
+            action: $action,
+            direct_safe: true,
+            constraint: $constraint,
+            evidence: $evidence,
+            limitation: "x86-64 Linux ABI only",
+        }
+    };
+}
+
+macro_rules! operation {
+    ($id:literal, $kind:ident, $status:ident, $action:expr, $constraint:literal, $evidence:literal, $limitation:literal) => {
+        Operation {
+            id: $id,
+            kind: Kind::$kind,
+            abi_number: None,
+            status: Status::$status,
+            action: $action,
+            direct_safe: false,
+            constraint: $constraint,
+            evidence: $evidence,
+            limitation: $limitation,
+        }
+    };
+}
