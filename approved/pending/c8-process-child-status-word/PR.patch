diff --git a/scripts/prepare-rocky-host.sh b/scripts/prepare-rocky-host.sh
new file mode 100755
index 0000000..c6a131e
--- /dev/null
+++ b/scripts/prepare-rocky-host.sh
@@ -0,0 +1,65 @@
+#!/bin/sh
+set -eu
+
+. ./config/rocky-host-image.env
+. ./scripts/rocky-host-common.sh
+
+./scripts/verify-rocky-host.sh
+printf '%s\n' 'Rocky host: preparing cloud-init seed'
+mkdir -p build/cache/rocky build/rocky-seed
+
+if [ ! -f "$ROCKY_KEY" ]; then
+    ssh-keygen -q -t ed25519 -N '' -C ginux-gate1 -f "$ROCKY_KEY"
+fi
+public_key=$(cat "$ROCKY_KEY.pub")
+
+cat > build/rocky-seed/meta-data <<EOF
+instance-id: ginux-gate1
+local-hostname: ginux-rocky
+EOF
+
+cat > build/rocky-seed/user-data <<EOF
+#cloud-config
+users:
+  - default
+  - name: ginux
+    gecos: Ginux Gate 1
+    groups: [wheel]
+    shell: /bin/bash
+    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
+    ssh_authorized_keys:
+      - $public_key
+ssh_pwauth: false
+disable_root: true
+runcmd:
+  - systemctl enable --now sshd
+EOF
+
+rm -f build/rocky-seed.iso build/rocky-seed.iso.cdr
+case "$(uname -s)" in
+    Darwin)
+        hdiutil makehybrid \
+            -quiet \
+            -iso \
+            -joliet \
+            -default-volume-name cidata \
+            -o build/rocky-seed.iso \
+            build/rocky-seed
+
+        if [ -f build/rocky-seed.iso.cdr ] && [ ! -f build/rocky-seed.iso ]; then
+            mv build/rocky-seed.iso.cdr build/rocky-seed.iso
+        fi
+        ;;
+    *)
+        if command -v xorriso >/dev/null 2>&1; then
+            xorriso -as mkisofs -quiet -V cidata -J -r -o build/rocky-seed.iso build/rocky-seed
+        elif command -v genisoimage >/dev/null 2>&1; then
+            genisoimage -quiet -V cidata -J -r -o build/rocky-seed.iso build/rocky-seed
+        else
+            printf '%s\n' 'no ISO 9660 tool found; install xorriso or genisoimage' >&2
+            exit 1
+        fi
+        ;;
+esac
+test -f build/rocky-seed.iso
+printf '%s\n' 'Rocky host: cloud-init seed ready'
diff --git a/scripts/prepare-rocky-instance.sh b/scripts/prepare-rocky-instance.sh
new file mode 100755
index 0000000..a22cdac
--- /dev/null
+++ b/scripts/prepare-rocky-instance.sh
@@ -0,0 +1,77 @@
+#!/bin/sh
+set -eu
+
+. ./scripts/rocky-instance-common.sh
+
+./scripts/verify-rocky-host.sh
+if ! docker image inspect "$ROCKY_INSTANCE_HELPER_IMAGE" >/dev/null 2>&1; then
+    printf '%s\n' 'missing pinned image helper; run make image-helper-fetch' >&2
+    exit 2
+fi
+
+# The cache is reused only if the rootfs and manifest still match the hashes
+# recorded when they were prepared; otherwise prepare again from the source.
+cached_artifact_matches() {
+    if grep -Fqx "$1=$(shasum -a 256 "$2" | awk '{print $1}')" "$ROCKY_INSTANCE_METADATA_PATH"; then
+        return 0
+    fi
+    printf 'cached %s does not match %s in %s; preparing again\n' \
+        "$2" "$1" "$ROCKY_INSTANCE_METADATA_PATH" >&2
+    return 1
+}
+
+source_sha=$(shasum -a 256 "$ROCKY_SOURCE_IMAGE" | awk '{print $1}')
+if [ "${GINUX_IMAGE_FORCE:-0}" != 1 ] &&
+    [ -f "$ROCKY_INSTANCE_ROOTFS_PATH" ] &&
+    [ -f "$ROCKY_INSTANCE_MANIFEST_PATH" ] &&
+    [ -f "$ROCKY_INSTANCE_METADATA_PATH" ] &&
+    grep -Fqx 'GINUX_ROOTFS_MANIFEST_VERSION=1' "$ROCKY_INSTANCE_MANIFEST_PATH" &&
+    grep -Fqx "SOURCE_SHA256=$source_sha" "$ROCKY_INSTANCE_METADATA_PATH" &&
+    grep -Fqx "HELPER_IMAGE=$ROCKY_INSTANCE_HELPER_IMAGE" "$ROCKY_INSTANCE_METADATA_PATH" &&
+    cached_artifact_matches MANIFEST_SHA256 "$ROCKY_INSTANCE_MANIFEST_PATH" &&
+    cached_artifact_matches ROOTFS_SHA256 "$ROCKY_INSTANCE_ROOTFS_PATH"; then
+    printf 'Rocky instance userspace already prepared: %s\n' "$ROCKY_INSTANCE_ROOTFS_PATH"
+    exit 0
+fi
+
+mkdir -p "$ROCKY_INSTANCE_CACHE_DIR" "$ROCKY_INSTANCE_WORK_DIR"
+raw_image=$ROCKY_INSTANCE_WORK_DIR/source.raw
+rootfs_tmp=$ROCKY_INSTANCE_ROOTFS_PATH.tmp
+manifest_tmp=$ROCKY_INSTANCE_MANIFEST_PATH.tmp
+metadata_tmp=$ROCKY_INSTANCE_METADATA_PATH.tmp
+
+cleanup() {
+    rm -f "$raw_image" "$rootfs_tmp" "$manifest_tmp" "$metadata_tmp"
+}
+trap cleanup EXIT HUP INT TERM
+
+printf '%s\n' 'Converting verified QCOW2 to a temporary sparse raw disk...'
+qemu-img convert -f qcow2 -O raw "$ROCKY_SOURCE_IMAGE" "$raw_image"
+
+repository=$(pwd -P)
+docker run --rm --privileged --network none \
+    --mount "type=bind,source=$repository,target=/workspace" \
+    "$ROCKY_INSTANCE_HELPER_IMAGE" \
+    /workspace/scripts/extract-rocky-instance.sh \
+    /workspace/$raw_image \
+    /workspace/$rootfs_tmp \
+    /workspace/$manifest_tmp
+
+rootfs_sha=$(shasum -a 256 "$rootfs_tmp" | awk '{print $1}')
+manifest_sha=$(shasum -a 256 "$manifest_tmp" | awk '{print $1}')
+cat > "$metadata_tmp" <<EOF
+FORMAT_VERSION=1
+SOURCE_IMAGE=$ROCKY_IMAGE_NAME
+SOURCE_SHA256=$source_sha
+HELPER_IMAGE=$ROCKY_INSTANCE_HELPER_IMAGE
+ROOTFS_SHA256=$rootfs_sha
+MANIFEST_SHA256=$manifest_sha
+EOF
+
+mv "$rootfs_tmp" "$ROCKY_INSTANCE_ROOTFS_PATH"
+mv "$manifest_tmp" "$ROCKY_INSTANCE_MANIFEST_PATH"
+mv "$metadata_tmp" "$ROCKY_INSTANCE_METADATA_PATH"
+rm -f "$raw_image"
+trap - EXIT HUP INT TERM
+printf 'Prepared Rocky instance userspace: %s\n' "$ROCKY_INSTANCE_ROOTFS_PATH"
+printf 'Content manifest: %s\n' "$ROCKY_INSTANCE_MANIFEST_PATH"
diff --git a/scripts/prepare-rocky-oci-rootfs.sh b/scripts/prepare-rocky-oci-rootfs.sh
new file mode 100755
index 0000000..5839247
--- /dev/null
+++ b/scripts/prepare-rocky-oci-rootfs.sh
@@ -0,0 +1,105 @@
+#!/bin/sh
+set -eu
+
+script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
+. "$script_dir/oci-common.sh"
+"$script_dir/verify-rocky-oci.sh"
+
+for command in gzip jq tar; do
+    command -v "$command" >/dev/null 2>&1 || {
+        printf 'missing required command: %s\n' "$command" >&2
+        exit 1
+    }
+done
+
+mkdir -p "$GINUX_OCI_WORK_DIR" "$GINUX_OCI_CACHE_DIR"
+manifest_blob=$(oci_blob_path "$GINUX_OCI_MANIFEST_DIGEST")
+config_digest=$(jq -er '.config.digest' "$manifest_blob")
+config_blob=$(oci_blob_path "$config_digest")
+layer_count=$(jq '.layers | length' "$manifest_blob")
+diff_count=$(jq '.rootfs.diff_ids | length' "$config_blob")
+test "$layer_count" -eq "$diff_count"
+
+rootfs=$GINUX_OCI_CACHE_DIR/$GINUX_OCI_ROOTFS_LAYER
+identity=$GINUX_OCI_CACHE_DIR/$GINUX_OCI_ROOTFS_IDENTITY
+merged=$GINUX_OCI_WORK_DIR/merged-root
+rootfs_tmp=$GINUX_OCI_WORK_DIR/rootfs.tar.partial
+identity_tmp=$GINUX_OCI_WORK_DIR/rootfs.env.partial
+layer_list=$GINUX_OCI_WORK_DIR/layers.tsv
+
+cleanup() {
+    rm -rf "$merged"
+    rm -f "$rootfs_tmp" "$identity_tmp" "$layer_list" \
+        "$layer_list.media" "$layer_list.diff" "$GINUX_OCI_WORK_DIR"/layer-*.tar
+}
+trap cleanup 0 HUP INT TERM
+rm -rf "$merged"
+mkdir -p "$merged"
+
+jq -r '.layers[] | [.mediaType, .digest] | @tsv' "$manifest_blob" >"$layer_list.media"
+jq -r '.rootfs.diff_ids[]' "$config_blob" >"$layer_list.diff"
+paste "$layer_list.media" "$layer_list.diff" >"$layer_list"
+
+layer_number=0
+tab=$(printf '\t')
+while IFS="$tab" read -r layer_media_type layer_digest diff_id; do
+    case "$layer_media_type" in
+        application/vnd.oci.image.layer.v1.tar+gzip|application/vnd.docker.image.rootfs.diff.tar.gzip) ;;
+        *) printf 'unsupported image layer media type: %s\n' "$layer_media_type" >&2; exit 1 ;;
+    esac
+    layer_blob=$(oci_blob_path "$layer_digest")
+    layer_tar=$GINUX_OCI_WORK_DIR/layer-$layer_number.tar
+    gzip -dc "$layer_blob" >"$layer_tar"
+    actual_diff_id=sha256:$(oci_sha256_file "$layer_tar")
+    if test "$actual_diff_id" != "$diff_id"; then
+        printf 'uncompressed OCI layer mismatch: expected %s, got %s\n' \
+            "$diff_id" "$actual_diff_id" >&2
+        exit 1
+    fi
+
+    tar -tf "$layer_tar" | while IFS= read -r entry; do
+        normalized=${entry#./}
+        case "/$normalized/" in
+            *'/../'*|*'/./'*|//* )
+                printf 'unsafe OCI layer path: %s\n' "$entry" >&2
+                exit 1
+                ;;
+        esac
+        base=${normalized##*/}
+        parent=${normalized%/*}
+        test "$parent" != "$normalized" || parent=.
+        case "$base" in
+            .wh..wh..opq)
+                if test -d "$merged/$parent"; then
+                    find "$merged/$parent" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
+                fi
+                ;;
+            .wh.*)
+                target=${base#.wh.}
+                rm -rf -- "$merged/$parent/$target"
+                ;;
+        esac
+    done
+    tar --numeric-owner --same-owner --exclude='.wh.*' --exclude='*/.wh.*' \
+        -xf "$layer_tar" -C "$merged"
+    layer_number=$((layer_number + 1))
+done <"$layer_list"
+test "$layer_number" -eq "$layer_count"
+
+tar --numeric-owner -cf "$rootfs_tmp" -C "$merged" .
+mv "$rootfs_tmp" "$rootfs"
+rootfs_sha=$(oci_sha256_file "$rootfs")
+cat >"$identity_tmp" <<EOF
+FORMAT_VERSION=1
+OCI_INDEX_DIGEST=$GINUX_OCI_INDEX_DIGEST
+OCI_MANIFEST_DIGEST=$GINUX_OCI_MANIFEST_DIGEST
+OCI_CONFIG_DIGEST=$config_digest
+OCI_LAYER_COUNT=$layer_count
+ROOTFS_SHA256=$rootfs_sha
+EOF
+mv "$identity_tmp" "$identity"
+trap - 0 HUP INT TERM
+cleanup
+if ! oci_human_output; then
+    printf 'OCI_PREPARE: rootfs=%s layers=%s whiteouts=applied\n' "$rootfs" "$layer_count"
+fi
diff --git a/scripts/prepare-rocky-oci.sh b/scripts/prepare-rocky-oci.sh
new file mode 100755
index 0000000..240ae29
--- /dev/null
+++ b/scripts/prepare-rocky-oci.sh
@@ -0,0 +1,94 @@
+#!/bin/sh
+set -eu
+
+. "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)/oci-common.sh"
+
+script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
+"$script_dir/verify-rocky-oci.sh"
+for command in gzip jq paste; do
+    command -v "$command" >/dev/null 2>&1 || {
+        printf 'missing required command: %s\n' "$command" >&2
+        exit 1
+    }
+done
+
+mkdir -p "$GINUX_OCI_WORK_DIR"
+manifest_blob=$(oci_blob_path "$GINUX_OCI_MANIFEST_DIGEST")
+layer_count=$(jq '.layers | length' "$manifest_blob")
+diff_count=$(config_digest=$(jq -er '.config.digest' "$manifest_blob") &&
+    config_blob=$(oci_blob_path "$config_digest") && jq '.rootfs.diff_ids | length' "$config_blob")
+test "$layer_count" -eq "$diff_count"
+config_digest=$(jq -er '.config.digest' "$manifest_blob")
+config_blob=$(oci_blob_path "$config_digest")
+
+rootfs=$GINUX_OCI_CACHE_DIR/$GINUX_OCI_ROOTFS_LAYER
+index=$GINUX_OCI_CACHE_DIR/$GINUX_OCI_ROOTFS_INDEX
+identity=$GINUX_OCI_CACHE_DIR/$GINUX_OCI_ROOTFS_IDENTITY
+rootfs_tmp=$GINUX_OCI_WORK_DIR/rootfs.tar.partial
+index_tmp=$GINUX_OCI_WORK_DIR/rootfs.index.partial
+identity_tmp=$GINUX_OCI_WORK_DIR/rootfs.env.partial
+layer_list=$GINUX_OCI_WORK_DIR/layers.tsv
+
+cleanup() {
+    rm -f "$rootfs_tmp" "$index_tmp" "$identity_tmp" "$layer_list" \
+        "$layer_list.media" "$layer_list.diff" "$GINUX_OCI_WORK_DIR"/*.partial
+}
+trap cleanup 0 HUP INT TERM
+
+jq -r '.layers[] | [.mediaType, .digest] | @tsv' "$manifest_blob" > "$layer_list.media"
+jq -r '.rootfs.diff_ids[]' "$config_blob" > "$layer_list.diff"
+paste "$layer_list.media" "$layer_list.diff" > "$layer_list"
+rm -f "$layer_list.media" "$layer_list.diff"
+
+set --
+layer_number=0
+tab=$(printf '\t')
+while IFS="$tab" read -r layer_media_type layer_digest diff_id; do
+    case "$layer_media_type" in
+        application/vnd.oci.image.layer.v1.tar+gzip|application/vnd.docker.image.rootfs.diff.tar.gzip) ;;
+        *) printf 'unsupported image layer media type: %s\n' "$layer_media_type" >&2; exit 1 ;;
+    esac
+    layer_blob=$(oci_blob_path "$layer_digest")
+    layer_tar=$GINUX_OCI_WORK_DIR/layer-$layer_number.tar
+    layer_tmp=$layer_tar.partial
+    gzip -dc "$layer_blob" > "$layer_tmp"
+    actual_diff_id=sha256:$(oci_sha256_file "$layer_tmp")
+    if [ "$actual_diff_id" != "$diff_id" ]; then
+        printf 'uncompressed OCI layer mismatch: expected %s, got %s\n' \
+            "$diff_id" "$actual_diff_id" >&2
+        exit 1
+    fi
+    mv "$layer_tmp" "$layer_tar"
+    set -- "$@" "$layer_tar"
+    layer_number=$((layer_number + 1))
+done < "$layer_list"
+test "$layer_number" -eq "$layer_count"
+
+if test -n "${GINUX_VFS_INDEX-}"; then
+    "$GINUX_VFS_INDEX" assemble "$rootfs_tmp" "$index_tmp" "$@"
+else
+    command -v cargo >/dev/null 2>&1 || {
+        printf '%s\n' 'missing required command: cargo' >&2
+        exit 1
+    }
+    cargo run -q -p ginux-vfs-index -- assemble "$rootfs_tmp" "$index_tmp" "$@"
+fi
+mv "$rootfs_tmp" "$rootfs"
+mv "$index_tmp" "$index"
+rootfs_sha=$(oci_sha256_file "$rootfs")
+index_sha=$(oci_sha256_file "$index")
+cat > "$identity_tmp" <<EOF
+FORMAT_VERSION=1
+OCI_INDEX_DIGEST=$GINUX_OCI_INDEX_DIGEST
+OCI_MANIFEST_DIGEST=$GINUX_OCI_MANIFEST_DIGEST
+OCI_CONFIG_DIGEST=$config_digest
+OCI_LAYER_COUNT=$layer_count
+ROOTFS_SHA256=$rootfs_sha
+INDEX_SHA256=$index_sha
+EOF
+mv "$identity_tmp" "$identity"
+trap - 0 HUP INT TERM
+
+if ! oci_human_output; then
+    printf 'OCI_PREPARE: rootfs=%s index=%s layers=%s\n' "$rootfs" "$index" "$layer_count"
+fi
diff --git a/scripts/prepare-rpm-sources.sh b/scripts/prepare-rpm-sources.sh
new file mode 100755
index 0000000..4c062e7
--- /dev/null
+++ b/scripts/prepare-rpm-sources.sh
@@ -0,0 +1,34 @@
+#!/bin/sh
+set -eu
+
+root=$(git rev-parse --show-toplevel)
+cd "$root"
+version=$(sed -n 's/^version = "\([^"]*\)"$/\1/p' crates/ginux-cli/Cargo.toml)
+test -n "$version" || { printf '%s\n' 'unable to determine Ginux version' >&2; exit 1; }
+test "$(git status --porcelain --untracked-files=no)" = '' || {
+    printf '%s\n' 'commit tracked changes before creating RPM sources' >&2
+    exit 1
+}
+
+output=$root/build/rpm
+sources=$output/SOURCES
+specs=$output/SPECS
+work=$output/work
+rm -rf "$output"
+install -d -m 755 "$sources" "$specs" "$work"
+
+git archive --format=tar --prefix="ginux-$version/" HEAD | gzip -n > \
+    "$sources/ginux-$version.tar.gz"
+cargo vendor --quiet --locked "$work/vendor" >/dev/null
+COPYFILE_DISABLE=1 tar --no-xattrs -C "$work" -cf - vendor | gzip -n > \
+    "$sources/ginux-$version-vendor.tar.gz"
+sed "s/@VERSION@/$version/g" packaging/rpm/ginux.spec.in > \
+    "$specs/ginux.spec"
+install -m 644 packaging/rpm/ginux.tmpfiles "$sources/ginux.tmpfiles"
+install -m 644 packaging/rpm/ginux.rpmlintrc "$sources/ginux.rpmlintrc"
+(
+    cd "$sources"
+    sha256sum * >SHA256SUMS
+)
+rm -rf "$work"
+printf 'RPM sources ready: %s\n' "$output"
