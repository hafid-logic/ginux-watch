+                                caller = regs.rsi
+                                replays += 1
+                        elif (regs.orig_rax == 101 and regs.rdi == 24 and regs.rsi == caller
+                                and replays == 1 and not interrupted):  # PTRACE_SYSCALL
+                            # The caller is held at the seccomp stop of the
+                            # replay; the signal stays pending into clone3.
