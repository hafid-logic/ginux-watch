+/* Freestanding x86-64 workload installed as /usr/bin/bash for `ginux native`
+ * supervision checks. `native` always runs bash with fixed arguments, so the
+ * scenario is read from /scenario in the instance root. */
+typedef unsigned long word;
+#ifdef CLONE_SNAPSHOT_COLLISION
+__attribute__((used, section(".ginux_clone_collision")))
+static const char occupied_snapshot_page[4096] = {0x5a};
+#endif
+
+static long call3(long number, word a, word b, word c)
+{
+    long result;
+    __asm__ volatile("syscall" : "=a"(result)
+                     : "a"(number), "D"(a), "S"(b), "d"(c)
+                     : "rcx", "r11", "memory");
+    return result;
+}
+
+static long call4(long number, word a, word b, word c, word d)
+{
+    long result;
+    register word r10 __asm__("r10") = d;
+    __asm__ volatile("syscall" : "=a"(result)
+                     : "a"(number), "D"(a), "S"(b), "d"(c), "r"(r10)
+                     : "rcx", "r11", "memory");
+    return result;
+}
+
+static long call5(long number, word a, word b, word c, word d, word e)
+{
+    long result;
+    register word r10 __asm__("r10") = d;
+    register word r8 __asm__("r8") = e;
+    __asm__ volatile("syscall" : "=a"(result)
+                     : "a"(number), "D"(a), "S"(b), "d"(c), "r"(r10), "r"(r8)
+                     : "rcx", "r11", "memory");
+    return result;
+}
+
+static long call6(long number, word a, word b, word c, word d, word e, word f)
+{
+    long result;
+    register word r10 __asm__("r10") = d;
+    register word r8 __asm__("r8") = e;
+    register word r9 __asm__("r9") = f;
+    __asm__ volatile("syscall" : "=a"(result)
+                     : "a"(number), "D"(a), "S"(b), "d"(c), "r"(r10), "r"(r8), "r"(r9)
+                     : "rcx", "r11", "memory");
+    return result;
+}
+
+static void print(const char *value)
+{
+    word count = 0;
+    while (value[count]) ++count;
+    call3(1, 1, (word)value, count);
+}
+
+/* One write per line: supervisor audit lines share stdout. */
+static void print_result(const char *label, long value)
+{
+    char line[96];
+    char digits[24];
+    word length = 0, at = sizeof digits;
+    word magnitude = value < 0 ? -(word)value : (word)value;
+    do digits[--at] = '0' + magnitude % 10; while (magnitude /= 10);
+    if (value < 0) digits[--at] = '-';
+    while (*label && length < sizeof line - 26) line[length++] = *label++;
+    while (at < sizeof digits) line[length++] = digits[at++];
+    line[length++] = '\n';
+    call3(1, 1, (word)line, length);
+}
+
+/* The supervisor answers TIOCGPGRP itself on a descriptor it tracks as the
+ * console; any other descriptor gets the host's answer (ENOTTY or EBADF). */
+static long tracked_as_console(long fd)
+{
+    int group = 0;
+    return call3(16, fd, 0x540f /* TIOCGPGRP */, (word)&group) == 0;
+}
+
+/* Run one call in a child, which owns a copy of the descriptor table, and
+ * report whether 240 is still the instance /dev/null and 241 the console,
+ * neither one close-on-exec. With probe labels the child also reports
+ * F_GETFD of the workload's descriptors 239, 242, 250, 300 and 301 after
+ * the call, and whether 250, a console copy, is still tracked as one. */
+static void protected_step(const char *label, const char *intact, const char *const *probes,
+                           long number, word a, word b, word c)
+{
+    static const long probed[5] = {239, 242, 250, 300, 301};
+    int status = 0;
+    long pid = call3(57, 0, 0, 0);
+    if (pid == 0) {
+        print_result(label, call3(number, a, b, c));
+        for (int at = 0; probes && at < 5; ++at)
+            print_result(probes[at], call3(72, probed[at], 1 /* F_GETFD */, 0));
+        if (probes) print_result(probes[5], tracked_as_console(250));
+        call3(231, call3(72, 240, 1, 0) == 0 && call3(72, 241, 1, 0) == 0
+                   && call3(1, 240, (word)"P\n", 2) == 2 && call3(1, 241, (word)"P\n", 2) == 2
+                   && tracked_as_console(241), 0, 0);
+    }
+    print_result(intact, pid > 0 && call4(61, pid, (word)&status, 0, 0) == pid
+                         && status == 256);
+}
+
+static volatile long yield_signals;
+
+static void yield_signal_handler(int signal)
+{
+    (void)signal;
+    ++yield_signals;
+}
+
+static int sigchld_pipe = -1;
+static volatile int sigchld_seen;
+
+static void sigchld_handler(int signal)
+{
+    (void)signal;
+    sigchld_seen = 1;
+    call3(1, sigchld_pipe, (word)"c", 1);
+}
+
+static volatile int restart_signals;
+
+static void restart_handler(int signal)
+{
+    (void)signal;
+    ++restart_signals;
+}
+
+static volatile int close_range_signals;
+static volatile long close_range_handler_250 = 1, close_range_handler_fd = -1;
+
+/* A handler for a signal sent during a close_range runs after the whole
+ * call: the workload's 250 is already closed, and a descriptor it opens
+ * stays open. */
+static void close_range_handler(int signal)
+{
+    (void)signal;
+    ++close_range_signals;
+    close_range_handler_250 = call3(72, 250, 1 /* F_GETFD */, 0);
+    close_range_handler_fd = call3(2, (word)"/scenario", 0, 0);
+}
+
+void sigchld_restorer(void);
+__asm__(".global sigchld_restorer\n"
+        "sigchld_restorer:\n"
+        "mov $15, %rax\n"
+        "syscall\n");
+
+long native_thread_trap(word flags, word stack);
+__asm__(".global native_thread_trap\n"
+        "native_thread_trap:\n"
+        "xor %edx, %edx\n"
+        "xor %r10d, %r10d\n"
+        "xor %r8d, %r8d\n"
+        "mov $56, %eax\n"
+        "syscall\n"
+        "test %rax, %rax\n"
+        "jnz 1f\n"
+        "int3\n"
+        "ud2\n"
+        "1: ret\n");
