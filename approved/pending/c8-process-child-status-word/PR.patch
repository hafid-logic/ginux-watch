index 0000000..40f1759
--- /dev/null
+++ b/crates/ginux-init/src/dispatch.rs
@@ -0,0 +1,124 @@
+//! Shared native-syscall dispatch wiring.
+//!
+//! Classifies syscall entries and applies hook validation before the shared
+//! balanced contract. The process-native loop uses `process_entry` directly
+//! and mediates supported process calls through its own event loop.
+
+use ginux_core::{
+    balanced_arguments_allowed, decide_balanced, Action, BalancedSurface, Decision, SYS_FORK,
+};
+use ginux_fs_policy::CallContext;
+
+use crate::supervisor::UserRegs;
+
+/// Lane a syscall number is routed to once its owning lane implements it.
+pub enum Lane {
+    Process,
+    Filesystem,
+    Channel,
+    Contract,
+}
+
+/// Route process entries to their hook and unclaimed entries to the contract.
+pub const fn classify(syscall: u64) -> Lane {
+    if crate::process_hooks::claims(syscall) {
+        Lane::Process
+    } else if crate::fs_hooks::claims(syscall) {
+        Lane::Filesystem
+    } else if crate::channel_hooks::claims(syscall) {
+        Lane::Channel
+    } else {
+        Lane::Contract
+    }
+}
+
+/// Outcome of dispatching one native entry.
+pub enum NativeDecision {
+    /// A lane hook claimed the entry; emulate it with this result.
+    Hooked { lane: Lane, result: i64 },
+    /// No hook claimed the entry; apply the shared contract decision.
+    Contract(Decision),
+}
+
+/// Dispatch one native supervision entry through lane hooks first, then the
+/// existing balanced-contract decision. `classify` is the single routing
+/// table: each lane arm gives its hook the first chance, and anything no
+/// hook claims falls through to `decide_balanced` byte-identically. The one
+/// exception is fork, which both callers (`launch` and `native`) deny
+/// although the balanced contract lists it in the task surface.
+pub fn decide_native(context: &CallContext) -> NativeDecision {
+    let syscall = context.syscall;
+    if let ginux_fs_policy::ContractAuthorization::Deny(errno) = context.contract {
+        return NativeDecision::Contract(Decision {
+            syscall,
+            action: Action::Deny(errno),
+        });
+    }
+    // Neither caller traces children, so a host fork would leave the child
+    // running unsupervised.
+    if syscall == SYS_FORK {
+        return NativeDecision::Contract(Decision {
+            syscall,
+            action: Action::Deny(38),
+        });
+    }
+    match classify(syscall) {
+        Lane::Process => match crate::process_hooks::claim(
+            syscall,
+            context.arguments[0],
+            context.arguments[1],
+            context.arguments[2],
+        ) {
+            Some(result) => NativeDecision::Hooked {
+                lane: Lane::Process,
+                result,
+            },
+            None => NativeDecision::Contract(decide_balanced(syscall)),
+        },
+        Lane::Filesystem => match crate::fs_hooks::claim(context, true) {
+            crate::fs_hooks::Claim::Denied(result) => NativeDecision::Hooked {
+                lane: Lane::Filesystem,
+                result,
+            },
+            crate::fs_hooks::Claim::Unclaimed => NativeDecision::Contract(decide_balanced(syscall)),
+        },
+        Lane::Channel => match crate::channel_hooks::claim(
+            syscall,
+            context.arguments[0],
+            context.arguments[1],
+            context.arguments[2],
+        ) {
+            Some(result) => NativeDecision::Hooked {
+                lane: Lane::Channel,
+                result,
+            },
+            None => NativeDecision::Contract(decide_balanced(syscall)),
+        },
+        Lane::Contract => NativeDecision::Contract(decide_balanced(syscall)),
+    }
+}
+
+/// Dispatch one process-supervision entry through the process-lane hook.
+/// `None` keeps the existing entry match in the supervision loop.
+pub fn process_entry(syscall: u64, rdi: u64, rsi: u64, rdx: u64) -> Option<i64> {
+    crate::process_hooks::claim(syscall, rdi, rsi, rdx)
+}
+
+pub fn native_arguments_allowed(syscall: u64, registers: &UserRegs) -> bool {
+    balanced_arguments_allowed(syscall, registers.rdi, registers.rsi, registers.rdx)
+}
+
+pub fn balanced_surface_name(surface: BalancedSurface) -> &'static [u8] {
+    match surface {
+        BalancedSurface::ImageRead => b"immutable-image result=pending",
+        BalancedSurface::Memory => b"memory result=pending",
+        BalancedSurface::Task => b"task result=pending",
+        BalancedSurface::Console => b"bootstrap-console result=pending",
+        BalancedSurface::Random => b"random result=pending",
+        BalancedSurface::InstanceWrite => b"disposable-instance-write result=pending",
+        BalancedSurface::Network => b"shared-network result=pending",
+        BalancedSurface::VirtualIdentity | BalancedSurface::Lifecycle | BalancedSurface::Denied => {
+            b"invalid result=denied"
+        }
+    }
+}
diff --git a/crates/ginux-init/src/fs_hooks.rs b/crates/ginux-init/src/fs_hooks.rs
new file mode 100644
index 0000000..8fb6536
--- /dev/null
+++ b/crates/ginux-init/src/fs_hooks.rs
@@ -0,0 +1,111 @@
+//! Native filesystem-lane dispatch hooks.
+//!
+//! Gate 31 supplies the complete immutable call context and operation
+//! inventory required before this lane can safely claim an operation. The
+//! lane still declines every call; operation-family gates enable it later.
+
+use ginux_fs_policy::CallContext;
+
+/// Lane membership by syscall number. Reserved for G06+.
+pub const fn claims(syscall: u64) -> bool {
+    let _ = syscall;
+    false
+}
+
+/// Result of asking the filesystem lane to own an entry.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Claim {
+    /// This syscall is not owned by the filesystem lane.
+    Unclaimed,
+    /// The lane owns the syscall but validation failed before any host effect.
+    Denied(i64),
+}
+
+const EPERM: i64 = 1;
+const ENOSYS: i64 = 38;
+
+fn evaluate(context: &CallContext, confinement_permits: bool, claimed: bool) -> Claim {
+    if !claimed {
+        return Claim::Unclaimed;
+    }
+    if !ginux_fs_policy::filesystem_hook_authorized(context, confinement_permits) {
+        return Claim::Denied(-EPERM);
+    }
+    // A future operation-family gate must replace this explicit denial with
+    // its handler. Ownership can never fall through to a legacy executor.
+    Claim::Denied(-ENOSYS)
+}
+
+/// Ask the filesystem lane to own an entry. Claimed operations always return
+/// either a handled result or an explicit denial; only genuinely unclaimed
+/// operations may fall through to the shared contract executor.
+pub fn claim(context: &CallContext, confinement_permits: bool) -> Claim {
+    evaluate(context, confinement_permits, claims(context.syscall))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use ginux_fs_policy::{
+        AuthorityContext, Capability, CapabilityKind, ContractAuthorization, InstanceContext,
+        ObjectId, Rights, TaskContext,
+    };
+
+    fn open_context() -> CallContext {
+        let root = Capability::new(
+            CapabilityKind::Root,
+            2,
+            3,
+            5,
+            ObjectId {
+                device: 7,
+                inode: 11,
+            },
+            Rights::LOOKUP,
+        );
+        CallContext::x86_64(
+            2,
+            [0; 6],
+            TaskContext {
+                host: 13,
+                virtual_id: 17,
+                generation: 19,
+            },
+            InstanceContext {
+                identity: 2,
+                lifetime: 3,
+                root_generation: 5,
+            },
+            AuthorityContext {
+                root,
+                cwd: Capability {
+                    kind: CapabilityKind::WorkingDirectory,
+                    ..root
+                },
+                descriptor_table: Capability {
+                    kind: CapabilityKind::DescriptorTable,
+                    ..root
+                },
+                cwd_generation: 5,
+                descriptor_generation: 5,
+            },
+            ContractAuthorization::Mediate,
+        )
+    }
+
+    #[test]
+    fn claimed_operation_never_falls_through() {
+        let context = open_context();
+        assert_eq!(evaluate(&context, true, true), Claim::Denied(-ENOSYS));
+
+        let mut stale = context;
+        stale.authority.descriptor_generation += 1;
+        assert_eq!(evaluate(&stale, true, true), Claim::Denied(-EPERM));
+        assert_eq!(evaluate(&context, false, true), Claim::Denied(-EPERM));
+    }
+
+    #[test]
+    fn only_unowned_operation_is_unclaimed() {
+        assert_eq!(evaluate(&open_context(), true, false), Claim::Unclaimed);
+    }
+}
diff --git a/crates/ginux-init/src/launch.rs b/crates/ginux-init/src/launch.rs
