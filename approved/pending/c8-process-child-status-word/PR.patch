+    entries: &mut [NativeVirtualKernelFd; NATIVE_VIRTUAL_KERNEL_FD_LIMIT],
+    owner: usize,
+    fd: i64,
+) -> bool {
+    let Some(entry) = native_virtual_kernel_fd_mut(entries, owner, fd) else {
+        return false;
+    };
+    *entry = EMPTY_VIRTUAL_KERNEL_FD;
+    true
+}
