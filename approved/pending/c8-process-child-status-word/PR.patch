+status=$(rocky_ssh 'set +e; /var/tmp/ginux native /var/tmp/gate9-failure.toml /var/lib/ginux/instances/gate9-failure/root >/var/tmp/gate9-failure.log 2>&1; result=$?; printf "%s\n" "$result"')
