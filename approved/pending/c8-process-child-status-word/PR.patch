+        let fd = registry.open(1, b"null").unwrap();
+        assert_eq!(fd, 0x4000_0000);
+        assert_eq!(registry.write(1, fd, b"discard"), Ok(7));
+        assert_eq!(
+            registry.write(2, fd, b"escape"),
+            Err(DeviceError::InvalidDescriptor)
+        );
+    }
