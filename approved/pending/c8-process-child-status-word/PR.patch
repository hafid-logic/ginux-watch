+    exit 1
+fi
+grep -Fqx 'GINUX_INSTANCE: failed reason=invalid VFS index' "$failure_log"
+grep -Fqx 'GINUX_INSTANCE: cleanup resources=false managed-task=false' "$failure_log"
+
+rocky_ssh 'rm -f /var/tmp/ginux-oci-rootfs-missing.index'
+if rocky_ssh '/var/tmp/ginux vfs /var/tmp/gate5.toml /var/tmp/ginux-oci-rootfs.tar /var/tmp/ginux-oci-rootfs-missing.index' > "$missing_log" 2>&1; then
+    printf '%s\n' 'missing VFS index was incorrectly accepted' >&2
+    exit 1
+fi
+grep -Fqx 'GINUX_INSTANCE: failed reason=VFS index open failed' "$missing_log"
+grep -Fqx 'GINUX_LIFECYCLE: state=failed resources=false managed-task=false' "$missing_log"
+grep -Fqx 'GINUX_INSTANCE: cleanup resources=false managed-task=false' "$missing_log"
+
+rocky_ssh 'rm -f /var/tmp/ginux /var/tmp/gate5.toml /var/tmp/ginux-oci-rootfs.tar /var/tmp/ginux-oci-rootfs.index /var/tmp/ginux-oci-rootfs-bad.index'
+printf '%s\n' 'test-vfs: PASS'
diff --git a/scripts/validate-gate15-config.sh b/scripts/validate-gate15-config.sh
new file mode 100755
index 0000000..04a3fc7
--- /dev/null
+++ b/scripts/validate-gate15-config.sh
@@ -0,0 +1,123 @@
+#!/bin/sh
+set -eu
+
+config_dir=${1:-benchmarks/gate15}
+
+value() {
+    file=$1
+    key=$2
+    awk -F= -v key="$key" '
+        /^[[:space:]]*(#|$)/ { next }
+        $1 == key { count++; value = substr($0, index($0, "=") + 1) }
+        END { if (count != 1 || value == "") exit 1; print value }
+    ' "$file"
+}
+
+valid_csv() {
+    input=$1
+    allowed=$2
+    awk -v input="$input" -v allowed="$allowed" '
+        BEGIN {
+            count = split(input, item, ",")
+            if (!count) exit 1
+            for (i = 1; i <= count; i++) {
+                if (item[i] == "" || index(" " allowed " ", " " item[i] " ") == 0 || seen[item[i]]++) exit 1
+            }
+        }
+    '
+}
+
+for name in suite native selective paranoid; do
+    file=$config_dir/$name.conf
+    test -f "$file" || {
+        printf 'missing Gate 15 template: %s\n' "$file" >&2
+        exit 2
+    }
+    test "$(value "$file" schema)" = 1 || {
+        printf 'unsupported Gate 15 template schema: %s\n' "$file" >&2
+        exit 2
+    }
+done
+
+for specification in \
+    'cpu:higher:events/s' \
+    'memory:higher:MiB/s' \
+    'threads:higher:events/s' \
+    'mutex:lower:s/event'
+do
+    workload=${specification%%:*}
+    remainder=${specification#*:}
+    direction=${remainder%%:*}
+    unit=${remainder#*:}
+    file=$config_dir/$workload.conf
+    test -f "$file" || {
+        printf 'missing Gate 15 workload template: %s\n' "$file" >&2
+        exit 2
+    }
+    test "$(value "$file" schema)" = 1
+    test "$(value "$file" workload)" = "$workload"
+    test "$(value "$file" direction)" = "$direction"
+    test "$(value "$file" unit)" = "$unit"
+    test "$(value "$file" threads)" = matrix
+done
+
+test "$(value "$config_dir/cpu.conf" time_seconds)" = suite
+test "$(value "$config_dir/cpu.conf" cpu_max_prime)" = 10000
+test "$(value "$config_dir/memory.conf" time_seconds)" = suite
+test "$(value "$config_dir/memory.conf" block_size)" = 1K
+test "$(value "$config_dir/memory.conf" total_size)" = 100G
+test "$(value "$config_dir/memory.conf" operation)" = write
+test "$(value "$config_dir/memory.conf" scope)" = global
+test "$(value "$config_dir/memory.conf" access_mode)" = seq
+test "$(value "$config_dir/threads.conf" time_seconds)" = suite
+test "$(value "$config_dir/threads.conf" thread_yields)" = 1000
+test "$(value "$config_dir/threads.conf" thread_locks)" = 8
+test "$(value "$config_dir/mutex.conf" time_seconds)" = sysbench-default
+test "$(value "$config_dir/mutex.conf" mutex_parameters)" = sysbench-1.0.20-defaults
+
+for specification in \
+    'native:native:none' \
+    'selective:ginux:selective' \
+    'paranoid:ginux:paranoid'
+do
+    profile=${specification%%:*}
+    remainder=${specification#*:}
+    runtime=${remainder%%:*}
+    control=${remainder#*:}
+    file=$config_dir/$profile.conf
+    test "$(value "$file" profile)" = "$profile"
+    test "$(value "$file" runtime)" = "$runtime"
+    test "$(value "$file" syscall_control)" = "$control"
+done
+
+suite=$config_dir/suite.conf
+duration=$(value "$suite" duration_seconds)
+repetitions=$(value "$suite" repetitions)
+vcpus=$(value "$suite" vcpus)
+workloads=$(value "$suite" workloads)
+audit=$(value "$suite" audit_enabled)
+capture=$(value "$suite" capture_audit)
+supervisor=$(value "$suite" supervisor_cpu)
+
+case "$duration:$repetitions" in
+    *[!0-9:]*|0:*|*:0|:*|*:) printf '%s\n' 'invalid Gate 15 duration or repetitions' >&2; exit 2 ;;
+esac
+valid_csv "$vcpus" '1 2 4' || {
+    printf 'invalid Gate 15 vCPU list: %s\n' "$vcpus" >&2
+    exit 2
+}
+valid_csv "$workloads" 'cpu memory threads mutex' || {
+    printf 'invalid Gate 15 workload list: %s\n' "$workloads" >&2
+    exit 2
+}
+case "$audit:$capture" in
+    0:0|0:1|1:0|1:1) ;;
+    *) printf '%s\n' 'invalid Gate 15 audit setting' >&2; exit 2 ;;
+esac
+case "$supervisor" in
+    shared|0|1|2|3) ;;
+    *) printf 'invalid Gate 15 supervisor CPU: %s\n' "$supervisor" >&2; exit 2 ;;
+esac
+
+printf 'GATE15_CONFIG: PASS directory=%s duration=%s repetitions=%s vcpus=%s workloads=%s\n' \
+    "$config_dir" "$duration" "$repetitions" "$vcpus" "$workloads"
diff --git a/scripts/validate-gate15-results.sh b/scripts/validate-gate15-results.sh
new file mode 100755
index 0000000..62688da
--- /dev/null
+++ b/scripts/validate-gate15-results.sh
@@ -0,0 +1,103 @@
+#!/bin/sh
+set -eu
+
+results=${1:?usage: validate-gate15-results RESULTS SELECTIVE_METADATA PARANOID_METADATA CONFIG_DIR}
+selective_metadata=${2:?usage: validate-gate15-results RESULTS SELECTIVE_METADATA PARANOID_METADATA CONFIG_DIR}
+paranoid_metadata=${3:?usage: validate-gate15-results RESULTS SELECTIVE_METADATA PARANOID_METADATA CONFIG_DIR}
+config_dir=${4:?usage: validate-gate15-results RESULTS SELECTIVE_METADATA PARANOID_METADATA CONFIG_DIR}
+
+./scripts/validate-gate15-config.sh "$config_dir" >/dev/null
+
+metadata_value() {
+    file=$1
+    key=$2
+    awk -F= -v key="$key" '$1 == key { count++; value = substr($0, index($0, "=") + 1) } END { if (count != 1) exit 1; print value }' "$file"
+}
+
+for file in "$selective_metadata" "$paranoid_metadata"; do
+    test -s "$file"
+done
+test "$(metadata_value "$selective_metadata" dispatch_mode)" = selective
+test "$(metadata_value "$paranoid_metadata" dispatch_mode)" = paranoid
+
+compatible_keys='ginux_commit ginux_working_tree benchmark_duration_seconds repetitions warmups_per_row memory_limit_bytes cpu_affinity ordering audit_enabled capture_per_run_audit ginux_supervisor_cpu host_kernel host_arch host_vcpus host_memory_kib sysbench_nevra sysbench_sha256 rocky_release instance_image'
+for key in $compatible_keys; do
+    selective_value=$(metadata_value "$selective_metadata" "$key")
+    paranoid_value=$(metadata_value "$paranoid_metadata" "$key")
+    test "$selective_value" = "$paranoid_value" || {
+        printf 'Gate 15 metadata mismatch: %s selective=%s paranoid=%s\n' \
+            "$key" "$selective_value" "$paranoid_value" >&2
+        exit 2
+    }
+done
+
+suite=$config_dir/suite.conf
+config_value() {
+    awk -F= -v key="$2" '$1 == key { print substr($0, index($0, "=") + 1); found=1 } END { if (!found) exit 1 }' "$1"
+}
+repetitions=$(config_value "$suite" repetitions)
+vcpus=$(config_value "$suite" vcpus)
+workloads=$(config_value "$suite" workloads)
+
+awk -F '\t' -v repetitions="$repetitions" -v allocations="$vcpus" -v workloads="$workloads" '
+    BEGIN {
+        expected_header = "mode\tpair\tworkload\tvcpus\tthreads\trepetition\tdirection\tunit\tvalue"
+        split(allocations, allocation, ",")
+        split(workloads, workload, ",")
+        for (w in workload) {
+            for (a in allocation) {
+                add_expected(workload[w], allocation[a], 1)
+                if (allocation[a] != 1) add_expected(workload[w], allocation[a], allocation[a])
+            }
+        }
+    }
+    function add_expected(workload_name, vcpu_count, thread_count,    repetition, key) {
+        for (repetition = 1; repetition <= repetitions; repetition++) {
+            key = "native" SUBSEP "selective" SUBSEP workload_name SUBSEP vcpu_count SUBSEP thread_count SUBSEP repetition
+            expected[key] = 1
+            key = "selective" SUBSEP "selective" SUBSEP workload_name SUBSEP vcpu_count SUBSEP thread_count SUBSEP repetition
+            expected[key] = 1
+            key = "native" SUBSEP "paranoid" SUBSEP workload_name SUBSEP vcpu_count SUBSEP thread_count SUBSEP repetition
+            expected[key] = 1
+            key = "paranoid" SUBSEP "paranoid" SUBSEP workload_name SUBSEP vcpu_count SUBSEP thread_count SUBSEP repetition
+            expected[key] = 1
+        }
+    }
+    NR == 1 {
+        if ($0 != expected_header) {
+            print "invalid Gate 15 result header" > "/dev/stderr"
+            exit 2
+        }
+        next
+    }
+    {
+        key = $1 SUBSEP $2 SUBSEP $3 SUBSEP $4 SUBSEP $5 SUBSEP $6
+        if (!(key in expected)) {
+            print "unexpected Gate 15 row at line " NR > "/dev/stderr"
+            exit 2
+        }
+        if (seen[key]++) {
+            print "duplicate Gate 15 row at line " NR > "/dev/stderr"
+            exit 2
+        }
+        if ($7 != "higher" && $7 != "lower") {
+            print "invalid Gate 15 direction at line " NR > "/dev/stderr"
+            exit 2
+        }
+        if ($9 !~ /^[0-9]+([.][0-9]+)?$/ || $9 + 0 <= 0) {
+            print "invalid Gate 15 value at line " NR > "/dev/stderr"
+            exit 2
+        }
+    }
+    END {
+        if (NR == 1) exit 2
+        for (key in expected) {
+            if (!seen[key]) {
+                print "missing Gate 15 row" > "/dev/stderr"
+                exit 2
+            }
+        }
+    }
+' "$results"
+
+printf 'GATE15_RESULTS: PASS rows=%s\n' "$(($(wc -l <"$results") - 1))"
diff --git a/scripts/verify-rocky-host.sh b/scripts/verify-rocky-host.sh
new file mode 100755
index 0000000..6d6bf6d
--- /dev/null
+++ b/scripts/verify-rocky-host.sh
@@ -0,0 +1,30 @@
+#!/bin/sh
+set -eu
+
+. ./config/rocky-host-image.env
+
+image=${ROCKY_IMAGE_PATH:-build/cache/rocky/$ROCKY_IMAGE_NAME}
+published=$(awk '/^SHA256 / {print $NF}' config/rocky-host-image.CHECKSUM)
+if [ "$published" != "$ROCKY_IMAGE_SHA256" ]; then
+    printf '%s\n' 'tracked Rocky published checksum disagrees with image manifest' >&2
+    exit 1
+fi
+if [ ! -f "$image" ]; then
+    printf '%s\n' 'missing Rocky host image; run make host-image-fetch' >&2
+    exit 2
+fi
+
+size=$(wc -c < "$image" | tr -d ' ')
+case "$(uname -s)" in
+    Darwin) actual=$(shasum -a 256 "$image" | awk '{print $1}') ;;
+    *) actual=$(sha256sum "$image" | awk '{print $1}') ;;
+esac
+if [ "$size" != "$ROCKY_IMAGE_SIZE" ]; then
+    printf 'Rocky host image size mismatch: expected %s, got %s\n' "$ROCKY_IMAGE_SIZE" "$size" >&2
+    exit 1
+fi
+if [ "$actual" != "$ROCKY_IMAGE_SHA256" ]; then
+    printf 'Rocky host image checksum mismatch: expected %s, got %s\n' "$ROCKY_IMAGE_SHA256" "$actual" >&2
+    exit 1
+fi
+printf 'Rocky host image verified: %s\n' "$image"
diff --git a/scripts/verify-rocky-oci.sh b/scripts/verify-rocky-oci.sh
new file mode 100755
index 0000000..6e35773
--- /dev/null
+++ b/scripts/verify-rocky-oci.sh
@@ -0,0 +1,62 @@
+#!/bin/sh
+set -eu
+
+script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
+. "$script_dir/oci-common.sh"
+
+for command in jq; do
+    command -v "$command" >/dev/null 2>&1 || {
+        printf 'missing required command: %s\n' "$command" >&2
+        exit 1
+    }
+done
+
+test "$(jq -er '.imageLayoutVersion' "$GINUX_OCI_CACHE_DIR/oci-layout")" = 1.0.0
+index_blob=$(oci_blob_path "$GINUX_OCI_INDEX_DIGEST")
+manifest_blob=$(oci_blob_path "$GINUX_OCI_MANIFEST_DIGEST")
+oci_verify_blob "$GINUX_OCI_INDEX_DIGEST"
+oci_verify_blob "$GINUX_OCI_MANIFEST_DIGEST"
+
+jq -e \
+    --arg digest "$GINUX_OCI_MANIFEST_DIGEST" \
+    --arg os "$GINUX_OCI_PLATFORM_OS" \
+    --arg arch "$GINUX_OCI_PLATFORM_ARCH" \
+    'any(.manifests[]; .digest == $digest and .platform.os == $os and
+         .platform.architecture == $arch)' \
+    "$index_blob" >/dev/null
+jq -e --arg digest "$GINUX_OCI_MANIFEST_DIGEST" \
+    '.schemaVersion == 2 and .manifests[0].digest == $digest' \
+    "$GINUX_OCI_CACHE_DIR/index.json" >/dev/null
+
+config_digest=$(jq -er '.config.digest' "$manifest_blob")
+oci_verify_blob "$config_digest"
+config_blob=$(oci_blob_path "$config_digest")
+config_media_type=$(jq -er '.config.mediaType' "$manifest_blob")
+case "$config_media_type" in
+    application/vnd.oci.image.config.v1+json|application/vnd.docker.container.image.v1+json) ;;
+    *) printf 'unsupported image config media type: %s\n' "$config_media_type" >&2; exit 1 ;;
+esac
+test "$(jq -er '.config.size' "$manifest_blob")" -eq "$(wc -c < "$config_blob" | tr -d ' ')"
+test "$(jq -er '.os' "$config_blob")" = "$GINUX_OCI_PLATFORM_OS"
+test "$(jq -er '.architecture' "$config_blob")" = "$GINUX_OCI_PLATFORM_ARCH"
+
+layer_count=0
+while IFS=' ' read -r layer_digest layer_size layer_media_type; do
+    case "$layer_media_type" in
+        application/vnd.oci.image.layer.v1.tar+gzip|application/vnd.docker.image.rootfs.diff.tar.gzip) ;;
+        *) printf 'unsupported image layer media type: %s\n' "$layer_media_type" >&2; exit 1 ;;
+    esac
+    oci_verify_blob "$layer_digest"
+    layer_blob=$(oci_blob_path "$layer_digest")
+    test "$layer_size" -eq "$(wc -c < "$layer_blob" | tr -d ' ')"
+    layer_count=$((layer_count + 1))
+done <<EOF
+$(jq -r '.layers[] | [.digest, (.size | tostring), .mediaType] | join(" ")' "$manifest_blob")
+EOF
+test "$layer_count" -gt 0
+
+if ! oci_human_output; then
+    printf 'OCI_VERIFY: image=docker.io/%s:%s platform=%s/%s layers=%s manifest=%s\n' \
+        "$GINUX_OCI_REPOSITORY" "$GINUX_OCI_TAG" "$GINUX_OCI_PLATFORM_OS" \
+        "$GINUX_OCI_PLATFORM_ARCH" "$layer_count" "$GINUX_OCI_MANIFEST_DIGEST"
+fi
