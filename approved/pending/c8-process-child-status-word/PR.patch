+fn native_socket_object_index(table: &NativeDescriptorTable, fd: u64) -> Option<usize> {
+    table
+        .socket_aliases
+        .iter()
+        .find(|alias| alias.fd == fd as u32 as i64)
+        .map(|alias| alias.object as usize)
+}
+
+fn native_socket_protocol(
+    table: &NativeDescriptorTable,
+    objects: &[NativeSocketObject; NATIVE_SOCKET_OBJECT_LIMIT],
+    fd: u64,
+) -> u8 {
+    native_socket_object_index(table, fd)
+        .and_then(|object| objects.get(object))
+        .filter(|object| object.in_use)
+        .map_or(0, |object| object.protocol)
+}
+
+fn native_socket_family(
+    table: &NativeDescriptorTable,
+    objects: &[NativeSocketObject; NATIVE_SOCKET_OBJECT_LIMIT],
+    fd: u64,
+) -> Option<u16> {
+    native_socket_object_index(table, fd)
+        .and_then(|object| objects.get(object))
+        .filter(|object| object.in_use)
+        .map(|object| object.address_family)
+}
+
+fn native_socket_is_ip(
+    table: &NativeDescriptorTable,
+    objects: &[NativeSocketObject; NATIVE_SOCKET_OBJECT_LIMIT],
+    fd: u64,
+) -> bool {
+    native_socket_family(table, objects, fd).is_some_and(|family| matches!(family, 2 | 10))
+}
+
+fn native_socket_retain(
+    objects: &mut [NativeSocketObject; NATIVE_SOCKET_OBJECT_LIMIT],
+    object: usize,
+) -> Option<()> {
+    let socket = objects.get_mut(object)?;
+    if !socket.in_use {
+        return None;
+    }
+    socket.references = socket.references.checked_add(1)?;
+    Some(())
+}
+
+fn native_socket_release(
+    objects: &mut [NativeSocketObject; NATIVE_SOCKET_OBJECT_LIMIT],
+    object: usize,
+) {
+    let Some(socket) = objects.get_mut(object).filter(|socket| socket.in_use) else {
+        return;
+    };
+    if socket.references > 1 {
+        socket.references -= 1;
+    } else {
+        *socket = EMPTY_SOCKET_OBJECT;
+    }
+}
+
+fn native_socket_remove_alias(
+    table: &mut NativeDescriptorTable,
+    objects: &mut [NativeSocketObject; NATIVE_SOCKET_OBJECT_LIMIT],
+    fd: u64,
+) {
+    if let Some(slot) = table
+        .socket_aliases
+        .iter_mut()
+        .find(|alias| alias.fd == fd as u32 as i64)
+    {
+        let object = slot.object as usize;
+        *slot = EMPTY_SOCKET_ALIAS;
+        native_socket_release(objects, object);
+    }
+}
+
+fn native_socket_insert_alias(
+    table: &mut NativeDescriptorTable,
+    objects: &mut [NativeSocketObject; NATIVE_SOCKET_OBJECT_LIMIT],
+    fd: u64,
+    object: usize,
+    close_on_exec: bool,
+) -> Option<()> {
+    native_socket_remove_alias(table, objects, fd);
+    let slot = table.socket_aliases.iter_mut().find(|alias| alias.fd < 0)?;
+    native_socket_retain(objects, object)?;
+    *slot = NativeSocketAlias {
+        fd: fd as u32 as i64,
+        object: u16::try_from(object).ok()?,
+        close_on_exec,
+    };
+    Some(())
+}
+
+fn native_socket_allocate(
+    table: &mut NativeDescriptorTable,
+    objects: &mut [NativeSocketObject; NATIVE_SOCKET_OBJECT_LIMIT],
+    fd: u64,
+    address_family: u16,
+    protocol: u8,
+    close_on_exec: bool,
+) -> Option<usize> {
+    let object = objects.iter().position(|object| !object.in_use)?;
+    objects[object] = NativeSocketObject {
+        in_use: true,
+        references: 0,
+        address_family,
+        protocol,
+        source_bound: false,
+        internal_port: 0,
+        external_port: 0,
+        netlink_sequences: [0; 4],
+        netlink_count: 0,
+    };
+    if native_socket_insert_alias(table, objects, fd, object, close_on_exec).is_none() {
+        objects[object] = EMPTY_SOCKET_OBJECT;
+        return None;
+    }
+    Some(object)
+}
+
+fn native_socket_retain_table(
+    table: &NativeDescriptorTable,
+    objects: &mut [NativeSocketObject; NATIVE_SOCKET_OBJECT_LIMIT],
+) -> Option<()> {
+    for (retained, alias) in table
+        .socket_aliases
+        .iter()
+        .filter(|alias| alias.fd >= 0)
+        .enumerate()
+    {
+        if native_socket_retain(objects, alias.object as usize).is_none() {
+            for rollback in table
+                .socket_aliases
+                .iter()
+                .filter(|alias| alias.fd >= 0)
+                .take(retained)
+            {
+                native_socket_release(objects, rollback.object as usize);
+            }
+            return None;
+        }
+    }
+    Some(())
+}
+
+fn native_socket_release_table(
+    table: &NativeDescriptorTable,
+    objects: &mut [NativeSocketObject; NATIVE_SOCKET_OBJECT_LIMIT],
+) {
+    for alias in table.socket_aliases.iter().filter(|alias| alias.fd >= 0) {
+        native_socket_release(objects, alias.object as usize);
+    }
+}
+
+fn native_socket_set_cloexec(table: &mut NativeDescriptorTable, fd: u64, close_on_exec: bool) {
+    if let Some(alias) = table
+        .socket_aliases
+        .iter_mut()
+        .find(|alias| alias.fd == fd as u32 as i64)
+    {
+        alias.close_on_exec = close_on_exec;
+    }
+}
+
+fn native_socket_exec(
+    table: &mut NativeDescriptorTable,
+    objects: &mut [NativeSocketObject; NATIVE_SOCKET_OBJECT_LIMIT],
+) {
+    for index in 0..table.socket_aliases.len() {
+        if table.socket_aliases[index].fd >= 0 && table.socket_aliases[index].close_on_exec {
+            let object = table.socket_aliases[index].object as usize;
+            table.socket_aliases[index] = EMPTY_SOCKET_ALIAS;
+            native_socket_release(objects, object);
+        }
+    }
+}
+
+fn native_socket_close_range(
+    table: &mut NativeDescriptorTable,
+    objects: &mut [NativeSocketObject; NATIVE_SOCKET_OBJECT_LIMIT],
+    first: u32,
+    last: u32,
+    close_on_exec: bool,
+) {
+    for index in 0..table.socket_aliases.len() {
+        let alias = table.socket_aliases[index];
+        if alias.fd >= i64::from(first) && alias.fd <= i64::from(last) {
+            if close_on_exec {
+                table.socket_aliases[index].close_on_exec = true;
+            } else {
+                table.socket_aliases[index] = EMPTY_SOCKET_ALIAS;
+                native_socket_release(objects, alias.object as usize);
+            }
+        }
+    }
+}
+
+fn native_scm_rights_cleanup_replay(cleanup: &NativeScmRightsCleanup, regs: &mut UserRegs) {
+    regs.orig_rax = SYS_CLOSE;
+    regs.rax = SYS_CLOSE;
+    regs.rdi = cleanup.fds[cleanup.current] as u32 as u64;
+    regs.rsi = 0;
+    regs.rdx = 0;
+    regs.r10 = 0;
+    regs.r8 = 0;
+    regs.r9 = 0;
+    regs.rip = cleanup.rip - 2;
+}
+
+fn native_bind_socket_source(pid: usize, fd: i64, source: [u8; 4]) -> bool {
+    const SYS_PIDFD_OPEN: usize = 434;
+    const SYS_PIDFD_GETFD: usize = 438;
+    const SYS_BIND: usize = 49;
+    let pidfd = unsafe { syscall2(SYS_PIDFD_OPEN, pid, 0) };
+    if pidfd < 0 {
+        return false;
+    }
+    let duplicate = unsafe { syscall3(SYS_PIDFD_GETFD, pidfd as usize, fd as usize, 0) };
+    if duplicate < 0 {
+        let _ = unsafe { syscall1(SYS_CLOSE_HOST, pidfd as usize) };
+        return false;
+    }
+    let mut address = [0u8; 16];
+    address[0] = 2;
+    address[4..8].copy_from_slice(&source);
+    let result = unsafe {
+        syscall3(
+            SYS_BIND,
+            duplicate as usize,
+            address.as_ptr() as usize,
+            address.len(),
+        )
+    };
+    let _ = unsafe { syscall1(SYS_CLOSE_HOST, duplicate as usize) };
+    let _ = unsafe { syscall1(SYS_CLOSE_HOST, pidfd as usize) };
+    result == 0
+}
+
+fn native_unix_address_allowed(pid: usize, address: usize, length: u64) -> bool {
+    if address == 0 || !(3..=110).contains(&length) {
+        return false;
+    }
+    let mut socket_address = [0u8; 110];
+    let length = length as usize;
+    if !read_tracee_bytes(pid, address, &mut socket_address[..length])
+        || u16::from_ne_bytes([socket_address[0], socket_address[1]]) != 1
+    {
+        return false;
+    }
+    socket_address[2] != 0
+}
+
+fn native_sockaddr_with_port(word: u64, port: u16) -> u64 {
+    let network = port.to_be_bytes();
+    (word & !0xffff_0000) | (u64::from(network[0]) << 16) | (u64::from(network[1]) << 24)
+}
+
+fn native_sockaddr_with_source(word: u64, source: [u8; 4]) -> u64 {
+    let mut value = word & 0x0000_0000_ffff_ffff;
+    value |= u64::from(source[0]) << 32;
+    value |= u64::from(source[1]) << 40;
+    value |= u64::from(source[2]) << 48;
+    value |= u64::from(source[3]) << 56;
+    value
+}
+
+fn native_fail(instance: &mut Instance, pid: usize, reason: &[u8]) -> ! {
+    kill_tracee(pid);
+    instance_fail(instance, reason)
+}
+
+/// Ends a traced child with `kill(2)` and `SIGKILL` and reaps it, as
+/// `launch_fail` does. `PTRACE_KILL` only as a fallback: a seccomp policy that
+/// refuses ptrace requests may refuse it as well, and the reap would then block
+/// with the tracee left in its stop (and running on, untraced, once the
+/// supervisor is gone before `PTRACE_O_EXITKILL` is set).
+///
+/// Some callers have already reaped the child with the wait that reported it
+/// gone. A nonblocking wait first tells them apart: it fails once the child is
+/// reaped and reaps it if it has exited, so `kill(2)` only targets a child that
+/// is still ours and whose pid cannot have been reused.
+///
+/// The reap waits for any child, not for `pid` alone: a killed traced thread
+/// stays a zombie until its tracer reaps it, and until then the kernel does not
+/// report the group leader, so a wait for the leader alone never returns.
+fn kill_tracee(pid: usize) {
+    let mut status = 0i32;
+    let reaped = unsafe {
+        syscall4(
+            SYS_WAIT4,
+            pid,
+            &mut status as *mut _ as usize,
+            WNOHANG as usize,
+            0,
+        )
+    };
+    if reaped < 0 || (reaped as usize == pid && !stopped(status)) {
+        return;
+    }
+    if unsafe { syscall2(SYS_KILL, pid, SIGKILL) } < 0 {
+        let _ = ptrace(PTRACE_KILL, pid, 0, 0);
+    }
+    loop {
+        let waited = unsafe {
+            syscall4(
+                SYS_WAIT4,
+                (-1isize) as usize,
+                &mut status as *mut _ as usize,
+                0,
+                0,
+            )
+        };
+        if waited < 0 || (waited as usize == pid && !stopped(status)) {
+            return;
+        }
+        // Before Linux 5.19, PTRACE_KILL only resumes a stopped tracee: after
+        // the fallback, the leader can stop again instead of exiting.
+        if waited as usize == pid {
+            let _ = ptrace(PTRACE_KILL, pid, 0, 0);
+        }
+    }
+}
