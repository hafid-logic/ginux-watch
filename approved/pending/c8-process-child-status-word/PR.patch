diff --git a/tests/fixtures/allocator-benchmark.c b/tests/fixtures/allocator-benchmark.c
new file mode 100644
index 0000000..b798071
--- /dev/null
+++ b/tests/fixtures/allocator-benchmark.c
@@ -0,0 +1,114 @@
+#define _GNU_SOURCE
+#include <pthread.h>
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdatomic.h>
+#include <sys/resource.h>
+#include <time.h>
+#include <unistd.h>
+
+enum { ITERATIONS = 20000, LIVE_SLOTS = 256 };
+
+static pthread_barrier_t ready_barrier;
+static pthread_barrier_t start_barrier;
+static atomic_ulong live_requested;
+
+static int wait_at(pthread_barrier_t *barrier) {
+    int result = pthread_barrier_wait(barrier);
+    return result == 0 || result == PTHREAD_BARRIER_SERIAL_THREAD ? 0 : result;
+}
+
+static uint64_t nanoseconds(void) {
+    struct timespec value;
+    if (clock_gettime(CLOCK_MONOTONIC, &value) != 0) abort();
+    return (uint64_t)value.tv_sec * 1000000000ULL + (uint64_t)value.tv_nsec;
+}
+
+static uint64_t resident_bytes(void) {
+    FILE *source = fopen("/proc/self/statm", "r");
+    unsigned long pages = 0;
+    unsigned long resident = 0;
+    if (source == NULL || fscanf(source, "%lu %lu", &pages, &resident) != 2) abort();
+    fclose(source);
+    (void)pages;
+    return (uint64_t)resident * (uint64_t)sysconf(_SC_PAGESIZE);
+}
+
+static void *worker(void *argument) {
+    uintptr_t id = (uintptr_t)argument;
+    unsigned char *slots[LIVE_SLOTS];
+    size_t sizes[LIVE_SLOTS];
+    size_t requested = 0;
+    for (size_t i = 0; i < LIVE_SLOTS; ++i) {
+        sizes[i] = 16 + ((i * 73 + id * 31) % 4096);
+        slots[i] = malloc(sizes[i]);
+        if (slots[i] == NULL) return (void *)1;
+        slots[i][0] = (unsigned char)i;
+        slots[i][sizes[i] - 1] = (unsigned char)id;
+        requested += sizes[i];
+    }
+    atomic_fetch_add_explicit(&live_requested, requested, memory_order_relaxed);
+    if (wait_at(&ready_barrier) != 0) return (void *)2;
+    if (wait_at(&start_barrier) != 0) return (void *)3;
+    for (size_t i = 0; i < ITERATIONS; ++i) {
+        size_t slot = i % LIVE_SLOTS;
+        free(slots[slot]);
+        size_t size = 16 + ((i * 73 + id * 31) % 4096);
+        slots[slot] = malloc(size);
+        if (slots[slot] == NULL) {
+            fprintf(stderr,
+                    "allocator allocation failed: thread=%zu iteration=%zu size=%zu errno=%d\n",
+                    (size_t)id, i, size, errno);
+            return (void *)4;
+        }
+        slots[slot][0] = (unsigned char)i;
+        slots[slot][size - 1] = (unsigned char)id;
+    }
+    for (size_t i = 0; i < LIVE_SLOTS; ++i) free(slots[i]);
+    return NULL;
+}
+
+int main(int argc, char **argv) {
+    size_t count = argc > 1 ? (size_t)strtoul(argv[1], NULL, 10) : 1;
+    if (count == 0 || count > 16) return 2;
+    pthread_t threads[16];
+    uint64_t baseline_rss = resident_bytes();
+    atomic_init(&live_requested, 0);
+    if (pthread_barrier_init(&ready_barrier, NULL, (unsigned)count + 1) != 0 ||
+        pthread_barrier_init(&start_barrier, NULL, (unsigned)count + 1) != 0) return 3;
+    for (uintptr_t i = 0; i < count; ++i)
+        if (pthread_create(&threads[i], NULL, worker, (void *)i) != 0) return 4;
+    if (wait_at(&ready_barrier) != 0) return 5;
+    uint64_t live_rss = resident_bytes();
+    uint64_t requested = atomic_load_explicit(&live_requested, memory_order_relaxed);
+    uint64_t start = nanoseconds();
+    if (wait_at(&start_barrier) != 0) return 6;
+    for (size_t i = 0; i < count; ++i) {
+        void *result = NULL;
+        int join_status = pthread_join(threads[i], &result);
+        if (join_status != 0 || result != NULL) {
+            fprintf(stderr,
+                    "allocator worker failed: thread=%zu join_status=%d worker_status=%zu\n",
+                    i, join_status, (size_t)result);
+            return 7;
+        }
+    }
+    uint64_t elapsed = nanoseconds() - start;
+    size_t operations = count * (size_t)ITERATIONS;
+    uint64_t live_delta = live_rss > baseline_rss ? live_rss - baseline_rss : 0;
+    struct rusage usage;
+    if (getrusage(RUSAGE_SELF, &usage) != 0) return 8;
+    printf("threads=%zu operations=%zu elapsed_ns=%llu ops_per_second=%.2f "
+           "latency_ns=%.2f peak_rss_kib=%ld live_requested_bytes=%llu "
+           "live_rss_delta_bytes=%llu fragmentation_ratio=%.4f\n",
+           count, operations, (unsigned long long)elapsed,
+           (double)operations * 1000000000.0 / (double)elapsed,
+           (double)elapsed / (double)operations, usage.ru_maxrss,
+           (unsigned long long)requested, (unsigned long long)live_delta,
+           requested == 0 ? 0.0 : (double)live_delta / (double)requested);
+    pthread_barrier_destroy(&ready_barrier);
+    pthread_barrier_destroy(&start_barrier);
+    return 0;
+}
diff --git a/tests/fixtures/allocator-conformance.c b/tests/fixtures/allocator-conformance.c
new file mode 100644
index 0000000..9f226ea
--- /dev/null
+++ b/tests/fixtures/allocator-conformance.c
@@ -0,0 +1,227 @@
+#define _GNU_SOURCE
+#include <errno.h>
+#include <dlfcn.h>
+#include <malloc.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+enum { THREADS = 8, ITERATIONS = 2000 };
+
+enum { MALLOCX_ZERO_FLAG = 0x40 };
+
+static int mallocx_align_flag(unsigned alignment) {
+    int lg = 0;
+    while ((1U << lg) < alignment) ++lg;
+    return lg;
+}
+
+struct release_batch {
+    void *pointers[256];
+};
+
+static int stats_callback_seen;
+
+static void stats_callback(void *opaque, const char *message) {
+    (void)opaque;
+    if (message != NULL && strstr(message, "ginux-allocator") != NULL)
+        stats_callback_seen = 1;
+}
+
+static int exercise_extended_abi(void) {
+    void *(*mallocx_fn)(size_t, int) = dlsym(RTLD_DEFAULT, "mallocx");
+    void *(*rallocx_fn)(void *, size_t, int) = dlsym(RTLD_DEFAULT, "rallocx");
+    size_t (*xallocx_fn)(void *, size_t, size_t, int) = dlsym(RTLD_DEFAULT, "xallocx");
+    size_t (*sallocx_fn)(void *, int) = dlsym(RTLD_DEFAULT, "sallocx");
+    void (*dallocx_fn)(void *, int) = dlsym(RTLD_DEFAULT, "dallocx");
+    void (*sdallocx_fn)(void *, size_t, int) = dlsym(RTLD_DEFAULT, "sdallocx");
+    size_t (*nallocx_fn)(size_t, int) = dlsym(RTLD_DEFAULT, "nallocx");
+    int (*mallctl_fn)(const char *, void *, size_t *, void *, size_t) =
+        dlsym(RTLD_DEFAULT, "mallctl");
+    int (*mallctlnametomib_fn)(const char *, size_t *, size_t *) =
+        dlsym(RTLD_DEFAULT, "mallctlnametomib");
+    int (*mallctlbymib_fn)(const size_t *, size_t, void *, size_t *, void *, size_t) =
+        dlsym(RTLD_DEFAULT, "mallctlbymib");
+    void (*stats_fn)(void (*)(void *, const char *), void *, const char *) =
+        dlsym(RTLD_DEFAULT, "malloc_stats_print");
+    if (mallocx_fn == NULL || rallocx_fn == NULL || xallocx_fn == NULL ||
+        sallocx_fn == NULL || dallocx_fn == NULL || sdallocx_fn == NULL ||
+        nallocx_fn == NULL || mallctl_fn == NULL || mallctlnametomib_fn == NULL ||
+        mallctlbymib_fn == NULL || stats_fn == NULL)
+        return 1;
+    static const size_t sizes[] = {
+        1, 15, 16, 17, 31, 32, 33, 63, 64, 65, 4096, 65536, 65537,
+    };
+    static const unsigned alignments[] = { 0, 8, 64, 4096 };
+    for (size_t i = 0; i < sizeof(sizes) / sizeof(sizes[0]); ++i) {
+        for (size_t j = 0; j < sizeof(alignments) / sizeof(alignments[0]); ++j) {
+            int flags = alignments[j] == 0 ? 0 : mallocx_align_flag(alignments[j]);
+            if ((i + j) % 2 != 0) flags |= MALLOCX_ZERO_FLAG;
+            size_t predicted = nallocx_fn(sizes[i], flags);
+            void *allocation = mallocx_fn(sizes[i], flags);
+            if (allocation == NULL || predicted == 0 ||
+                predicted != sallocx_fn(allocation, flags))
+                return 2;
+            if (alignments[j] != 0 &&
+                (uintptr_t)allocation % alignments[j] != 0)
+                return 3;
+            if ((flags & MALLOCX_ZERO_FLAG) != 0) {
+                const unsigned char *bytes = allocation;
+                for (size_t k = 0; k < sizes[i]; ++k)
+                    if (bytes[k] != 0) return 4;
+            }
+            dallocx_fn(allocation, flags);
+        }
+    }
+
+    int initial_flags = mallocx_align_flag(64);
+    void *first = mallocx_fn(33, initial_flags);
+    if (first == NULL) return 5;
+    memset(first, 0x5a, 33);
+    int grown_flags = mallocx_align_flag(4096) | MALLOCX_ZERO_FLAG;
+    first = rallocx_fn(first, 4097, grown_flags);
+    if (first == NULL || (uintptr_t)first % 4096 != 0 ||
+        sallocx_fn(first, grown_flags) != nallocx_fn(4097, grown_flags))
+        return 6;
+    const unsigned char *grown = first;
+    for (size_t i = 0; i < 33; ++i) if (grown[i] != 0x5a) return 7;
+    for (size_t i = 33; i < 4097; ++i) if (grown[i] != 0) return 8;
+    if (xallocx_fn(first, 32, 0, 0) < 32) return 3;
+    dallocx_fn(first, 0);
+    errno = 0;
+    if (mallocx_fn(32, 0x80) != NULL || errno != EINVAL ||
+        nallocx_fn(32, 0x80) != 0)
+        return 9;
+    void *second = mallocx_fn(64, 0);
+    if (second == NULL) return 10;
+    sdallocx_fn(second, 64, 0);
+    size_t mib = 0, mib_length = 1;
+    if (mallctl_fn("unsupported", NULL, NULL, NULL, 0) != ENOENT ||
+        mallctlnametomib_fn("unsupported", &mib, &mib_length) != ENOENT ||
+        mallctlbymib_fn(&mib, mib_length, NULL, NULL, NULL, 0) != ENOENT)
+        return 11;
+    stats_fn(stats_callback, NULL, NULL);
+    return stats_callback_seen ? 0 : 12;
+}
+
+static void *worker(void *argument) {
+    uintptr_t id = (uintptr_t)argument;
+    for (size_t i = 0; i < ITERATIONS; ++i) {
+        size_t size = 1 + ((i * 131 + id * 17) % 8192);
+        unsigned char *memory = malloc(size);
+        if (memory == NULL) return (void *)1;
+        memset(memory, (int)(id + i), size);
+        size_t grown = size + 257;
+        unsigned char *replacement = realloc(memory, grown);
+        if (replacement == NULL) return (void *)2;
+        free(replacement);
+    }
+    return NULL;
+}
+
+static void *release_worker(void *argument) {
+    struct release_batch *batch = argument;
+    for (size_t i = 0; i < 256; ++i) free(batch->pointers[i]);
+    return NULL;
+}
+
+static int expect_double_free_abort(void) {
+    pid_t child = fork();
+    if (child < 0) return 1;
+    if (child == 0) {
+        void *memory = malloc(32);
+        void (*volatile release)(void *) = free;
+        if (memory == NULL) _exit(2);
+        release(memory);
+        release(memory);
+        _exit(3);
+    }
+    int status = 0;
+    if (waitpid(child, &status, 0) != child) return 4;
+    return WIFEXITED(status) && WEXITSTATUS(status) == 134 ? 0 : 5;
+}
+
+static int expect_interior_free_abort(void) {
+    pid_t child = fork();
+    if (child < 0) return 1;
+    if (child == 0) {
+        unsigned char *memory = malloc(64);
+        void (*volatile release)(void *) = free;
+        volatile uintptr_t offset = 1;
+        if (memory == NULL) _exit(2);
+        release(memory + offset);
+        _exit(3);
+    }
+    int status = 0;
+    if (waitpid(child, &status, 0) != child) return 4;
+    return WIFEXITED(status) && WEXITSTATUS(status) == 134 ? 0 : 5;
+}
+
+int main(void) {
+    void (*cfree_fn)(void *) = dlsym(RTLD_DEFAULT, "cfree");
+    if (cfree_fn == NULL) return 7;
+    void *ordinary = malloc(17);
+    if (ordinary == NULL || malloc_usable_size(ordinary) < 17) return 8;
+    ordinary = reallocarray(ordinary, 4, 32);
+    if (ordinary == NULL) return 9;
+    cfree_fn(ordinary);
+
+    unsigned char *zero = calloc(64, 4);
+    if (zero == NULL) return 10;
+    for (size_t i = 0; i < 256; ++i) if (zero[i] != 0) return 11;
+    free(zero);
+
+    void *aligned = NULL;
+    if (posix_memalign(&aligned, 4096, 8192) != 0 || aligned == NULL) return 12;
+    if ((uintptr_t)aligned % 4096 != 0) return 13;
+    memset(aligned, 0x5a, 8192);
+    free(aligned);
+
+    aligned = aligned_alloc(64, 128);
+    if (aligned == NULL || (uintptr_t)aligned % 64 != 0) return 15;
+    free(aligned);
+    aligned = memalign(128, 129);
+    if (aligned == NULL || (uintptr_t)aligned % 128 != 0) return 16;
+    free(aligned);
+    aligned = valloc(33);
+    if (aligned == NULL || (uintptr_t)aligned % (uintptr_t)sysconf(_SC_PAGESIZE) != 0)
+        return 17;
+    free(aligned);
+    aligned = pvalloc(33);
+    if (aligned == NULL || (uintptr_t)aligned % (uintptr_t)sysconf(_SC_PAGESIZE) != 0)
+        return 18;
+    free(aligned);
+
+    volatile size_t overflowing_count = (size_t)-1;
+    void *(*volatile allocate_zeroed)(size_t, size_t) = calloc;
+    errno = 0;
+    if (allocate_zeroed(overflowing_count, 2) != NULL || errno != ENOMEM)
+        return 14;
+
+    pthread_t threads[THREADS];
+    for (uintptr_t i = 0; i < THREADS; ++i)
+        if (pthread_create(&threads[i], NULL, worker, (void *)i) != 0) return 20;
+    for (size_t i = 0; i < THREADS; ++i) {
+        void *result = NULL;
+        if (pthread_join(threads[i], &result) != 0 || result != NULL) return 21;
+    }
+
+    struct release_batch batch;
+    for (size_t i = 0; i < 256; ++i) {
+        batch.pointers[i] = malloc(16 + i);
+        if (batch.pointers[i] == NULL) return 22;
+    }
+    pthread_t releaser;
+    if (pthread_create(&releaser, NULL, release_worker, &batch) != 0) return 23;
+    if (pthread_join(releaser, NULL) != 0) return 24;
+
+    if (expect_double_free_abort() != 0) return 30;
+    if (expect_interior_free_abort() != 0) return 31;
+    if (exercise_extended_abi() != 0) return 32;
+    puts("GINUX_ALLOCATOR_CONFORMANCE: PASS");
+    return 0;
+}
diff --git a/tests/fixtures/gate1-setup-fixture.c b/tests/fixtures/gate1-setup-fixture.c
new file mode 100644
index 0000000..80e5ee2
--- /dev/null
+++ b/tests/fixtures/gate1-setup-fixture.c
@@ -0,0 +1,104 @@
+/* Freestanding x86-64 programs for the Gate 1 ptrace setup failure check.
+ *
+ * Built with -DDENY_PTRACE: `deny-ptrace <request> <program> [args...]`
+ * installs a seccomp filter that fails ptrace(<request>, ...) with EPERM and
+ * executes <program> with the remaining arguments; `deny-ptrace all ...` fails
+ * every ptrace request except PTRACE_TRACEME. The filter is inherited by
+ * Gate 1's tracee, which only uses PTRACE_TRACEME, so only the supervisor's
+ * request fails.
+ *
+ * Built without it: a payload that records that it ran by creating
+ * /var/tmp/gate1-payload-ran. Installed as /var/tmp/ginux-managed-payload, it
+ * shows whether the payload got past the stop after execve. */
+typedef unsigned long word;
+
+static long call3(long number, word a, word b, word c)
+{
+    long result;
+    __asm__ volatile("syscall" : "=a"(result)
+                     : "a"(number), "D"(a), "S"(b), "d"(c)
+                     : "rcx", "r11", "memory");
+    return result;
+}
+
+#ifdef DENY_PTRACE
+/* prctl checks the unused arguments of PR_SET_NO_NEW_PRIVS, so pass zeros. */
+static long prctl(word option, word a, word b)
+{
+    long result;
+    register word r10 __asm__("r10") = 0;
+    register word r8 __asm__("r8") = 0;
+    __asm__ volatile("syscall" : "=a"(result)
+                     : "a"(157L), "D"(option), "S"(a), "d"(b), "r"(r10), "r"(r8)
+                     : "rcx", "r11", "memory");
+    return result;
+}
+
+struct filter {
+    unsigned short code;
+    unsigned char jt, jf;
+    unsigned int k;
+};
+
+struct program {
+    unsigned short length;
+    struct filter *filter;
+};
+
+static word parse(const char *text)
+{
+    word value = 0;
+    while (*text >= '0' && *text <= '9') value = value * 10 + (word)(*text++ - '0');
+    return value;
+}
+
+long fixture_main(long argc, char **argv, char **envp)
+{
+    if (argc < 3) return 90;
+    static struct filter filter[] = {
+        {0x20, 0, 0, 4},              /* ld seccomp_data.arch */
+        {0x15, 0, 5, 0xc000003e},     /* jeq AUDIT_ARCH_X86_64 */
+        {0x20, 0, 0, 0},              /* ld seccomp_data.nr */
+        {0x15, 0, 3, 101},            /* jeq ptrace */
+        {0x20, 0, 0, 16},             /* ld seccomp_data.args[0] (low word) */
+        {0x15, 0, 1, 0},              /* jeq <request>, set below */
+        {0x06, 0, 0, 0x00050000 | 1}, /* ret SECCOMP_RET_ERRNO | EPERM */
+        {0x06, 0, 0, 0x7fff0000},     /* ret SECCOMP_RET_ALLOW */
+    };
+    if (argv[1][0] == 'a') {
+        /* all: allow PTRACE_TRACEME (0), deny every other request. */
+        filter[5].jt = 1;
+        filter[5].jf = 0;
+    } else {
+        filter[5].k = (unsigned int)parse(argv[1]);
+    }
+    struct program program = {sizeof filter / sizeof filter[0], filter};
+    /* PR_SET_NO_NEW_PRIVS, then PR_SET_SECCOMP with SECCOMP_MODE_FILTER. */
+    if (prctl(38, 1, 0) < 0 || prctl(22, 2, (word)&program) < 0) return 91;
+    call3(59, (word)argv[2], (word)(argv + 2), (word)envp);
+    return 92;
+}
+#else
+long fixture_main(long argc, char **argv, char **envp)
+{
+    (void)argc;
+    (void)argv;
+    (void)envp;
+    long fd = call3(2, (word)"/var/tmp/gate1-payload-ran", 0101 /* O_WRONLY|O_CREAT */, 0644);
+    if (fd < 0) return 1;
+    call3(1, fd, (word)"ran\n", 4);
+    call3(3, fd, 0, 0);
+    return 0;
+}
+#endif
+
+__asm__(".global _start\n"
+        "_start:\n"
+        "mov (%rsp), %rdi\n"
+        "lea 8(%rsp), %rsi\n"
+        "lea 16(%rsp,%rdi,8), %rdx\n"
+        "and $-16, %rsp\n"
+        "call fixture_main\n"
+        "mov %rax, %rdi\n"
+        "mov $231, %rax\n"
+        "syscall\n");
