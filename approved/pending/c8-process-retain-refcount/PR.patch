From 972120fddc9e6b5ba64ce920321c6ddb082c71cd Mon Sep 17 00:00:00 2001
From: ginux-watch-agent <actions@users.noreply.github.com>
Date: Fri, 27 Nov 2026 19:48:23 +0000
Subject: [PATCH] tests(process): pin duplicate retain counts and source-close
 survival

### What
Pins `retain` via duplicate: both duplicated ends raise the count to 4, closing originals keeps the pipe alive, only the last copy frees it.

### Why it matters
Over-retaining leaks pipe objects; skipping the increment retains nothing and under-counts duplicates. Existing duplicate tests pin single-end retention, not both-ends survival.

### Mutation evidence (fail-then-pass)
| Mutant | Existing suite | New test |
|---|---|---|
| no-op retain (early return) | PASS (survives) | FAIL (killed) |
| decrement instead of increment | PASS (survives) | FAIL (killed) |

Baseline: PASS. Reproduce: `cargo test -p ginux-process --lib duplicate_retains`.

Prepared with AI assistance; reviewed by me.
---
 crates/ginux-process/src/lib.rs | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/crates/ginux-process/src/lib.rs b/crates/ginux-process/src/lib.rs
index 4db4a228..8e320c1f 100644
--- a/crates/ginux-process/src/lib.rs
+++ b/crates/ginux-process/src/lib.rs
@@ -2187,4 +2187,26 @@ mod tests {
         // unknown task scrubs nothing
         assert_eq!(pipes.exec_scrub(99), 0);
     }
+
+    #[test]
+    fn duplicate_retains_pipe_ends_and_survives_source_close() {
+        let mut pipes: PipeSpace<2, 8, 2> = PipeSpace::new();
+        let id = pipes.create_pipe(1, 0, 1, false).unwrap();
+        assert_eq!(pipes.pipe_ends(id), 2);
+        // duplicating both ends raises the count to four
+        pipes.duplicate(1, 0, 2, false).unwrap();
+        pipes.duplicate(1, 1, 3, false).unwrap();
+        assert_eq!(pipes.pipe_ends(id), 4);
+        // closing the originals leaves the pipe alive through the copies
+        pipes.close(1, 0).unwrap();
+        pipes.close(1, 1).unwrap();
+        assert_eq!(pipes.pipe_ends(id), 2);
+        assert_eq!(pipes.active_pipes(), 1);
+        // only the last copy frees it
+        pipes.close(1, 2).unwrap();
+        assert_eq!(pipes.pipe_ends(id), 1);
+        pipes.close(1, 3).unwrap();
+        assert_eq!(pipes.pipe_ends(id), 0);
+        assert_eq!(pipes.active_pipes(), 0);
+    }
 }
