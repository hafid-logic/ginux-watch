{
 "crate": "ginux-vfs",
 "file": "crates/ginux-vfs/src/lib.rs",
 "filter": "unlinked_overlay_slot_is_scrubbed",
 "mutants": [
  {
   "name": "no-scrub",
   "old": "self.overlay[object].data.fill(0);",
   "new": "let _ = object;"
  },
  {
   "name": "keep-len",
   "old": "self.overlay[object].len = 0;",
   "new": "let _ = object;"
  }
 ]
}