From 6b5a54419ae32a4fbbfbb0873a54020f66d04df8 Mon Sep 17 00:00:00 2001
From: ginux-watch-agent <actions@users.noreply.github.com>
Date: Fri, 27 Nov 2026 20:09:30 +0000
Subject: [PATCH] tests(process): pin unshare private-copy, solo no-op, and
 unknown-task edges

### What
Pins `unshare`: a shared descriptor table is copied privately (pipe ends retained), a solo task is a no-op, and unknown tasks return Ok without allocation.

### Why it matters
Exec unshares files before CLOEXEC scrub; counting zero members or off-by-one on the member threshold either leaks shared fds across exec or double-retains pipes. No existing test exercises unshare.

### Mutation evidence (fail-then-pass)
| Mutant | Existing suite | New test |
|---|---|---|
| `**member != 0` -> `== 0` | PASS (survives) | FAIL (killed) |
| `> 1` -> `>= 1` | PASS (survives) | FAIL (killed) |

Baseline: PASS. Reproduce: `cargo test -p ginux-process --lib unshare_copies_shared`.

Prepared with AI assistance; reviewed by me.
---
 crates/ginux-process/src/lib.rs | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/crates/ginux-process/src/lib.rs b/crates/ginux-process/src/lib.rs
index 4db4a228..dacd0edb 100644
--- a/crates/ginux-process/src/lib.rs
+++ b/crates/ginux-process/src/lib.rs
@@ -2187,4 +2187,29 @@ mod tests {
         // unknown task scrubs nothing
         assert_eq!(pipes.exec_scrub(99), 0);
     }
+
+    #[test]
+    fn unshare_copies_shared_table_and_solo_is_noop() {
+        let mut pipes: PipeSpace<4, 8, 4> = PipeSpace::new();
+        let id = pipes.create_pipe(1, 0, 1, false).unwrap();
+        assert_eq!(pipes.pipe_ends(id), 2);
+        // solo task: unshare must be a no-op (no extra retain, fds intact)
+        pipes.unshare(1).unwrap();
+        assert_eq!(pipes.pipe_ends(id), 2);
+        assert!(pipes.lookup(1, 0).is_some());
+        // share with task 2, then unshare task 1: private copy keeps both ends
+        pipes.share(2, 1).unwrap();
+        pipes.unshare(1).unwrap();
+        assert!(pipes.lookup(1, 0).is_some());
+        assert!(pipes.lookup(1, 1).is_some());
+        assert_eq!(pipes.pipe_ends(id), 4);
+        // task 2 still shares the original table; closing its ends frees only its refs
+        pipes.close(2, 0).unwrap();
+        pipes.close(2, 1).unwrap();
+        assert_eq!(pipes.pipe_ends(id), 2);
+        assert!(pipes.lookup(1, 0).is_some());
+        // unknown task: Ok, nothing allocated
+        pipes.unshare(99).unwrap();
+        assert_eq!(pipes.task_fds(99), 0);
+    }
 }
