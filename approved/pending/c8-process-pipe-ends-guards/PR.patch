From efa6510c5c8667b66ab22f8c1f3c96e98e82eb9a Mon Sep 17 00:00:00 2001
From: ginux-watch-agent <actions@users.noreply.github.com>
Date: Fri, 27 Nov 2026 20:12:22 +0000
Subject: [PATCH] tests(process): pin pipe_ends zero for invalid and dead pipes

### What
Pins `pipe_ends`: pipe 0 and out-of-range ids report 0, live pipes report their end count, freed slots report 0, reused slots report fresh counts.

### Why it matters
Diagnostics drive leak checks; dropping the zero guard indexes pipe 0 - 1 (underflow) and returning 0 for live pipes misreports leaks. No existing test exercises these edges.

### Mutation evidence (fail-then-pass)
| Mutant | Existing suite | New test |
|---|---|---|
| disable `pipe == 0` guard | PASS (survives) | FAIL (killed) |
| return 0 for live pipes | PASS (survives) | FAIL (killed) |

Baseline: PASS. Reproduce: `cargo test -p ginux-process --lib pipe_ends_reports`.

Prepared with AI assistance; reviewed by me.
---
 crates/ginux-process/src/lib.rs | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/crates/ginux-process/src/lib.rs b/crates/ginux-process/src/lib.rs
index 4db4a228..d20d600e 100644
--- a/crates/ginux-process/src/lib.rs
+++ b/crates/ginux-process/src/lib.rs
@@ -2187,4 +2187,24 @@ mod tests {
         // unknown task scrubs nothing
         assert_eq!(pipes.exec_scrub(99), 0);
     }
+
+    #[test]
+    fn pipe_ends_reports_zero_for_invalid_and_dead_pipes() {
+        let mut pipes: PipeSpace<2, 8, 2> = PipeSpace::new();
+        // pipe 0 is always invalid
+        assert_eq!(pipes.pipe_ends(0), 0);
+        // out-of-range pipe ids: far beyond and exactly one past the table
+        assert_eq!(pipes.pipe_ends(99), 0);
+        assert_eq!(pipes.pipe_ends(3), 0);
+        // create a pipe, verify ends=2
+        let id = pipes.create_pipe(1, 6, 7, false).unwrap();
+        assert_eq!(pipes.pipe_ends(id), 2);
+        // close both ends -> pipe freed, ends report 0
+        pipes.close(1, 6).unwrap();
+        pipes.close(1, 7).unwrap();
+        assert_eq!(pipes.pipe_ends(id), 0);
+        // re-create at same slot, verify fresh count
+        let id2 = pipes.create_pipe(1, 3, 4, false).unwrap();
+        assert_eq!(pipes.pipe_ends(id2), 2);
+    }
 }
