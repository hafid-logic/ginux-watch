From 084fabf2dee64bbbb5dab2d389dad5859251be99 Mon Sep 17 00:00:00 2001
From: Abdelhafid DJIDEL <266947999+hafid-logic@users.noreply.github.com>
Date: Thu, 26 Nov 2026 22:23:27 +0000
Subject: [PATCH] tests(devices): pin per-kind write policy and empty-write
 accounting

### What
Pins `DeviceRegistry::write` per device kind: `null` swallows the payload and reports its full length (including a zero-length write returning `Ok(0)`), while `zero` and `random` are read-only and return `PermissionDenied`. A foreign instance cannot reach the descriptor.

### Why it matters
Write accounting is what userspace `write(2)` returns. The existing suite covers random reads and block policies but never a zero-length write to `null` nor writes to `random`, so short-reporting or admitting a read-only kind passes it.

### Mutation evidence (fail-then-pass)
| Mutant | Existing suite | New test |
|---|---|---|
| admit `Random` writes as `Ok(len)` | PASS (survives) | FAIL (killed) |
| reject empty `null` writes | PASS (survives) | FAIL (killed) |

Baseline (clean tree + new test): PASS. Reproduce: `cargo test -p ginux-devices --lib device_write_policy`.

Prepared with AI assistance; reviewed by me.
---
 crates/ginux-devices/src/lib.rs | 31 +++++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/crates/ginux-devices/src/lib.rs b/crates/ginux-devices/src/lib.rs
index 6e11c291..1438044c 100644
--- a/crates/ginux-devices/src/lib.rs
+++ b/crates/ginux-devices/src/lib.rs
@@ -853,4 +853,35 @@ mod tests {
         assert_eq!(registry.views(1, &mut full), 4);
         assert_eq!(full[3].name.as_bytes(), b"dddd");
     }
+
+    #[test]
+    fn device_write_policy_per_kind_is_exact() {
+        let mut registry: DeviceRegistry<8, 8> = DeviceRegistry::new();
+        for (backend, name, kind) in [
+            (10u64, &b"null"[..], DeviceKind::Null),
+            (11, &b"zero"[..], DeviceKind::Zero),
+            (12, &b"rand"[..], DeviceKind::Random),
+        ] {
+            registry
+                .assign(1, backend, DeviceName::new(name).unwrap(), kind)
+                .unwrap();
+        }
+        let null = registry.open(1, b"null").unwrap();
+        let zero = registry.open(1, b"zero").unwrap();
+        let rand = registry.open(1, b"rand").unwrap();
+        // null swallows writes and reports the full length
+        assert_eq!(registry.write(1, null, b"abc"), Ok(3));
+        assert_eq!(registry.write(1, null, b""), Ok(0));
+        // zero and random are read-only surfaces
+        assert_eq!(
+            registry.write(1, zero, b"abc"),
+            Err(DeviceError::PermissionDenied)
+        );
+        assert_eq!(
+            registry.write(1, rand, b"abc"),
+            Err(DeviceError::PermissionDenied)
+        );
+        // foreign instance cannot reach the descriptor
+        assert!(registry.write(2, null, b"abc").is_err());
+    }
 }
