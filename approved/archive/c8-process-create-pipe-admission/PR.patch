From 5c816d15b1fd138c6bb3837dab4ba04ca9d8c62a Mon Sep 17 00:00:00 2001
From: Abdelhafid DJIDEL <266947999+hafid-logic@users.noreply.github.com>
Date: Thu, 26 Nov 2026 21:57:49 +0000
Subject: [PATCH] tests(process): pin create_pipe fd-collision and two-slot
 admission guards

### What
Pins `PipeSpace::create_pipe` admission: a read or write fd that collides with an existing descriptor is rejected with `InvalidState`, a task with fewer than two free descriptor slots is rejected with `DescriptorFull` **without consuming a pipe object**, and exactly two free slots admit one more pipe.

### Why it matters
The mirror installs both ends of a host pipe pair. The existing suite exercises happy-path creation and release but never the collision guard or the two-slot requirement, so dropping either check passes it. A one-slot admission would place a single end and leak the pipe object.

### Mutation evidence (fail-then-pass)
| Mutant | Existing suite | New test |
|---|---|---|
| drop the `write_fd` collision lookup | PASS (survives) | FAIL (killed) |
| `free < 2` -> `free == 0` | PASS (survives) | FAIL (killed) |

Baseline (clean tree + new test): PASS. Reproduce: `cargo test -p ginux-process --lib create_pipe_rejects`.

Prepared with AI assistance; reviewed by me.
---
 crates/ginux-process/src/lib.rs | 33 +++++++++++++++++++++++++++++++++
 1 file changed, 33 insertions(+)

diff --git a/crates/ginux-process/src/lib.rs b/crates/ginux-process/src/lib.rs
index af79bcc5..8df66a9f 100644
--- a/crates/ginux-process/src/lib.rs
+++ b/crates/ginux-process/src/lib.rs
@@ -2134,4 +2134,37 @@ mod tests {
         assert_eq!(ChildStatus::Signaled(128).word(), 0);
         assert_eq!(ChildStatus::Signaled(255).word(), 127);
     }
+
+    #[test]
+    fn create_pipe_rejects_fd_collisions_and_needs_two_slots() {
+        let mut pipes: PipeSpace<2, 4, 2> = PipeSpace::new();
+        let id = pipes.create_pipe(1, 0, 1, false).unwrap();
+        assert_eq!(pipes.pipe_ends(id), 2);
+        // colliding with an existing read or write end
+        assert_eq!(
+            pipes.create_pipe(1, 0, 2, false),
+            Err(ProcessError::InvalidState)
+        );
+        assert_eq!(
+            pipes.create_pipe(1, 2, 1, false),
+            Err(ProcessError::InvalidState)
+        );
+        // one free slot is not enough for a pair: must fail without consuming a pipe
+        let mut tight: PipeSpace<2, 3, 2> = PipeSpace::new();
+        let a = tight.create_pipe(1, 0, 1, false).unwrap();
+        assert_eq!(
+            tight.create_pipe(1, 2, 3, false),
+            Err(ProcessError::DescriptorFull)
+        );
+        assert_eq!(tight.pipe_ends(a), 2);
+        assert_eq!(tight.active_pipes(), 1);
+        // exactly two free slots fit one more pipe
+        let id2 = pipes.create_pipe(1, 2, 3, false).unwrap();
+        assert_ne!(id, id2);
+        assert_eq!(pipes.active_pipes(), 2);
+        assert_eq!(
+            pipes.create_pipe(1, 4, 5, false),
+            Err(ProcessError::DescriptorFull)
+        );
+    }
 }
