From 4b1630be854e7da9b5d0e329b6be2eb84abee2ad Mon Sep 17 00:00:00 2001
From: Abdelhafid DJIDEL <266947999+hafid-logic@users.noreply.github.com>
Date: Thu, 26 Nov 2026 22:21:27 +0000
Subject: [PATCH] tests(vfs): pin index header version and record-size
 validation

### What
Pins `Index::new` header validation: a corrupted magic, an unsupported version, a wrong record size, a truncated header, and a count/length mismatch each yield `InvalidIndex`, while the well-formed index still loads.

### Why it matters
The header gates every subsequent record decode. The existing suite builds valid indices and exercises record-level bounds, but never corrupts the version or record-size fields, so dropping either check passes it and would let a foreign layout be parsed with the wrong stride.

### Mutation evidence (fail-then-pass)
| Mutant | Existing suite | New test |
|---|---|---|
| drop the `INDEX_VERSION` check | PASS (survives) | FAIL (killed) |
| drop the `RECORD_SIZE` check | PASS (survives) | FAIL (killed) |

Baseline (clean tree + new test): PASS. Reproduce: `cargo test -p ginux-vfs --lib index_header_rejects`.

Prepared with AI assistance; reviewed by me.
---
 crates/ginux-vfs/src/lib.rs | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/crates/ginux-vfs/src/lib.rs b/crates/ginux-vfs/src/lib.rs
index 1e3642e2..3f5ecce5 100644
--- a/crates/ginux-vfs/src/lib.rs
+++ b/crates/ginux-vfs/src/lib.rs
@@ -1258,4 +1258,31 @@ mod tests {
         };
         assert_eq!(encode_record(e, &mut out), Err(VfsError::InvalidPath));
     }
+
+    #[test]
+    fn index_header_rejects_bad_magic_version_and_record_size() {
+        let good = index_bytes();
+        assert!(Index::new(&good).is_ok());
+        // bad magic
+        let mut b = good.clone();
+        b[0] = b'X';
+        assert_eq!(Index::new(&b).err(), Some(VfsError::InvalidIndex));
+        // bad version
+        let mut v = good.clone();
+        v[8..12].copy_from_slice(&99u32.to_le_bytes());
+        assert_eq!(Index::new(&v).err(), Some(VfsError::InvalidIndex));
+        // bad record size
+        let mut r = good.clone();
+        r[12..16].copy_from_slice(&(RECORD_SIZE as u32 + 1).to_le_bytes());
+        assert_eq!(Index::new(&r).err(), Some(VfsError::InvalidIndex));
+        // truncated header
+        assert_eq!(
+            Index::new(&good[..HEADER_SIZE - 1]).err(),
+            Some(VfsError::InvalidIndex)
+        );
+        // count/length mismatch
+        let mut c = good.clone();
+        c[16..20].copy_from_slice(&99u32.to_le_bytes());
+        assert_eq!(Index::new(&c).err(), Some(VfsError::InvalidIndex));
+    }
 }
