From 18fe9d526b4ef871f02c6cba7053ba3bee3f6c64 Mon Sep 17 00:00:00 2001
From: Abdelhafid DJIDEL <266947999+hafid-logic@users.noreply.github.com>
Date: Thu, 26 Nov 2026 20:52:53 +0000
Subject: [PATCH] tests(kernel-views): pin cgroup attach membership move and
 pids.max cap

### What
Pins `CgroupFs::attach`: pid 0 and non-root actors are rejected; attaching a pid already in another group moves it (single membership); a group at its `pids.max` rejects a new distinct pid with `LimitExceeded`.

### Why it matters
Attach enforces single membership across groups and the per-group pid cap. The existing tests attach one pid to one group, so dropping the cross-group removal loop or the `pids.max` guard survives the suite while breaking isolation accounting.

### Mutation evidence (fail-then-pass)
| Mutant | Existing suite | New test |
|---|---|---|
| skip cross-group removal loop | PASS (survives) | FAIL (killed) |
| drop `member_count >= pids_max` guard | PASS (survives) | FAIL (killed) |

Baseline (clean tree + new test): PASS. Reproduce: `cargo test -p ginux-kernel-views --lib attach_moves`.

Prepared with AI assistance; reviewed by me.
---
 crates/ginux-kernel-views/src/cgroup.rs | 25 +++++++++
 crates/ginux-kernel-views/src/lib.rs    | 70 +++++++++++++++++++++++++
 2 files changed, 95 insertions(+)

diff --git a/crates/ginux-kernel-views/src/cgroup.rs b/crates/ginux-kernel-views/src/cgroup.rs
index 3b4adcfe..35f9a5c1 100644
--- a/crates/ginux-kernel-views/src/cgroup.rs
+++ b/crates/ginux-kernel-views/src/cgroup.rs
@@ -398,4 +398,29 @@ mod tests {
         assert_eq!(cgroups.remove(b"/instance.slice", 0), Err(ViewError::Busy));
         assert_eq!(cgroups.create(b"/../host", 0), Err(ViewError::InvalidPath));
     }
+
+    #[test]
+    fn attach_moves_pid_between_groups_and_enforces_limits() {
+        let mut cgroups: CgroupFs<4> = CgroupFs::new();
+        cgroups.create(b"/a", 0).unwrap();
+        cgroups.create(b"/b", 0).unwrap();
+        // pid 0 is rejected
+        assert_eq!(cgroups.attach(b"/a", 0, 0), Err(ViewError::InvalidPath));
+        // non-root is rejected
+        assert_eq!(
+            cgroups.attach(b"/a", 7, 1000),
+            Err(ViewError::PermissionDenied)
+        );
+        cgroups.attach(b"/a", 7, 0).unwrap();
+        // moving the same pid to /b removes it from /a (single membership)
+        cgroups.attach(b"/b", 7, 0).unwrap();
+        let mut out = [0u8; 32];
+        let len = cgroups.read(b"/a/cgroup.procs", &mut out).unwrap();
+        assert_eq!(&out[..len], b"");
+        let len = cgroups.read(b"/b/cgroup.procs", &mut out).unwrap();
+        assert_eq!(&out[..len], b"7\n");
+        // pids_max boundary: cap /b at 1, second distinct pid must fail
+        cgroups.write(b"/b/pids.max", b"1\n", 0).unwrap();
+        assert_eq!(cgroups.attach(b"/b", 8, 0), Err(ViewError::LimitExceeded));
+    }
 }
diff --git a/crates/ginux-kernel-views/src/lib.rs b/crates/ginux-kernel-views/src/lib.rs
index 37eb6517..23fb854b 100644
--- a/crates/ginux-kernel-views/src/lib.rs
+++ b/crates/ginux-kernel-views/src/lib.rs
@@ -691,4 +691,74 @@ mod tests {
             Err(ViewError::ReadOnly)
         );
     }
+
+    #[test]
+    fn sysfs_list_devices_truncates_to_output_capacity() {
+        let devices = [
+            DeviceView {
+                name: DeviceName::new(b"null").unwrap(),
+                kind: DeviceKind::Null,
+                major: 1,
+                minor: 3,
+            },
+            DeviceView {
+                name: DeviceName::new(b"zero").unwrap(),
+                kind: DeviceKind::Zero,
+                major: 1,
+                minor: 5,
+            },
+            DeviceView {
+                name: DeviceName::new(b"random").unwrap(),
+                kind: DeviceKind::Random,
+                major: 1,
+                minor: 8,
+            },
+        ];
+        let sys = SysFs::new(&devices, 2);
+        let pad = DeviceView {
+            name: DeviceName::new(b"pad").unwrap(),
+            kind: DeviceKind::Null,
+            major: 0,
+            minor: 0,
+        };
+        // smaller output: truncated, prefix preserved
+        let mut small = [pad; 2];
+        assert_eq!(sys.list_devices(&mut small), 2);
+        assert_eq!(small[0].name.as_bytes(), b"null");
+        assert_eq!(small[1].name.as_bytes(), b"zero");
+        // exact fit
+        let mut exact = [pad; 3];
+        assert_eq!(sys.list_devices(&mut exact), 3);
+        assert_eq!(exact[2].name.as_bytes(), b"random");
+        // larger output: untouched tail
+        let mut big = [pad; 4];
+        assert_eq!(sys.list_devices(&mut big), 3);
+        assert_eq!(big[3].name.as_bytes(), b"pad");
+        // empty output
+        assert_eq!(sys.list_devices(&mut []), 0);
+    }
+
+    #[test]
+    fn sysfs_cpu_online_pins_single_zero_and_range() {
+        let devices: [DeviceView; 0] = [];
+        let mut output = [0u8; 32];
+        // single cpu: "0\n" (no range suffix)
+        let one = SysFs::new(&devices, 1);
+        let len = one
+            .read(b"/sys/devices/system/cpu/online", &mut output)
+            .unwrap();
+        assert_eq!(&output[..len], b"0\n");
+        // zero cpus: NotFound (fail-closed)
+        let zero = SysFs::new(&devices, 0);
+        assert_eq!(
+            zero.read(b"/sys/devices/system/cpu/online", &mut output),
+            Err(ViewError::NotFound)
+        );
+        // many cpus: upper bound is count-1
+        let many = SysFs::new(&devices, 4);
+        let len = many
+            .read(b"/sys/devices/system/cpu/online", &mut output)
+            .unwrap();
+        assert_eq!(&output[..len], b"0-3\n");
+    }
 }
