[{"sha": "09545814eaaeeafa2fbfe05a9fdac1e55de2f13f", "filename": "tools/qemu/run.sh", "status": "modified", "additions": 1, "deletions": 1, "changes": 2, "blob_url": "https://github.com/gmkurtzer/ginux/blob/d35f60cfbe18a88a642fd9a4d56916fdbe3aede8/tools%2Fqemu%2Frun.sh", "raw_url": "https://github.com/gmkurtzer/ginux/raw/d35f60cfbe18a88a642fd9a4d56916fdbe3aede8/tools%2Fqemu%2Frun.sh", "contents_url": "https://api.github.com/repos/gmkurtzer/ginux/contents/tools%2Fqemu%2Frun.sh?ref=d35f60cfbe18a88a642fd9a4d56916fdbe3aede8", "patch": "@@ -81,7 +81,7 @@ exec \"$qemu\" \\\n     -serial stdio \\\n     -no-reboot \\\n     -net none \\\n-    -device \"intel-iommu,intremap=off\" \\\n+    -device \"intel-iommu,intremap=off,aw-bits=48\" \\\n     -device \"virtio-blk-pci,drive=ginux-volume,disable-legacy=on,iommu_platform=on,serial=ginux-volume\" \\\n     -netdev \"$qemu_netdev\" \\\n     ${network_capture[@]+\"${network_capture[@]}\"} \\"}]
