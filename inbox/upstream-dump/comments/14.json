[{"url": "https://api.github.com/repos/gmkurtzer/ginux/issues/comments/6562031525", "html_url": "https://github.com/gmkurtzer/ginux/issues/14#issuecomment-6562031525", "issue_url": "https://api.github.com/repos/gmkurtzer/ginux/issues/14", "id": 6562031525, "node_id": "IC_kwDOVESuUM8AAAABhyCnpQ", "user": {"login": "gmkurtzer", "id": 13984965, "node_id": "MDQ6VXNlcjEzOTg0OTY1", "avatar_url": "https://avatars.githubusercontent.com/u/13984965?v=4", "gravatar_id": "", "url": "https://api.github.com/users/gmkurtzer", "html_url": "https://github.com/gmkurtzer", "followers_url": "https://api.github.com/users/gmkurtzer/followers", "following_url": "https://api.github.com/users/gmkurtzer/following{/other_user}", "gists_url": "https://api.github.com/users/gmkurtzer/gists{/gist_id}", "starred_url": "https://api.github.com/users/gmkurtzer/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/gmkurtzer/subscriptions", "organizations_url": "https://api.github.com/users/gmkurtzer/orgs", "repos_url": "https://api.github.com/users/gmkurtzer/repos", "events_url": "https://api.github.com/users/gmkurtzer/events{/privacy}", "received_events_url": "https://api.github.com/users/gmkurtzer/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-11-01T18:24:45Z", "updated_at": "2026-11-01T18:24:45Z", "body": "Gate 20 is now active on branch `hdae/issue-14-native-volume-linux`. The first isolated Ubuntu 24.04/QEMU TCG run built successfully but did not reproduce the reported ring-3 fault: Ubuntu's QEMU 8.2.2 stalled before the controller prompt because its default IOMMU address width does not meet the kernel's 48-bit requirement. That separate launcher problem is addressed by [PR #31](https://github.com/gmkurtzer/ginux/pull/31), whose exact head passed the complete local QEMU 10.1.2 boot suite.\n\nOne useful diagnostic remains: at reported commit `22d20a63`, the volume-service executable segment ends at relative address `0x4ade`, while the repeated fault RIP is relative `0x5146`. That points to an invalid resume target or corrupted saved context rather than an instruction in the service executable.\n\nCould you attach one complete failing serial log and, if available, a QEMU `-d int` log from the same run? The exact Debian OVMF package is already recorded. Gate 20 remains open; no remediation PR has been created because there is not yet a verified corrective code change.\n\nReproduction run: [GitHub Actions run 41334525169](https://github.com/gmkurtzer/ginux/actions/runs/41334525169).\n", "author_association": "OWNER", "pin": null, "reactions": {"url": "https://api.github.com/repos/gmkurtzer/ginux/issues/comments/6562031525/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/gmkurtzer/ginux/issues/comments/6565980772", "html_url": "https://github.com/gmkurtzer/ginux/issues/14#issuecomment-6565980772", "issue_url": "https://api.github.com/repos/gmkurtzer/ginux/issues/14", "id": 6565980772, "node_id": "IC_kwDOVESuUM8AAAABh1zqZA", "user": {"login": "gmkurtzer", "id": 13984965, "node_id": "MDQ6VXNlcjEzOTg0OTY1", "avatar_url": "https://avatars.githubusercontent.com/u/13984965?v=4", "gravatar_id": "", "url": "https://api.github.com/users/gmkurtzer", "html_url": "https://github.com/gmkurtzer", "followers_url": "https://api.github.com/users/gmkurtzer/followers", "following_url": "https://api.github.com/users/gmkurtzer/following{/other_user}", "gists_url": "https://api.github.com/users/gmkurtzer/gists{/gist_id}", "starred_url": "https://api.github.com/users/gmkurtzer/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/gmkurtzer/subscriptions", "organizations_url": "https://api.github.com/users/gmkurtzer/orgs", "repos_url": "https://api.github.com/users/gmkurtzer/repos", "events_url": "https://api.github.com/users/gmkurtzer/events{/privacy}", "received_events_url": "https://api.github.com/users/gmkurtzer/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-11-02T00:12:17Z", "updated_at": "2026-11-02T00:12:17Z", "body": "Gate 20 update: after PR #31 removed the QEMU address-width blocker, the refreshed Ubuntu/QEMU TCG reproduction now reaches the boot test and fails. The run built successfully, then the initial QEMU boot ran for the full 300-second timeout and exited with a broken pipe; `make test` returned exit 2. This confirms a Linux-runner boot failure remains, but the workflow output does not expose the captured serial stream, so it does not yet prove that this is the same ring-3 #GP reported here. I will preserve the failing run as evidence and next make the serial/interrupt logs available before proposing a corrective PR.\n\nReproduction: https://github.com/gmkurtzer/ginux/actions/runs/41365239310", "author_association": "OWNER", "pin": null, "reactions": {"url": "https://api.github.com/repos/gmkurtzer/ginux/issues/comments/6565980772/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/gmkurtzer/ginux/issues/comments/6566220344", "html_url": "https://github.com/gmkurtzer/ginux/issues/14#issuecomment-6566220344", "issue_url": "https://api.github.com/repos/gmkurtzer/ginux/issues/14", "id": 6566220344, "node_id": "IC_kwDOVESuUM8AAAABh2CSOA", "user": {"login": "hafid-logic", "id": 266947999, "node_id": "U_kgDOD-lNnw", "avatar_url": "https://avatars.githubusercontent.com/u/266947999?v=4", "gravatar_id": "", "url": "https://api.github.com/users/hafid-logic", "html_url": "https://github.com/hafid-logic", "followers_url": "https://api.github.com/users/hafid-logic/followers", "following_url": "https://api.github.com/users/hafid-logic/following{/other_user}", "gists_url": "https://api.github.com/users/hafid-logic/gists{/gist_id}", "starred_url": "https://api.github.com/users/hafid-logic/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/hafid-logic/subscriptions", "organizations_url": "https://api.github.com/users/hafid-logic/orgs", "repos_url": "https://api.github.com/users/hafid-logic/repos", "events_url": "https://api.github.com/users/hafid-logic/events{/privacy}", "received_events_url": "https://api.github.com/users/hafid-logic/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-11-02T00:31:29Z", "updated_at": "2026-11-02T00:31:29Z", "body": "Data point, in case it helps (AI-assisted run, under my direction): on main@fbe6472e, make doctor/check/test all pass on GitHub-hosted ubuntu-24.04 runners with QEMU 10.0.13 and 10.1.2 built from the official tarballs (TCG, clang 18.1.3, Ubuntu OVMF 2025-09-23, rustc 1.99.0): https://github.com/hafid-logic/ginux-watch/actions/runs/41364863523. This is not a reproduction of the reported failure, only a passing environment for comparison. Environment details are in reports/2026-11-02.md of https://github.com/hafid-logic/ginux-watch.", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/gmkurtzer/ginux/issues/comments/6566220344/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/gmkurtzer/ginux/issues/comments/6566506147", "html_url": "https://github.com/gmkurtzer/ginux/issues/14#issuecomment-6566506147", "issue_url": "https://api.github.com/repos/gmkurtzer/ginux/issues/14", "id": 6566506147, "node_id": "IC_kwDOVESuUM8AAAABh2Tuow", "user": {"login": "gmkurtzer", "id": 13984965, "node_id": "MDQ6VXNlcjEzOTg0OTY1", "avatar_url": "https://avatars.githubusercontent.com/u/13984965?v=4", "gravatar_id": "", "url": "https://api.github.com/users/gmkurtzer", "html_url": "https://github.com/gmkurtzer", "followers_url": "https://api.github.com/users/gmkurtzer/followers", "following_url": "https://api.github.com/users/gmkurtzer/following{/other_user}", "gists_url": "https://api.github.com/users/gmkurtzer/gists{/gist_id}", "starred_url": "https://api.github.com/users/gmkurtzer/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/gmkurtzer/subscriptions", "organizations_url": "https://api.github.com/users/gmkurtzer/orgs", "repos_url": "https://api.github.com/users/gmkurtzer/repos", "events_url": "https://api.github.com/users/gmkurtzer/events{/privacy}", "received_events_url": "https://api.github.com/users/gmkurtzer/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-11-02T00:55:34Z", "updated_at": "2026-11-02T00:55:34Z", "body": "The Gate 20 remediation is now available in PR #41: https://github.com/gmkurtzer/ginux/pull/41\n\nWhat was fixed:\n- The faulted or force-cancelled volume-service generation could finish a virtio-block request while MSI-X was masked, leaving vector 0 pending.\n- The replacement generation could then consume that stale interrupt before its own used ring completed and report `ScanError::Device`.\n- The kernel now drains a detected stale pending event before publishing the new generation, while retaining the existing IOMMU, teardown, and fault-containment checks.\n- The Linux harness also now recognizes Ubuntu 24.04's 4 MiB OVMF firmware filenames and reports pre-QEMU launcher failures promptly.\n\nVerification:\n- `make check` passed.\n- Four local QEMU 10.1.2/TCG `make test` boots passed, including fault and cancellation recovery.\n- Ubuntu/QEMU TCG run 41369349235 passed the complete boot test: https://github.com/gmkurtzer/ginux/actions/runs/41369349235\n\nI have not merged the PR or closed this issue.", "author_association": "OWNER", "pin": null, "reactions": {"url": "https://api.github.com/repos/gmkurtzer/ginux/issues/comments/6566506147/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/gmkurtzer/ginux/issues/comments/6567195810", "html_url": "https://github.com/gmkurtzer/ginux/issues/14#issuecomment-6567195810", "issue_url": "https://api.github.com/repos/gmkurtzer/ginux/issues/14", "id": 6567195810, "node_id": "IC_kwDOVESuUM8AAAABh290og", "user": {"login": "gmkurtzer", "id": 13984965, "node_id": "MDQ6VXNlcjEzOTg0OTY1", "avatar_url": "https://avatars.githubusercontent.com/u/13984965?v=4", "gravatar_id": "", "url": "https://api.github.com/users/gmkurtzer", "html_url": "https://github.com/gmkurtzer", "followers_url": "https://api.github.com/users/gmkurtzer/followers", "following_url": "https://api.github.com/users/gmkurtzer/following{/other_user}", "gists_url": "https://api.github.com/users/gmkurtzer/gists{/gist_id}", "starred_url": "https://api.github.com/users/gmkurtzer/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/gmkurtzer/subscriptions", "organizations_url": "https://api.github.com/users/gmkurtzer/orgs", "repos_url": "https://api.github.com/users/gmkurtzer/repos", "events_url": "https://api.github.com/users/gmkurtzer/events{/privacy}", "received_events_url": "https://api.github.com/users/gmkurtzer/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-11-02T01:53:21Z", "updated_at": "2026-11-02T01:53:21Z", "body": "It has been merged, please reopen the issue if it persists as a problem. Thank you!", "author_association": "OWNER", "pin": null, "reactions": {"url": "https://api.github.com/repos/gmkurtzer/ginux/issues/comments/6567195810/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}]
