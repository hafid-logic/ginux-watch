[{"url": "https://api.github.com/repos/gmkurtzer/ginux/issues/comments/6574390843", "html_url": "https://github.com/gmkurtzer/ginux/pull/54#issuecomment-6574390843", "issue_url": "https://api.github.com/repos/gmkurtzer/ginux/issues/54", "id": 6574390843, "node_id": "IC_kwDOVESuUM8AAAABh90-Ow", "user": {"login": "hafid-logic", "id": 266947999, "node_id": "U_kgDOD-lNnw", "avatar_url": "https://avatars.githubusercontent.com/u/266947999?v=4", "gravatar_id": "", "url": "https://api.github.com/users/hafid-logic", "html_url": "https://github.com/hafid-logic", "followers_url": "https://api.github.com/users/hafid-logic/followers", "following_url": "https://api.github.com/users/hafid-logic/following{/other_user}", "gists_url": "https://api.github.com/users/hafid-logic/gists{/gist_id}", "starred_url": "https://api.github.com/users/hafid-logic/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/hafid-logic/subscriptions", "organizations_url": "https://api.github.com/users/hafid-logic/orgs", "repos_url": "https://api.github.com/users/hafid-logic/repos", "events_url": "https://api.github.com/users/hafid-logic/events{/privacy}", "received_events_url": "https://api.github.com/users/hafid-logic/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-11-02T10:05:18Z", "updated_at": "2026-11-02T10:05:18Z", "body": "Thanks for enabling release overflow checks. At head a0e9220b (QEMU 10.0.13/10.1.2, TCG: doctor/check/test pass), reading the code and running the verbatim logic in a host harness suggests five eager expressions that would now panic where release previously wrapped silently (not reproduced in a guest):\n- linux_overlay.rs:539: `then_some(node.fifo_socket - 1)` evaluates its argument even when fifo_socket == 0.\n- cpu.rs:22504, 23983, 25167, 37712: the `byte - b'0'` fold underflows for any byte below '0' (e.g. `/`) after `/proc/self/fd/`.\nA lazy `then(|| ..)` or `checked_sub` would avoid it. Worth handling before merge? (AI-assisted; details available.)\n", "author_association": "NONE", "reactions": {"url": "https://api.github.com/repos/gmkurtzer/ginux/issues/comments/6574390843/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/gmkurtzer/ginux/issues/comments/6582310670", "html_url": "https://github.com/gmkurtzer/ginux/pull/54#issuecomment-6582310670", "issue_url": "https://api.github.com/repos/gmkurtzer/ginux/issues/54", "id": 6582310670, "node_id": "IC_kwDOVESuUM8AAAABiFYXDg", "user": {"login": "gmkurtzer", "id": 13984965, "node_id": "MDQ6VXNlcjEzOTg0OTY1", "avatar_url": "https://avatars.githubusercontent.com/u/13984965?v=4", "gravatar_id": "", "url": "https://api.github.com/users/gmkurtzer", "html_url": "https://github.com/gmkurtzer", "followers_url": "https://api.github.com/users/gmkurtzer/followers", "following_url": "https://api.github.com/users/gmkurtzer/following{/other_user}", "gists_url": "https://api.github.com/users/gmkurtzer/gists{/gist_id}", "starred_url": "https://api.github.com/users/gmkurtzer/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/gmkurtzer/subscriptions", "organizations_url": "https://api.github.com/users/gmkurtzer/orgs", "repos_url": "https://api.github.com/users/gmkurtzer/repos", "events_url": "https://api.github.com/users/gmkurtzer/events{/privacy}", "received_events_url": "https://api.github.com/users/gmkurtzer/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-11-02T16:24:48Z", "updated_at": "2026-11-02T16:24:48Z", "body": "Follow-up remediation is now pushed in 47fc22c8 after independently confirming the release-overflow findings.\\n\\nChanges:\\n- replace eager FIFO slot subtraction with checked, lazy evaluation\\n- centralize /proc descriptor decimal parsing behind checked digit and ove