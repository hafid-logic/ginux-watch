[{"url": "https://api.github.com/repos/gmkurtzer/ginux/issues/comments/6574528802", "html_url": "https://github.com/gmkurtzer/ginux/issues/55#issuecomment-6574528802", "issue_url": "https://api.github.com/repos/gmkurtzer/ginux/issues/55", "id": 6574528802, "node_id": "IC_kwDOVESuUM8AAAABh99ZIg", "user": {"login": "rvdende", "id": 3116694, "node_id": "MDQ6VXNlcjMxMTY2OTQ=", "avatar_url": "https://avatars.githubusercontent.com/u/3116694?v=4", "gravatar_id": "", "url": "https://api.github.com/users/rvdende", "html_url": "https://github.com/rvdende", "followers_url": "https://api.github.com/users/rvdende/followers", "following_url": "https://api.github.com/users/rvdende/following{/other_user}", "gists_url": "https://api.github.com/users/rvdende/gists{/gist_id}", "starred_url": "https://api.github.com/users/rvdende/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/rvdende/subscriptions", "organizations_url": "https://api.github.com/users/rvdende/orgs", "repos_url": "https://api.github.com/users/rvdende/repos", "events_url": "https://api.github.com/users/rvdende/events{/privacy}", "received_events_url": "https://api.github.com/users/rvdende/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-11-02T10:11:58Z", "updated_at": "2026-11-02T10:11:58Z", "body": "simple. most bugs are from unsafe memory use and rust makes it easier to avoid those class of bugs. \nThere has been various other rewrites into rust and this should be no surprise", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/gmkurtzer/ginux/issues/comments/6574528802/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/gmkurtzer/ginux/issues/comments/6580679832", "html_url": "https://github.com/gmkurtzer/ginux/issues/55#issuecomment-6580679832", "issue_url": "https://api.github.com/repos/gmkurtzer/ginux/issues/55", "id": 6580679832, "node_id": "IC_kwDOVESuUM8AAAABiD00mA", "user": {"login": "gmkurtzer", "id": 13984965, "node_id": "MDQ6VXNlcjEzOTg0OTY1", "avatar_url": "https://avatars.githubusercontent.com/u/13984965?v=4", "gravatar_id": "", "url": "https://api.github.com/users/gmkurtzer", "html_url": "https://github.com/gmkurtzer", "followers_url": "https://api.github.com/users/gmkurtzer/followers", "following_url": "https://api.github.com/users/gmkurtzer/following{/other_user}", "gists_url": "https://api.github.com/users/gmkurtzer/gists{/gist_id}", "starred_url": "https://api.github.com/users/gmkurtzer/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/gmkurtzer/subscriptions", "organizations_url": "https://api.github.com/users/gmkurtzer/orgs", "repos_url": "https://api.github.com/users/gmkurtzer/repos", "events_url": "https://api.github.com/users/gmkurtzer/events{/privacy}", "received_events_url": "https://api.github.com/users/gmkurtzer/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-11-02T15:13:15Z", "updated_at": "2026-11-02T15:13:15Z", "body": "And for me, this is a research project into the capabilities of AI using an area that I enjoy very much, operating systems.\n\nAdditionally, I'm testing my HDAE (Human-Directed Agentic Engineering) thesis and materialization of AI focused skills to drive much of this. My goal there is to hopefully help convince the people who are maintaining software, both open source as well as commercial, that using AI works today to do amazing things, especially when there are processes in place and an expert at the helm.\n\nThis might sound obvious to many people currently embedded in AI, but there are a lot of open source maintainers specifically who have refused to allow AI based contributions into the project, or even leverage AI reviews, testing, documentation, etc. and I feel strongly that is a mistake that will affect the projects and many users. So I'm hoping to demonstrate the art of the possible.\n\nHopefully this has been answered to your satisfaction, so I'm closing, but if there are other questions, feel free to reopen. Thanks! ", "author_association": "OWNER", "pin": null, "reactions": {"url": "https://api.github.com/repos/gmkurtzer/ginux/issues/comments/6580679832/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}]
